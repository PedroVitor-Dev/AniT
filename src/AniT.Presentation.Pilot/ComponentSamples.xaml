<UserControl x:Class="AniT.Presentation.Pilot.ComponentSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Text="Uma linguagem, vários estados" Style="{DynamicResource AniT.Section}" Margin="0,28,0,16"/>
        <Border Style="{DynamicResource AniT.Card}">
            <StackPanel>
                <TextBlock Text="Ações claras" Style="{DynamicResource AniT.Section}"/>
                <TextBlock Text="Primária para avançar, secundária para apoiar e discreta para ações complementares." Style="{DynamicResource AniT.Body}" Margin="0,8,0,16"/>
                <WrapPanel>
                    <ui:Button Content="Continuar" Style="{DynamicResource AniT.Button.Primary}" Margin="0,0,12,12"/>
                    <ui:Button Content="Ver detalhes" Style="{DynamicResource AniT.Button.Secondary}" Margin="0,0,12,12"/>
                    <ui:Button Content="Mais opções" Style="{DynamicResource AniT.Button.Quiet}" Margin="0,0,12,12"/>
                </WrapPanel>
                <TextBlock Text="✓ Tudo pronto para continuar." Style="{DynamicResource AniT.Status.Success}" Margin="0,4,0,0"/>
                <TextBlock Text="! Não encontramos esse episódio. Confira a pasta." Style="{DynamicResource AniT.Status.Error}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource AniT.EmptyState}" Margin="0,16,0,0">
            <StackPanel><TextBlock Text="Sua próxima coleção começa aqui" Style="{DynamicResource AniT.Section}"/><TextBlock Text="Quando você adicionar uma pasta, seus títulos aparecerão neste espaço." Style="{DynamicResource AniT.Body}" Margin="0,8,0,0"/></StackPanel>
        </Border>
    </StackPanel>
</UserControl>
