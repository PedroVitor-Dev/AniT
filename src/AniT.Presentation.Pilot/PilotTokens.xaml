<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries><ui:ControlsDictionary /></ResourceDictionary.MergedDictionaries>
    <!-- Window-scoped AniT roles. They never replace the application's legacy dictionaries. -->
    <SolidColorBrush x:Key="Pilot.Background" Color="#0C1017"/>
    <SolidColorBrush x:Key="Pilot.Surface" Color="#171E29"/>
    <SolidColorBrush x:Key="Pilot.Raised" Color="#1E2735"/>
    <SolidColorBrush x:Key="Pilot.Text" Color="#EDF2F8"/>
    <SolidColorBrush x:Key="Pilot.Muted" Color="#A7B5C7"/>
    <SolidColorBrush x:Key="Pilot.Border" Color="#364256"/>
    <SolidColorBrush x:Key="Pilot.Accent" Color="#77B5FF"/>
    <SolidColorBrush x:Key="Pilot.Error" Color="#FF9AAA"/>
    <CornerRadius x:Key="Pilot.Radius">16</CornerRadius>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Pilot.TitleSize">28</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Pilot.SectionSize">19</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Pilot.BodySize">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Pilot.CaptionSize">12</sys:Double>
    <Style x:Key="Pilot.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Pilot.Text}"/>
        <Setter Property="FontSize" Value="{DynamicResource Pilot.BodySize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Pilot.Caption" TargetType="TextBlock" BasedOn="{StaticResource Pilot.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Pilot.CaptionSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Pilot.Muted}"/>
    </Style>
    <Style x:Key="Pilot.Section" TargetType="TextBlock" BasedOn="{StaticResource Pilot.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Pilot.SectionSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Pilot.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pilot.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Pilot.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Pilot.Radius}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="Pilot.Button" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Margin" Value="0,0,10,8"/>
        <Setter Property="FontSize" Value="{DynamicResource Pilot.BodySize}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    </Style>
    <Style x:Key="Pilot.Input" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="FontSize" Value="{DynamicResource Pilot.BodySize}"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Pilot.Error}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Pilot.Select" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="FontSize" Value="{DynamicResource Pilot.BodySize}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <!-- Only used for ReduceMotion: WPF UI's stock switch has literal 167ms storyboards. -->
    <ControlTemplate x:Key="Pilot.StaticToggle" TargetType="ui:ToggleSwitch">
        <Grid Background="Transparent" MinHeight="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Track" Height="24" CornerRadius="12" Background="{DynamicResource Pilot.Raised}" BorderBrush="{DynamicResource Pilot.Muted}" BorderThickness="1" VerticalAlignment="Center"/>
            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource Pilot.Text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Pilot.Accent}"/><Setter TargetName="Thumb" Property="Margin" Value="24,0,0,0"/><Setter TargetName="Thumb" Property="Fill" Value="#081427"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
