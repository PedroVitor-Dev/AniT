<UserControl x:Class="AniT.App.NavItemContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Width="28"
                Height="28"
                HorizontalAlignment="Left"
                CornerRadius="9"
                Background="#100F83C9"
                BorderBrush="#2239B8FF"
                BorderThickness="1">
            <Viewbox Width="18" Height="18" Stretch="Uniform">
                <Path Data="{Binding IconData, ElementName=Root}"
                      Width="24"
                      Height="24"
                      Stretch="Uniform"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, ElementName=Root}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Viewbox>
        </Border>

        <TextBlock Grid.Column="1"
                   Text="{Binding Label, ElementName=Root}"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   FontSize="14"
                   FontWeight="Medium"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
