<UserControl x:Class="AniT.App.NavItemContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Width="28"
                Height="28"
                HorizontalAlignment="Left"
                CornerRadius="9"
                Background="#100F83C9"
                BorderBrush="#2239B8FF"
                BorderThickness="1">
            <Viewbox Width="18" Height="18" Stretch="Uniform">
                <Path Data="{Binding IconData, ElementName=Root}"
                      Width="24"
                      Height="24"
                      Stretch="Uniform"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Viewbox>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock
                   Text="{Binding Label, ElementName=Root}"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Tag="ThemeManaged"
                   FontSize="14"
                   FontWeight="Medium"
                   VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Left" CornerRadius="4" Padding="5,1" Margin="0,3,0,0" BorderThickness="1" BorderBrush="{DynamicResource AniT.Brush.Border}" Background="{DynamicResource AniT.Brush.Surface}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBeta, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Tag="ThemeManaged" Foreground="{DynamicResource AniT.Brush.TextPrimary}"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
