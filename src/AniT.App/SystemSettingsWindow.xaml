<Window x:Class="AniT.App.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AniT.App"
        Title="Configurações gerais · AniT" Width="1440" Height="900" MinWidth="1060" MinHeight="700"
        Background="#020B1D" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/HomeTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsPanel" TargetType="Border"><Setter Property="Background" Value="#E9071B37"/><Setter Property="BorderBrush" Value="#2B72A8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="24"/></Style>
            <Style x:Key="SettingsTextBox" TargetType="TextBox"><Setter Property="Height" Value="44"/><Setter Property="Background" Value="#0B2548"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="#65D9FF"/><Setter Property="BorderBrush" Value="#3277AB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/></Style>
            <Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#EAF6FF"/><Setter Property="Background" Value="#0B2548"/><Setter Property="Padding" Value="13,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1A5F91"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1679B8"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SettingsComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="44"/><Setter Property="Foreground" Value="#EAF6FF"/><Setter Property="Background" Value="#0B2548"/><Setter Property="BorderBrush" Value="#3277AB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,0"/><Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}"/><Setter Property="MaxDropDownHeight" Value="240"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboSurface" Background="#0B2548" BorderBrush="#3277AB" BorderThickness="1" CornerRadius="10"><Grid><ContentPresenter Margin="13,0,42,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"/><Viewbox Width="14" Height="9" HorizontalAlignment="Right" Margin="0,0,14,0"><Path Data="M2,2 L8,8 14,2" Stroke="#7DDAFF" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#61D7FF"/><Setter TargetName="ComboSurface" Property="Background" Value="#10325A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#071A34" BorderBrush="#43B9E7" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" ClipToBounds="True"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#EAF6FF"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="CheckSurface" Width="16" Height="16" Background="#0A2345" BorderBrush="#5A9BC8" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark" Data="M3,8 L6.5,11.5 13,4.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#1687C7"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#76E3FF"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#76E3FF"/><Setter Property="Foreground" Value="White"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckSurface" Property="Background" Value="#102944"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#52718E"/><Setter Property="Foreground" Value="#86A7C4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SettingsPageTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#F7FBFF"/><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="Bold"/></Style>
            <Style x:Key="SettingsPageDescription" TargetType="TextBlock"><Setter Property="Foreground" Value="#A9C9E3"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
            <Style x:Key="SettingsCategory" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#AFC8E5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="58"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="15,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><Viewbox Width="21" Height="21" VerticalAlignment="Center"><Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" StrokeLineJoin="Round"/></Viewbox><ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/><Path Grid.Column="2" Data="M7,5 L12,10 7,15" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" Width="10" Height="14" Stretch="Uniform" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#112F54"/><Setter Property="Foreground" Value="#D9F4FF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#184B7C"/><Setter TargetName="Surface" Property="BorderBrush" Value="#54CEFF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="HiddenTabControl" TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/></ControlTemplate></Setter.Value></Setter></Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.72,0.05" Center="0.72,0.05" RadiusX="0.95" RadiusY="1.05"><GradientStop Color="#0A356D"/><GradientStop Color="#041A38" Offset="0.43"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Background><ImageBrush ImageSource="{local:ComfortableImage Path=Assets/logo-fire.png, DecodePixelWidth=320}" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeNavButton}" Click="Home_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Home}" Label="Início"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Explore_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Explore}" Label="Explorar"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Library_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Library}" Label="Biblioteca"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Calendar_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Calendar}" Label="Calendário"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="History_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.History}" Label="Histórico"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Achievements_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Achievements}" Label="Conquistas"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Profile_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Profile}" Label="Perfil"/></Button>
                    <Border Height="1" Background="#214874" Margin="20,18,20,11"/><TextBlock Text="SISTEMA" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,7"/>
                    <Button Style="{StaticResource HomeActiveNavButton}"><local:NavItemContent IconData="{StaticResource AniT.Icon.Settings}" Label="Configurações"/></Button>
                </StackPanel>
                <Image Grid.Row="2" Source="{local:PageMascot Page=Configuracoes, Fallback=Assets/ghost_menu.png}" Style="{StaticResource HomeSidebarMascot}"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1"><Grid MaxWidth="2500" Margin="28,0"><TextBlock Text="Central de configurações" Foreground="#DDF2FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource HomeTopButton}" Content="⌂  Início" Click="Home_Click"/><Button Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/><Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/><local:ProfileAvatarButton/></StackPanel></Grid></Border>
            <Grid Grid.Row="1" MaxWidth="1700" Margin="34,26,34,42" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,22"><TextBlock Text="Configurações do AniT" Foreground="White" FontSize="34" FontWeight="Bold"/><TextBlock Text="Personalize sua experiência por categoria. Cada módulo pode crescer sem poluir as outras telas." Foreground="#9EC4E5" FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#B8071B37" BorderBrush="#245D8D" BorderThickness="1" CornerRadius="18" Padding="13">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="CATEGORIAS" Foreground="#678DB5" FontSize="10" FontWeight="Bold" Margin="8,5,0,12"/>
                            <RadioButton x:Name="GeneralCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Home}" IsChecked="True" Checked="Category_Checked"><StackPanel><TextBlock Text="Página inicial" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Banner, seções e conteúdo" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="AppearanceCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Sparkles}" Checked="Category_Checked"><StackPanel><TextBlock Text="Aparência" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Tema, escala e mascotes" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="ShelfCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Library}" Checked="Category_Checked"><StackPanel><TextBlock Text="Biblioteca" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Pastas, leitura e regras" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="OrganizationCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.List}" Checked="Category_Checked"><StackPanel><TextBlock Text="Organização" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Nomes, tags e coleções" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="NotificationsCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Bell}" Checked="Category_Checked"><StackPanel><TextBlock Text="Notificações" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Avisos, resumo e silêncio" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="ProfilePrivacyCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Profile}" Checked="Category_Checked"><StackPanel><TextBlock Text="Perfil e privacidade" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Identidade, dados e perfis" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="PlaybackCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Play}" Checked="Category_Checked"><StackPanel><TextBlock Text="Reprodução" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Player, faixas e progresso" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="ExperienceCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Sparkles}" Checked="Category_Checked"><StackPanel><TextBlock Text="Experiência" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Transições e ritmo" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="ImagesCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Anime}" Checked="Category_Checked"><StackPanel><TextBlock Text="Imagens" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Fontes e usos" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="BackupCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Cloud}" Checked="Category_Checked"><StackPanel><TextBlock Text="Dados e backup" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Proteção, exportação e reparo" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <RadioButton x:Name="AdvancedCategory" Style="{StaticResource SettingsCategory}" Tag="{StaticResource AniT.Icon.Settings}" Checked="Category_Checked"><StackPanel><TextBlock Text="Avançado" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Rede, diagnóstico e atalhos" Foreground="#82A7CB" FontSize="9" Margin="0,2,0,0"/></StackPanel></RadioButton>
                            <Border Height="1" Background="#24527D" Margin="7,11"/><TextBlock Text="Seus dados continuam locais até você escolher onde guardar o backup." Foreground="#6E91B5" FontSize="10" TextWrapping="Wrap" Margin="8,4"/>
                        </StackPanel></ScrollViewer>
                    </Border>
                    <TabControl x:Name="SettingsTabs" Grid.Column="2" Style="{StaticResource HiddenTabControl}" SelectedIndex="0">
                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Página inicial" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Escolha o ritmo do banner, a ordem do conteúdo e o que merece destaque quando o AniT abre." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>

                            <Border Style="{StaticResource SettingsPanel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,30,0"><TextBlock Text="Banner em destaque" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Controle a troca automática sem perder a navegação manual pelos indicadores." Foreground="#94B7D7" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap"/><CheckBox x:Name="BannerAutoRotateBox" Content="Alternar os destaques automaticamente" Margin="0,0,0,16"/><Slider x:Name="BannerIntervalSlider" Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BannerIntervalSlider_ValueChanged"/></StackPanel><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="15" Padding="18"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="TEMPO ENTRE DESTAQUES" Foreground="#83B4D8" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="BannerIntervalText" Text="8 segundos" Foreground="#75DFFF" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border></Grid></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Seções da página" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Marque o que deseja ver e arraste pela alça para mudar a ordem." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14"/><ListBox x:Name="HomeSectionsList" ItemsSource="{Binding HomeSections}" AllowDrop="True" Background="Transparent" BorderThickness="0" Padding="0" PreviewMouseLeftButtonDown="HomeSectionsList_PreviewMouseLeftButtonDown" PreviewMouseMove="HomeSectionsList_PreviewMouseMove" Drop="HomeSectionsList_Drop"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="#0A2345" BorderBrush="#286797" BorderThickness="1" CornerRadius="12" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Viewbox Width="16" Height="18" VerticalAlignment="Center"><Path Data="M3,4 H13 M3,9 H13 M3,14 H13" Stroke="#72DFFF" StrokeThickness="1.8" StrokeStartLineCap="Round"/></Viewbox><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" Foreground="#EAF6FF" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#7FA7C9" FontSize="10" Margin="0,2,0,0"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Exibir" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Quantidade em cada seção" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Limite quantos títulos aparecem antes do link para a Biblioteca." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14"/><UniformGrid Columns="4"><StackPanel Margin="0,0,12,0"><TextBlock Text="Continuar" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ContinueItemsBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="2 títulos" Tag="2"/><ComboBoxItem Content="4 títulos" Tag="4"/><ComboBoxItem Content="6 títulos" Tag="6"/><ComboBoxItem Content="8 títulos" Tag="8"/></ComboBox></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Novidades" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="RecentItemsBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="3 títulos" Tag="3"/><ComboBoxItem Content="5 títulos" Tag="5"/><ComboBoxItem Content="8 títulos" Tag="8"/><ComboBoxItem Content="10 títulos" Tag="10"/></ComboBox></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Favoritos" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="FavoriteItemsBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="2 títulos" Tag="2"/><ComboBoxItem Content="4 títulos" Tag="4"/><ComboBoxItem Content="6 títulos" Tag="6"/><ComboBoxItem Content="8 títulos" Tag="8"/></ComboBox></StackPanel><StackPanel><TextBlock Text="Bem avaliados" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="TopRatedItemsBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="2 títulos" Tag="2"/><ComboBoxItem Content="4 títulos" Tag="4"/><ComboBoxItem Content="6 títulos" Tag="6"/><ComboBoxItem Content="8 títulos" Tag="8"/></ComboBox></StackPanel></UniformGrid></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Continuar assistindo" Foreground="White" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ao clicar em Continuar" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ContinueBehaviorBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Reproduzir do ponto salvo" Tag="ResumePlayback"/><ComboBoxItem Content="Abrir a página do anime" Tag="OpenAnimeDetails"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Prioridade de conteúdo" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="HomePriorityBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Novidades primeiro" Tag="RecentFirst"/><ComboBoxItem Content="Favoritos primeiro" Tag="FavoritesFirst"/></ComboBox></StackPanel></Grid><CheckBox x:Name="HideCompletedFromContinueBox" Content="Ocultar títulos concluídos de Continuar assistindo" Margin="0,17,0,0"/></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Atualização de conteúdo" Foreground="White" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="StartupMetadataBox" Content="Buscar capas e informações ausentes em segundo plano ao iniciar" Margin="0,16,0,0"/><TextBlock Text="Usa o cache local e somente consulta a internet quando alguma informação estiver faltando." Foreground="#7E9FBE" FontSize="10" Margin="24,5,0,0"/></StackPanel></Border>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Reprodução" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Defina como os episódios abrem, avançam e registram seu progresso." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>

                            <Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Player e início" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="O player integrado mantém progresso, faixas, velocidade e sequência sincronizados com o AniT." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Player padrão" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="PlaybackPlayerModeBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="MPC-HC integrado · progresso completo" Tag="IntegratedMpcHc"/><ComboBoxItem Content="Aplicativo padrão do Windows · sem rastreamento" Tag="SystemDefault"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Velocidade padrão" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="PlaybackSpeedBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="0,5×" Tag="0.5"/><ComboBoxItem Content="0,75×" Tag="0.75"/><ComboBoxItem Content="Normal · 1×" Tag="1"/><ComboBoxItem Content="1,25×" Tag="1.25"/><ComboBoxItem Content="1,5×" Tag="1.5"/><ComboBoxItem Content="2×" Tag="2"/></ComboBox></StackPanel></Grid><WrapPanel Margin="0,18,0,0"><CheckBox x:Name="ResumePlaybackBox" Content="Continuar automaticamente da posição salva" Margin="0,0,30,0"/><CheckBox x:Name="StartPlaybackFullscreenBox" Content="Abrir o player em tela cheia"/></WrapPanel></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Progresso e conclusão" Foreground="White" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,22,0"><TextBlock Text="Considerar assistido após" Foreground="#DCEEFF" FontWeight="SemiBold"/><TextBlock Text="Ao atingir a porcentagem, o episódio é concluído mesmo antes dos créditos terminarem." Foreground="#7E9FBE" FontSize="10" Margin="0,4,0,11" TextWrapping="Wrap"/><Slider x:Name="WatchedThresholdSlider" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="WatchedThresholdSlider_ValueChanged"/></StackPanel><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13"><TextBlock x:Name="WatchedThresholdText" Text="90%" Foreground="#75DFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="3" Margin="0,0,22,0"><TextBlock Text="Salvar progresso a cada" Foreground="#DCEEFF" FontWeight="SemiBold"/><TextBlock Text="Intervalos menores protegem melhor a posição; intervalos maiores reduzem gravações." Foreground="#7E9FBE" FontSize="10" Margin="0,4,0,11" TextWrapping="Wrap"/><Slider x:Name="ProgressSaveIntervalSlider" Minimum="2" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ProgressSaveIntervalSlider_ValueChanged"/></StackPanel><Border Grid.Column="4" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13"><TextBlock x:Name="ProgressSaveIntervalText" Text="5 s" Foreground="#75DFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Sequência e segmentos" Foreground="White" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="AutoPlayNextEpisodeBox" Content="Reproduzir automaticamente o próximo episódio" Margin="0,16,0,13"/><CheckBox x:Name="SkipOpeningBox" Content="Pular abertura quando o arquivo informar o segmento" Margin="0,0,0,13"/><CheckBox x:Name="SkipEndingBox" Content="Pular encerramento quando o arquivo informar o segmento"/><TextBlock Text="Abertura e encerramento são pulados apenas quando houver marcações compatíveis; sem marcações o vídeo nunca é avançado por estimativa." Foreground="#7E9FBE" FontSize="10" Margin="24,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Áudio e legendas" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="O AniT escolhe a faixa correspondente quando o arquivo oferece nomes de idioma reconhecíveis." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Áudio preferencial" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="PreferredAudioLanguageBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Automático" Tag="auto"/><ComboBoxItem Content="Japonês" Tag="ja"/><ComboBoxItem Content="Português do Brasil" Tag="pt-BR"/><ComboBoxItem Content="Inglês" Tag="en"/><ComboBoxItem Content="Espanhol" Tag="es"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Legenda preferencial" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="PreferredSubtitleLanguageBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Automática" Tag="auto"/><ComboBoxItem Content="Português do Brasil" Tag="pt-BR"/><ComboBoxItem Content="Inglês" Tag="en"/><ComboBoxItem Content="Espanhol" Tag="es"/><ComboBoxItem Content="Desativada" Tag="off"/></ComboBox></StackPanel></Grid></StackPanel></Border>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Aparência" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Mude o clima, a densidade e o conforto visual do AniT sem perder a identidade das telas." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>

                            <Border Style="{StaticResource SettingsPanel}"><StackPanel>
                                <TextBlock Text="Tema e cor principal" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="O modo automático acompanha a preferência de aplicativos do Windows." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Tema" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox x:Name="ThemeModeBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Escuro" Tag="Dark"/><ComboBoxItem Content="Claro" Tag="Light"/><ComboBoxItem Content="Automático" Tag="Automatic"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Cor principal" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="AccentPreview" Width="42" Height="42" CornerRadius="12" BorderBrush="#BDEEFF" BorderThickness="1"/><TextBox x:Name="AccentColorBox" Grid.Column="1" Style="{StaticResource SettingsTextBox}" Margin="8,0,12,0" TextChanged="AccentColorBox_TextChanged" MaxLength="7"/><WrapPanel Grid.Column="2" VerticalAlignment="Center"><Button Tag="#42C8FF" Click="AccentPreset_Click" Width="28" Height="28" Background="#42C8FF" BorderBrush="#AEEBFF" Margin="0,0,7,0"/><Button Tag="#8B5CF6" Click="AccentPreset_Click" Width="28" Height="28" Background="#8B5CF6" BorderBrush="#D8C9FF" Margin="0,0,7,0"/><Button Tag="#FF5FA2" Click="AccentPreset_Click" Width="28" Height="28" Background="#FF5FA2" BorderBrush="#FFD1E5" Margin="0,0,7,0"/><Button Tag="#36D399" Click="AccentPreset_Click" Width="28" Height="28" Background="#36D399" BorderBrush="#C6FFE9" Margin="0,0,7,0"/><Button Tag="#F5C451" Click="AccentPreset_Click" Width="28" Height="28" Background="#F5C451" BorderBrush="#FFF0B6"/></WrapPanel></Grid></StackPanel>
                                </Grid>
                                <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,22,0"><TextBlock Text="Intensidade dos brilhos" Foreground="#DCEEFF" FontWeight="SemiBold"/><TextBlock Text="Controla glows, realces e halos da cor principal." Foreground="#7E9FBE" FontSize="10" Margin="0,4,0,11"/><Slider x:Name="GlowIntensitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="GlowIntensitySlider_ValueChanged"/></StackPanel><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13" Padding="12"><TextBlock x:Name="GlowIntensityText" Text="70%" Foreground="#75DFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Cards e organização" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A densidade define o tamanho-base; a quantidade por linha é usada nas grades responsivas da Biblioteca e do Explorar." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tamanho dos cards" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox x:Name="CardSizeBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Compacto" Tag="Compact"/><ComboBoxItem Content="Confortável" Tag="Comfortable"/><ComboBoxItem Content="Grande" Tag="Large"/></ComboBox></StackPanel><StackPanel Grid.Column="2" Margin="0,0,22,0"><TextBlock Text="Quantidade de cards por linha" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Zero mantém a adaptação automática." Foreground="#7E9FBE" FontSize="10" Margin="0,4,0,11"/><Slider x:Name="CardsPerRowSlider" Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CardsPerRowSlider_ValueChanged"/></StackPanel><Border Grid.Column="3" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13" Padding="12"><TextBlock x:Name="CardsPerRowText" Text="Automático" Foreground="#75DFFF" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                                <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,22,0"><TextBlock Text="Arredondamento das bordas" Foreground="#DCEEFF" FontWeight="SemiBold"/><TextBlock Text="De cantos retos a superfícies bem suaves." Foreground="#7E9FBE" FontSize="10" Margin="0,4,0,11"/><Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="32" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="CornerRadiusSlider_ValueChanged"/></StackPanel><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13" Padding="12"><TextBlock x:Name="CornerRadiusText" Text="16 px" Foreground="#75DFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Movimento e acessibilidade" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,22,0"><TextBlock Text="Intensidade das animações e partículas" Foreground="#DCEEFF" FontWeight="SemiBold"/><TextBlock Text="Ajusta a duração das transições e a presença dos efeitos decorativos." Foreground="#7E9FBE" FontSize="10" Margin="0,4,0,11"/><Slider x:Name="AnimationIntensitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="AnimationIntensitySlider_ValueChanged"/></StackPanel><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13" Padding="12"><TextBlock x:Name="AnimationIntensityText" Text="70%" Foreground="#75DFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                                <CheckBox x:Name="ReduceMotionBox" Content="Reduzir movimento e desativar a tela animada durante a navegação" Margin="0,18,0,0"/><TextBlock Text="Recomendado para sensibilidade a movimento. Esta opção tem prioridade sobre a intensidade escolhida acima." Foreground="#7E9FBE" FontSize="10" Margin="24,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Escala e leitura" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A escala altera toda a interface; o tamanho de texto oferece um ajuste adicional para leitura." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,15"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Escala geral" Foreground="#DCEEFF" FontWeight="SemiBold"/><Slider x:Name="InterfaceScaleSlider" Minimum="80" Maximum="125" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="InterfaceScaleSlider_ValueChanged" Margin="0,12,0,0"/></StackPanel><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13"><TextBlock x:Name="InterfaceScaleText" Text="100%" Foreground="#75DFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="3" Margin="0,0,20,0"><TextBlock Text="Tamanho dos textos" Foreground="#DCEEFF" FontWeight="SemiBold"/><Slider x:Name="TextScaleSlider" Minimum="85" Maximum="140" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="TextScaleSlider_ValueChanged" Margin="0,12,0,0"/></StackPanel><Border Grid.Column="4" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13"><TextBlock x:Name="TextScaleText" Text="100%" Foreground="#75DFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Mascote de cada página" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Escolha uma expressão diferente do Baki-Pi para cada espaço ou oculte o mascote onde preferir." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding PageMascots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0A2345" BorderBrush="#286797" BorderThickness="1" CornerRadius="13" Padding="13" Margin="0,0,10,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="#DCEEFF" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource SettingsComboBox}" ItemsSource="{Binding MascotChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedMascot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="A troca aparece nas novas páginas abertas após salvar." Foreground="#75BDE2" FontSize="10" Margin="2,3,0,0"/>
                            </StackPanel></Border>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Biblioteca" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Controle onde o AniT procura vídeos, como reconhece episódios e quando atualiza o catálogo." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>
                            <local:ShelfSettingsControl x:Name="ShelfSettings"/>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Atualização automática" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <CheckBox x:Name="StartupScanBox" Content="Escanear as pastas monitoradas ao iniciar o AniT" Margin="0,17,0,0"/>
                                <TextBlock Text="Novos arquivos entram no catálogo antes de a página inicial terminar de carregar." Foreground="#7E9FBE" FontSize="10" Margin="24,5,0,15"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,25,0"><TextBlock Text="Intervalo em segundo plano" Foreground="#DCEEFF" FontWeight="SemiBold"/><TextBlock Text="Use 0 para desativar. A leitura ocorre sem interromper a reprodução." Foreground="#7E9FBE" FontSize="10" Margin="0,5,0,13"/><Slider x:Name="BackgroundScanSlider" Minimum="0" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BackgroundScanSlider_ValueChanged"/></StackPanel>
                                    <Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="14" Padding="15"><StackPanel HorizontalAlignment="Center"><TextBlock Text="NOVA LEITURA A CADA" Foreground="#83B4D8" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="BackgroundScanText" Text="15 minutos" Foreground="#75DFFF" FontSize="21" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                                </Grid>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Formatos de vídeo" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Extensões aceitas, separadas por vírgula. Você pode incluir formatos usados por encodes específicos." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap"/>
                                <TextBox x:Name="VideoExtensionsBox" Style="{StaticResource SettingsTextBox}" ToolTip="Exemplo: .mkv, .mp4, .avi"/>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Reconhecimento de episódios" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Combine regras para reconhecer nomes organizados e arquivos bagunçados. As regras mais específicas são aplicadas primeiro." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="RecognizeSeasonEpisodeCodesBox" Content="Códigos S01E02 e 1x02" Margin="0,0,18,13"/>
                                    <CheckBox x:Name="RecognizeEpisodePrefixesBox" Content="Prefixos Ep, Episódio e Episode" Margin="0,0,18,13"/>
                                    <CheckBox x:Name="RecognizeDashNumbersBox" Content="Número após hífen: Anime - 02" Margin="0,0,18,13"/>
                                    <CheckBox x:Name="RecognizeBracketNumbersBox" Content="Número entre colchetes: [02]" Margin="0,0,18,13"/>
                                    <CheckBox x:Name="RecognizeTrailingNumbersBox" Content="Número no final do arquivo" Margin="0,0,18,13"/>
                                    <CheckBox x:Name="UseFolderSeasonBox" Content="Usar nome da pasta como temporada" Margin="0,0,18,13"/>
                                    <CheckBox x:Name="RecognizeSpecialsBox" Content="Reconhecer OVA, OAD, especiais e recaps" Margin="0,0,18,0"/>
                                </UniformGrid>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Capas e cache" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Escolha onde ficam as artes persistentes e as cópias temporárias usadas para acelerar as telas." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                <TextBlock Text="Pasta padrão para capas e artes" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold"/><Grid Margin="0,6,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="ArtworkDirectoryBox" Style="{StaticResource SettingsTextBox}"/><Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Escolher…" Click="ChooseArtworkDirectory_Click" Margin="10,0,0,0"/></Grid>
                                <TextBlock Text="Pasta de cache" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="CacheDirectoryBox" Style="{StaticResource SettingsTextBox}"/><Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Escolher…" Click="ChooseCacheDirectory_Click" Margin="10,0,0,0"/></Grid>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Duplicatas" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Defina o que fazer quando dois arquivos parecem representar o mesmo episódio." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,12"/>
                                <ComboBox x:Name="DuplicateHandlingBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Manter as versões e marcar a preferida" Tag="KeepAndMark"/><ComboBoxItem Content="Ignorar arquivos idênticos" Tag="IgnoreIdentical"/><ComboBoxItem Content="Enviar possíveis duplicatas para revisão" Tag="SendToReview"/></ComboBox>
                            </StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="Exclusões" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Separe itens por vírgula ou por linha. Use * para padrões, como sample* ou *.part." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Pastas ignoradas" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="IgnoredFoldersBox" Height="86" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" Background="#0B2548" Foreground="White" BorderBrush="#3277AB" Padding="11,8"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Arquivos ignorados" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="IgnoredFilesBox" Height="86" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" Background="#0B2548" Foreground="White" BorderBrush="#3277AB" Padding="11,8"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Palavras ignoradas" Foreground="#BFD9EF" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="IgnoredWordsBox" Height="86" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" Background="#0B2548" Foreground="White" BorderBrush="#3277AB" Padding="11,8"/></StackPanel>
                                </Grid>
                            </StackPanel></Border>

                            <Border Background="#14152C4C" BorderBrush="#396F99" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,25,0"><TextBlock Text="Reconstruir catálogo" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Remove apenas o índice de arquivos e refaz a leitura de todas as pastas. Histórico, progresso, notas, favoritos e conquistas são preservados." Foreground="#9ABBD8" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="RebuildCatalogButton" Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Reconstruir catálogo" Click="RebuildCatalog_Click" MinWidth="180" Height="44"/></Grid></Border>
                            <TextBlock x:Name="LibrarySettingsStatusText" Foreground="#79E4B5" FontSize="12" TextWrapping="Wrap" Margin="4,13,0,0"/>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Experiência" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Ajuste o ritmo visual sem abrir mão da identidade do AniT." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>
                            <Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Transições entre páginas" Foreground="White" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="EnableTransitionsBox" Content="Usar a tela animada do Baki-Pi durante a navegação" Margin="0,17,0,0"/><TextBlock Text="Desative para trocar de página assim que o conteúdo estiver pronto." Foreground="#7E9FBE" FontSize="10" Margin="24,5,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Slider x:Name="LoadingDurationSlider" Minimum="250" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="LoadingDurationSlider_ValueChanged"/><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13" Padding="13" Margin="22,0,0,0"><TextBlock x:Name="LoadingDurationText" Text="620 ms" Foreground="#75DFFF" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/></Border></Grid><TextBlock Text="Tempo mínimo da máscara. Valores menores deixam a troca mais rápida; valores maiores priorizam a suavidade." Foreground="#7E9FBE" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Imagens confortáveis" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Ativado permanentemente: imagens grandes recebem versões suaves para cards pequenos, mantendo resolução alta em banners e no projetor." Foreground="#9ABBD8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/><Border Background="#123F69" BorderBrush="#42BDEB" BorderThickness="1" CornerRadius="12" Padding="12,7" HorizontalAlignment="Left" Margin="0,14,0,0"><TextBlock Text="✓ Otimização automática ativa" Foreground="#C9F4FF"/></Border></StackPanel></Border>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Imagens e artes" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Controle de onde vêm as capas, banners e fan arts, como são enquadradas e quanto espaço podem ocupar." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>

                            <Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Fontes e prioridade" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="O AniT tenta as fontes na ordem escolhida e mantém as demais como fallback." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Prioridade" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ArtworkSourcePriorityBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="AniList primeiro" Tag="AniListFirst"/><ComboBoxItem Content="Fontes oficiais primeiro" Tag="OfficialFirst"/><ComboBoxItem Content="Sites personalizados primeiro" Tag="CustomFirst"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fontes integradas" Foreground="#BFD9EF" FontSize="11"/><WrapPanel Margin="0,7,0,0"><Border Background="#123F69" CornerRadius="10" Padding="10,5" Margin="0,0,7,7"><TextBlock Text="AniList" Foreground="#C9F4FF"/></Border><Border Background="#123F69" CornerRadius="10" Padding="10,5" Margin="0,0,7,7"><TextBlock Text="MyAnimeList" Foreground="#C9F4FF"/></Border><Border Background="#123F69" CornerRadius="10" Padding="10,5" Margin="0,0,7,7"><TextBlock Text="Kitsu" Foreground="#C9F4FF"/></Border><Border Background="#123F69" CornerRadius="10" Padding="10,5" Margin="0,0,7,7"><TextBlock Text="Wallhaven" Foreground="#C9F4FF"/></Border><Border Background="#123F69" CornerRadius="10" Padding="10,5" Margin="0,0,7,7"><TextBlock Text="Boorus seguros" Foreground="#C9F4FF"/></Border></WrapPanel></StackPanel></Grid><WrapPanel Margin="0,17,0,0"><CheckBox x:Name="OnlySfwArtworkBox" Content="Permitir somente conteúdo marcado como SFW" Margin="0,0,28,0"/><CheckBox x:Name="PreferLocalArtworkBox" Content="Usar imagens locais antes das fontes online"/></WrapPanel></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Qualidade e armazenamento" Foreground="White" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Qualidade máxima" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ImageMaxDimensionBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Confortável · 1280 px" Tag="1280"/><ComboBoxItem Content="Alta · 1920 px" Tag="1920"/><ComboBoxItem Content="Muito alta · 2560 px" Tag="2560"/><ComboBoxItem Content="Ultra · 3840 px" Tag="3840"/><ComboBoxItem Content="Original · sem limite" Tag="0"/></ComboBox></StackPanel><StackPanel Grid.Column="2" Margin="0,0,22,0"><TextBlock Text="Limite do cache" Foreground="#BFD9EF" FontSize="11"/><TextBlock Text="Artes antigas são removidas primeiro; artes bloqueadas são preservadas." Foreground="#7E9FBE" FontSize="10" Margin="0,4,0,10"/><Slider x:Name="ImageCacheLimitSlider" Minimum="256" Maximum="8192" TickFrequency="256" IsSnapToTickEnabled="True" ValueChanged="ImageCacheLimitSlider_ValueChanged"/></StackPanel><Border Grid.Column="3" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="13"><TextBlock x:Name="ImageCacheLimitText" Text="2 GB" Foreground="#75DFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><DockPanel Margin="0,18,0,0"><TextBlock x:Name="ImageCacheStatusText" Text="Calculando uso do cache…" Foreground="#8FBDE0" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HomeOutlineButton}" Content="Limpar cache" Click="ClearImageCache_Click" MinWidth="130" Margin="0,0,10,0"/><Button Style="{StaticResource HomeOutlineButton}" Content="Reconstruir cache" Click="RebuildImageCache_Click" MinWidth="150"/></StackPanel></DockPanel></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Atualização automática" Foreground="White" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Verificar novas artes" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ArtworkRefreshBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Nunca automaticamente" Tag="0"/><ComboBoxItem Content="A cada 7 dias" Tag="7"/><ComboBoxItem Content="A cada 14 dias" Tag="14"/><ComboBoxItem Content="A cada 30 dias" Tag="30"/><ComboBoxItem Content="A cada 90 dias" Tag="90"/></ComboBox></StackPanel><TextBlock Grid.Column="2" Text="A atualização acontece quando a obra volta a ser aberta. Uma arte bloqueada nunca é substituída automaticamente." Foreground="#8FB2D2" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Enquadramento" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A opção manual amplia levemente a imagem e usa o ponto focal escolhido abaixo." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Modo" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ArtworkStretchBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Uniform · mostrar a imagem inteira" Tag="Uniform"/><ComboBoxItem Content="UniformToFill · preencher o card" Tag="UniformToFill"/><ComboBoxItem Content="Manual · escolher ponto focal" Tag="Manual"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Foco horizontal" Foreground="#BFD9EF" VerticalAlignment="Center"/><Slider x:Name="ArtworkFocusXSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ArtworkFocusSlider_ValueChanged" Margin="12,0"/><TextBlock x:Name="ArtworkFocusXText" Grid.Column="2" Text="50%" Foreground="#75DFFF" FontWeight="Bold" VerticalAlignment="Center"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Foco vertical" Foreground="#BFD9EF" VerticalAlignment="Center"/><Slider x:Name="ArtworkFocusYSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ArtworkFocusSlider_ValueChanged" Margin="12,0"/><TextBlock x:Name="ArtworkFocusYText" Grid.Column="2" Text="50%" Foreground="#75DFFF" FontWeight="Bold" VerticalAlignment="Center"/></Grid></StackPanel></Grid></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeOutlineButton}" Content="Desbloquear todas" Click="UnlockAllArtwork_Click" MinWidth="150"/><StackPanel><TextBlock Text="Artes bloqueadas" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="LockedArtworkCountText" Text="Nenhuma arte bloqueada" Foreground="#8FB2D2" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel><TextBlock Text="No projetor da página do anime, use “Bloquear esta arte” para mantê-la mesmo após atualizações automáticas ou reconstrução do cache." Foreground="#7E9FBE" FontSize="10" TextWrapping="Wrap" Margin="0,13,0,0"/></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Sites personalizados" Foreground="White" FontSize="18" FontWeight="SemiBold"/><ItemsControl x:Name="SourcesList" ItemsSource="{Binding ImageSources}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0A2345" BorderBrush="#286797" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding SearchUrlTemplate}" Foreground="#7EB5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,10"/><WrapPanel><CheckBox Content="Ativa" IsChecked="{Binding IsEnabled}" Margin="0,0,20,8"/><CheckBox Content="Banners e fan arts" IsChecked="{Binding UseForProfileBanners}" Margin="0,0,20,8"/><CheckBox Content="Capas" IsChecked="{Binding UseForAnimeCovers}" Margin="0,0,20,8"/><CheckBox Content="Fonte SFW" IsChecked="{Binding IsSfw}" Margin="0,0,0,8"/></WrapPanel></StackPanel><Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Remover" Tag="{Binding Id}" Click="RemoveSource_Click" MinWidth="96" Margin="18,0,0,0" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="#091E3B" BorderBrush="#3277AB" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,5,0,0"><StackPanel><TextBlock Text="Adicionar fonte personalizada" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Use uma URL HTTPS e {query} no local do termo de busca." Foreground="#7E9FBE" FontSize="10" Margin="0,4,0,11"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="SourceNameBox" Style="{StaticResource SettingsTextBox}" ToolTip="Nome da fonte"/><TextBox x:Name="SourceUrlBox" Grid.Column="1" Style="{StaticResource SettingsTextBox}" Margin="10,0" ToolTip="https://exemplo.com/busca?q={query}"/><Button Grid.Column="2" Style="{StaticResource HomePrimaryButton}" Content="Adicionar" Click="AddSource_Click"/></Grid><WrapPanel Margin="0,13,0,0"><CheckBox x:Name="UseForBannersBox" Content="Banners e fan arts" IsChecked="True" Margin="0,0,22,8"/><CheckBox x:Name="UseForCoversBox" Content="Capas" Margin="0,0,22,8"/><CheckBox x:Name="SourceIsSfwBox" Content="Esta fonte é SFW" IsChecked="True"/></WrapPanel><TextBlock x:Name="ValidationText" Foreground="#FF9FB1" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel></Border></StackPanel></Border>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Dados e backup" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Proteja a jornada, leve os dados para outro computador e mantenha o banco saudável." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,14"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomePrimaryButton}" Content="Criar backup agora" Click="RunAutomaticBackupNow_Click" MinWidth="170"/><StackPanel><TextBlock Text="Backup automático" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Snapshots completos com retenção automática. A pasta pode estar no OneDrive, Google Drive, Dropbox, NAS ou disco local." Foreground="#8FB2D2" FontSize="11" Margin="0,5,18,0" TextWrapping="Wrap"/></StackPanel></DockPanel><CheckBox x:Name="AutomaticBackupEnabledBox" Content="Ativar backup automático" Margin="0,15,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Frequência" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="AutomaticBackupFrequencyBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="A cada inicialização" Tag="EveryStartup"/><ComboBoxItem Content="Diariamente" Tag="Daily"/><ComboBoxItem Content="Semanalmente" Tag="Weekly"/><ComboBoxItem Content="Mensalmente" Tag="Monthly"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quantidade mantida" Foreground="#BFD9EF" FontSize="11"/><Slider x:Name="AutomaticBackupRetentionSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,14,0" ValueChanged="AutomaticBackupRetentionSlider_ValueChanged"/></StackPanel><Border Grid.Column="3" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="12"><TextBlock x:Name="AutomaticBackupRetentionText" Foreground="#75DFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><TextBlock Text="Pasta de destino" Foreground="#BFD9EF" FontSize="11" Margin="0,15,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="AutomaticBackupDirectoryBox" Style="{StaticResource SettingsTextBox}"/><Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Escolher pasta" Click="ChooseAutomaticBackupDirectory_Click" Margin="12,0,0,0"/></Grid></StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="17" Background="#153F6B" BorderBrush="#54D5FF" BorderThickness="1"><Viewbox Margin="14"><Path Data="{StaticResource AniT.Icon.Download}" Stroke="#75E4FF" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,28,0"><TextBlock Text="Exportar backup portátil" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Cria um arquivo .anitbackup com perfil, catálogo, histórico, progresso, notas, favoritos, conquistas, configurações e artes em cache." Foreground="#96B9D8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Style="{StaticResource HomePrimaryButton}" Click="ExportBackup_Click" MinWidth="168" Height="46"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Download}" Width="17" Height="17" Stroke="White" StrokeThickness="1.8" Fill="Transparent"/><TextBlock Text="Exportar agora" Margin="8,0,0,0"/></StackPanel></Button></Grid></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="17" Background="#153F6B" BorderBrush="#82E4B8" BorderThickness="1"><Viewbox Margin="14"><Path Data="{StaticResource AniT.Icon.Upload}" Stroke="#92F1C5" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,28,0"><TextBlock Text="Importar e restaurar" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Valida versão, integridade e hashes antes de alterar qualquer dado. Um ponto de recuperação do estado atual é criado automaticamente." Foreground="#96B9D8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Style="{StaticResource HomeOutlineButton}" Click="ImportBackup_Click" MinWidth="168" Height="46"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Upload}" Width="17" Height="17" Stroke="#C9F4FF" StrokeThickness="1.8" Fill="Transparent"/><TextBlock Text="Escolher arquivo" Margin="8,0,0,0"/></StackPanel></Button></Grid></Border>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#C70A2345" BorderBrush="#2B6A9E" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Lock}" Width="18" Height="18" Stroke="#74DDFF" StrokeThickness="1.8" Fill="Transparent"/><TextBlock Text="Seguro por padrão" Foreground="White" FontWeight="SemiBold" Margin="9,0,0,0"/></StackPanel><TextBlock Text="Snapshot consistente do banco SQLite, formato versionado e SHA-256 para detectar arquivos incompletos ou alterados." Foreground="#8FB2D2" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#C70A2345" BorderBrush="#2B6A9E" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Cloud}" Width="19" Height="19" Stroke="#92F1C5" StrokeThickness="1.8" Fill="Transparent"/><TextBlock Text="Pronto para a nuvem" Foreground="White" FontWeight="SemiBold" Margin="9,0,0,0"/></StackPanel><TextBlock Text="Salve diretamente em uma pasta do OneDrive, Google Drive, Dropbox, NAS, pendrive ou qualquer local do sistema." Foreground="#8FB2D2" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></Grid>
                            <Border Background="#16173B58" BorderBrush="#3D719A" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,14,0,0"><StackPanel><TextBlock Text="Os vídeos não são duplicados no backup" Foreground="#D9ECFA" FontWeight="SemiBold"/><TextBlock Text="O AniT preserva as referências e, no novo computador, ajuda a reconectar a nova pasta. Arquivos reconhecidos são ligados automaticamente ao histórico; nomes ambíguos aparecem para confirmação manual." Foreground="#91B3D0" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Exportar dados" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="JSON preserva a estrutura completa; CSV abre facilmente em planilhas e contém uma linha por episódio." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ComboBox x:Name="PersonalDataExportFormatBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="JSON estruturado" Tag="Json"/><ComboBoxItem Content="CSV para planilhas" Tag="Csv"/></ComboBox><Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Exportar dados" Click="ExportConfiguredData_Click" Margin="12,0,0,0"/></Grid></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Restaurar padrões por seção" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Redefine somente a área escolhida; biblioteca, perfil e histórico não são apagados." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ComboBox x:Name="ResetSettingsSectionBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Página inicial" Tag="General"/><ComboBoxItem Content="Aparência" Tag="Appearance"/><ComboBoxItem Content="Biblioteca" Tag="Shelf"/><ComboBoxItem Content="Reprodução" Tag="Playback"/><ComboBoxItem Content="Organização" Tag="Organization"/><ComboBoxItem Content="Notificações" Tag="Notifications"/><ComboBoxItem Content="Imagens e artes" Tag="Images"/><ComboBoxItem Content="Dados e backup" Tag="Backup"/></ComboBox><Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Restaurar seção" Click="ResetSettingsSection_Click" Margin="12,0,0,0"/></Grid></StackPanel></Border></Grid>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Diagnóstico e manutenção do banco" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Verifica integridade, vínculos e tamanho. A manutenção cria um backup de recuperação antes de reconstruir índices e compactar o SQLite; corrupção estrutural continua sendo informada, sem prometer recuperação automática." Foreground="#8FB2D2" FontSize="11" Margin="0,6,18,0" TextWrapping="Wrap"/><TextBlock x:Name="DatabaseDiagnosticStatusText" Foreground="#7FE5B8" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Executar diagnóstico" Click="DiagnoseDatabase_Click" MinWidth="165" Margin="12,0,0,0" VerticalAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource HomePrimaryButton}" Content="Criar backup e otimizar" Click="RepairDatabase_Click" MinWidth="185" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></Border>
                            <Border Background="#16173B58" BorderBrush="#3D719A" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,14,0,0"><StackPanel><CheckBox x:Name="PrepareFutureSyncBox" Content="Preparar este dispositivo para sincronização futura entre computadores"/><TextBlock Text="Esta opção apenas mantém identificadores portáteis e preferências prontas. Nenhum dado é enviado agora; um provedor de nuvem será exigido quando a sincronização for disponibilizada." Foreground="#91B3D0" FontSize="10" TextWrapping="Wrap" Margin="24,6,0,0"/></StackPanel></Border>
                            <TextBlock x:Name="BackupStatusText" Foreground="#79E4B5" FontSize="12" TextWrapping="Wrap" Margin="4,14,0,0"/>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Organização" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Escolha como o catálogo é apresentado e corrija a organização sem perder histórico ou progresso." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>

                            <Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Nomes e exibição" Foreground="White" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Formato dos episódios" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="EpisodeNumberFormatBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="01" Tag="NumberOnly"/><ComboBoxItem Content="E01" Tag="EpisodePrefix"/><ComboBoxItem Content="S01E01" Tag="SeasonEpisode"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Preferência de título" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="AnimeTitlePreferenceBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Português" Tag="Portuguese"/><ComboBoxItem Content="Inglês" Tag="English"/><ComboBoxItem Content="Romaji" Tag="Romaji"/><ComboBoxItem Content="Japonês" Tag="Japanese"/></ComboBox></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Ordenação da Biblioteca" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="LibraryDefaultSortBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Adicionados recentemente" Tag="RecentlyAdded"/><ComboBoxItem Content="Título · A–Z" Tag="Title"/><ComboBoxItem Content="Ano · mais novos" Tag="ReleaseYearNewest"/><ComboBoxItem Content="Ano · mais antigos" Tag="ReleaseYearOldest"/><ComboBoxItem Content="Melhor avaliados" Tag="Score"/><ComboBoxItem Content="Mais avançados" Tag="Progress"/><ComboBoxItem Content="Favoritos" Tag="Favorites"/></ComboBox></StackPanel></Grid></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Regras automáticas" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="As regras têm prioridade sobre a ordenação escolhida e continuam respeitando os filtros da Biblioteca." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/><CheckBox x:Name="FavoritesFirstRuleBox" Content="Mostrar favoritos primeiro" Margin="0,0,0,12"/><CheckBox x:Name="InProgressFirstRuleBox" Content="Mostrar títulos em andamento antes dos demais"/></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Tags e coleções" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Cadastre uma opção por linha. Depois, atribua-as pelo botão Organizar na página do anime e use os filtros da Biblioteca. Tudo acompanha o backup." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tags personalizadas" Foreground="#BFD9EF" FontSize="11"/><TextBox x:Name="CustomTagsBox" Height="116" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" Background="#0B2548" Foreground="White" BorderBrush="#3277AB" Padding="11,8" ToolTip="Exemplo: Rever&#x0a;Favorito da temporada&#x0a;Assistir com amigos"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Coleções criadas pelo usuário" Foreground="#BFD9EF" FontSize="11"/><TextBox x:Name="UserCollectionsBox" Height="116" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" Background="#0B2548" Foreground="White" BorderBrush="#3277AB" Padding="11,8" ToolTip="Exemplo: Clássicos&#x0a;Fim de semana&#x0a;Top pessoal"/></StackPanel></Grid></StackPanel></Border>

                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Renomear com segurança" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Gera a lista Antes → Depois com o padrão escolhido acima. Arquivos e legendas só são movidos após confirmação." Foreground="#8FB2D2" FontSize="11" Margin="0,7,0,16" TextWrapping="Wrap"/><Button Style="{StaticResource HomeOutlineButton}" Content="Abrir prévia de renomeação" Click="OpenRenamePreview_Click" HorizontalAlignment="Left" MinWidth="220"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Corrigir títulos" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Mescle títulos duplicados ou separe episódios que foram associados à obra errada, preservando arquivos e progresso." Foreground="#8FB2D2" FontSize="11" Margin="0,7,0,16" TextWrapping="Wrap"/><Button Style="{StaticResource HomeOutlineButton}" Content="Mesclar ou separar títulos" Click="OpenCatalogCorrection_Click" HorizontalAlignment="Left" MinWidth="220"/></StackPanel></Border></Grid>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Notificações" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Escolha quais acontecimentos merecem um aviso e quando o AniT deve permanecer em silêncio." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>

                            <Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="O que avisar" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Os avisos são agrupados para evitar várias mensagens durante uma única atualização." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="NotifyNewEpisodesBox" Content="Novos episódios encontrados" Margin="0,0,0,14"/><CheckBox x:Name="NotifyMetadataUpdatesBox" Content="Capas ou metadados atualizados"/></StackPanel><StackPanel Grid.Column="2"><CheckBox x:Name="NotifyAchievementsBox" Content="Conquistas desbloqueadas" Margin="0,0,0,14"/><CheckBox x:Name="WeeklyWatchSummaryBox" Content="Resumo semanal de episódios assistidos"/></StackPanel></Grid></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Horário silencioso" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Durante esse período nenhum aviso visual ou do Windows será exibido. Intervalos podem atravessar a meia-noite." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,15" TextWrapping="Wrap"/><CheckBox x:Name="QuietHoursEnabledBox" Content="Ativar horário silencioso" Margin="0,0,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Começa às" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="QuietHoursStartBox" Style="{StaticResource SettingsComboBox}" DisplayMemberPath="Label" SelectedValuePath="Hour"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Termina às" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="QuietHoursEndBox" Style="{StaticResource SettingsComboBox}" DisplayMemberPath="Label" SelectedValuePath="Hour"/></StackPanel></Grid></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Onde exibir" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Os avisos internos usam o visual do AniT. A opção do Windows também envia uma notificação nativa para a central do sistema." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap"/><ComboBox x:Name="NotificationDeliveryModeBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag" MaxWidth="430" HorizontalAlignment="Left"><ComboBoxItem Content="Somente dentro do AniT" Tag="InAppOnly"/><ComboBoxItem Content="Dentro do AniT e também no Windows" Tag="WindowsAndInApp"/></ComboBox></StackPanel><Button Grid.Column="2" Style="{StaticResource HomeOutlineButton}" Content="Enviar notificação de teste" Click="TestNotification_Click" MinWidth="210" VerticalAlignment="Bottom"/></Grid></Border>

                            <Border Background="#16173B58" BorderBrush="#3D719A" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,14,0,0"><TextBlock Text="O resumo semanal considera os últimos sete dias e informa quantos episódios e horas foram assistidos. Ele aparece no máximo uma vez por semana." Foreground="#91B3D0" FontSize="11" TextWrapping="Wrap"/></Border>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Perfil e privacidade" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Controle sua identidade, o que aparece no perfil e mantenha jornadas separadas para cada pessoa deste computador." Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,18"/>

                            <Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Perfis deste computador" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Cada perfil possui histórico, progresso, notas, favoritos e conquistas próprios. A troca reinicia o AniT com segurança." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ComboBox x:Name="LocalProfileSelectorBox" Style="{StaticResource SettingsComboBox}" DisplayMemberPath="DisplayName" SelectedValuePath="ProfileId" SelectionChanged="LocalProfileSelectorBox_SelectionChanged"/><Button Grid.Column="1" Style="{StaticResource HomePrimaryButton}" Content="Trocar perfil" Click="SwitchProfile_Click" Margin="12,0,0,0"/><Button Grid.Column="2" Style="{StaticResource HomeOutlineButton}" Content="Excluir" Click="DeleteProfile_Click" Margin="12,0,0,0"/></Grid><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBox x:Name="NewProfileNameBox" Style="{StaticResource SettingsTextBox}" MaxLength="32" ToolTip="Nome do novo perfil"/><Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Criar novo perfil" Click="CreateProfile_Click" Margin="12,0,0,0"/></Grid><TextBlock x:Name="ProfileManagementStatusText" Foreground="#83E7BD" FontSize="11" Margin="2,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel HorizontalAlignment="Center"><Border Width="174" Height="108" CornerRadius="13" ClipToBounds="True" BorderBrush="#4ACFFF" BorderThickness="1"><Image x:Name="ProfileBannerPreview" Stretch="UniformToFill"/></Border><Ellipse Width="122" Height="122" Margin="0,-28,0,0" Stroke="#75E5FF" StrokeThickness="3"><Ellipse.Fill><ImageBrush x:Name="ProfileAvatarPreviewBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><Button Style="{StaticResource HomeOutlineButton}" Content="Escolher avatar e capa" Click="EditProfileArtwork_Click" Margin="0,12,0,0" MinWidth="180"/></StackPanel><StackPanel Grid.Column="1" Margin="28,0,0,0"><TextBlock Text="Identidade exibida" Foreground="White" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nome" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="ProfileDisplayNameBox" Style="{StaticResource SettingsTextBox}" MaxLength="32"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Título exibido" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="ProfileDisplayTitleBox" Style="{StaticResource SettingsTextBox}" MaxLength="48" ToolTip="Exemplo: Explorador de Mundos"/></StackPanel></Grid><TextBlock Text="Frase do perfil" Foreground="#BFD9EF" FontSize="11" Margin="0,14,0,6"/><TextBox x:Name="ProfileBioBox" MinHeight="72" MaxHeight="100" AcceptsReturn="True" TextWrapping="Wrap" Background="#0B2548" Foreground="White" BorderBrush="#3277AB" Padding="12,9" MaxLength="180"/></StackPanel></Grid></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Avatar: tamanho e enquadramento" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="O tamanho altera a presença do avatar; zoom e foco escolhem exatamente qual parte da imagem fica dentro do círculo." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,15" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tamanho" Foreground="#BFD9EF" FontSize="11"/><Slider x:Name="ProfileAvatarSizeSlider" Minimum="104" Maximum="190" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,9,16,0" ValueChanged="ProfileAvatarSlider_ValueChanged"/></StackPanel><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="12"><TextBlock x:Name="ProfileAvatarSizeText" Foreground="#75DFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="3"><TextBlock Text="Zoom" Foreground="#BFD9EF" FontSize="11"/><Slider x:Name="ProfileAvatarZoomSlider" Minimum="100" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,9,16,0" ValueChanged="ProfileAvatarSlider_ValueChanged"/></StackPanel><Border Grid.Column="4" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="12"><TextBlock x:Name="ProfileAvatarZoomText" Foreground="#75DFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Foco horizontal" Foreground="#BFD9EF" FontSize="11"/><Slider x:Name="ProfileAvatarFocusXSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="ProfileAvatarSlider_ValueChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Foco vertical" Foreground="#BFD9EF" FontSize="11"/><Slider x:Name="ProfileAvatarFocusYSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="ProfileAvatarSlider_ValueChanged"/></StackPanel></Grid></StackPanel></Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Privacidade" Foreground="White" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Visibilidade do perfil" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ProfileVisibilityBox" Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag"><ComboBoxItem Content="Somente local neste computador" Tag="Local"/><ComboBoxItem Content="Público quando houver compartilhamento" Tag="Public"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><CheckBox x:Name="HideProfileHistoryBox" Content="Ocultar histórico e atividade recente" Margin="0,0,0,12"/><CheckBox x:Name="HideProfileRatingsBox" Content="Ocultar notas e Top 5" Margin="0,0,0,12"/><CheckBox x:Name="HideProfileFavoritesBox" Content="Ocultar favoritos"/></StackPanel></Grid><TextBlock Text="O AniT não publica dados automaticamente. O modo público apenas autoriza que essas informações apareçam em futuras exportações ou compartilhamentos iniciados por você." Foreground="#7E9FBE" FontSize="10" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>

                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Exportar dados pessoais" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Gera um JSON legível com perfil, histórico, progresso, avaliações, favoritos e conquistas. Nenhum vídeo é copiado." Foreground="#8FB2D2" FontSize="11" Margin="0,7,0,16" TextWrapping="Wrap"/><Button Style="{StaticResource HomeOutlineButton}" Content="Exportar meus dados" Click="ExportPersonalData_Click" HorizontalAlignment="Left" MinWidth="190"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource SettingsPanel}" BorderBrush="#A95A68"><StackPanel><TextBlock Text="Limpar histórico" Foreground="#FFDCE2" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Remove progresso, datas e estados de reprodução deste perfil. Biblioteca, arquivos, capas, notas e favoritos permanecem intactos." Foreground="#CBA2AA" FontSize="11" Margin="0,7,0,16" TextWrapping="Wrap"/><Button Style="{StaticResource HomeOutlineButton}" Content="Limpar histórico deste perfil" Click="ClearProfileHistory_Click" HorizontalAlignment="Left" MinWidth="220"/></StackPanel></Border></Grid>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
                            <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Style="{StaticResource HomeOutlineButton}" Content="Restaurar padrões avançados" Click="ResetAdvanced_Click" MinWidth="205"/><StackPanel><TextBlock Text="Avançado" Style="{StaticResource SettingsPageTitle}"/><TextBlock Text="Ajustes técnicos para rede, manutenção e produtividade. Os padrões continuam sendo a opção mais segura para a maioria das pessoas." Style="{StaticResource SettingsPageDescription}" Margin="0,6,20,0"/></StackPanel></DockPanel>
                            <Border Style="{StaticResource SettingsPanel}"><StackPanel><TextBlock Text="Conexões e fontes online" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="O modo offline bloqueia toda requisição das fontes integradas, sem impedir biblioteca, reprodução ou histórico local." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,15" TextWrapping="Wrap"/><CheckBox x:Name="OfflineModeBox" Content="Modo totalmente offline" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Conexões simultâneas" Foreground="#BFD9EF" FontSize="11"/><Slider x:Name="OnlineConnectionLimitSlider" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,14,0" ValueChanged="AdvancedNetworkSlider_ValueChanged"/></StackPanel><Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="12"><TextBlock x:Name="OnlineConnectionLimitText" Foreground="#75DFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="3"><TextBlock Text="Tempo limite por fonte" Foreground="#BFD9EF" FontSize="11"/><Slider x:Name="OnlineTimeoutSlider" Minimum="3" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,14,0" ValueChanged="AdvancedNetworkSlider_ValueChanged"/></StackPanel><Border Grid.Column="4" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="12"><TextBlock x:Name="OnlineTimeoutText" Foreground="#75DFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HomeOutlineButton}" Content="Abrir cache" Click="OpenCacheFolder_Click" MinWidth="120" Margin="0,0,10,0"/><Button Style="{StaticResource HomeOutlineButton}" Content="Abrir dados" Click="OpenDataFolder_Click" MinWidth="120" Margin="0,0,10,0"/><Button Style="{StaticResource HomeOutlineButton}" Content="Abrir logs" Click="OpenLogsFolder_Click" MinWidth="120"/></StackPanel><StackPanel><TextBlock Text="Registro de diagnóstico" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Logs rotativos registram inicialização, operações avançadas e falhas das fontes sem copiar seus vídeos." Foreground="#8FB2D2" FontSize="11" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel></DockPanel><CheckBox x:Name="DiagnosticLoggingBox" Content="Ativar registro detalhado de diagnóstico" Margin="0,16,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Reprocessamento seletivo" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Execute apenas a camada necessária. Metadados preserva imagens; Imagens reconstrói artes; Arquivos relê as pastas monitoradas." Foreground="#8FB2D2" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/><UniformGrid Columns="3"><Button Style="{StaticResource HomeOutlineButton}" Content="Reprocessar metadados" Tag="Metadata" Click="ReprocessContent_Click" Margin="0,0,10,0"/><Button Style="{StaticResource HomeOutlineButton}" Content="Reprocessar imagens" Tag="Images" Click="ReprocessContent_Click" Margin="0,0,10,0"/><Button Style="{StaticResource HomeOutlineButton}" Content="Reprocessar arquivos" Tag="Files" Click="ReprocessContent_Click"/></UniformGrid><TextBlock x:Name="AdvancedOperationStatusText" Foreground="#7FE5B8" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeOutlineButton}" Content="Restaurar atalhos" Click="ResetShortcuts_Click" MinWidth="145"/><StackPanel><TextBlock Text="Atalhos de teclado" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use combinações como Ctrl+H, Ctrl+Shift+H ou Ctrl+OemComma. Atalhos repetidos são recusados ao salvar." Foreground="#8FB2D2" FontSize="11" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel></DockPanel><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Início" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ShortcutHomeBox" Style="{StaticResource SettingsTextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Biblioteca" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ShortcutLibraryBox" Style="{StaticResource SettingsTextBox}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Busca" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ShortcutSearchBox" Style="{StaticResource SettingsTextBox}"/></StackPanel></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Histórico" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ShortcutHistoryBox" Style="{StaticResource SettingsTextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Configurações avançadas" Foreground="#BFD9EF" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ShortcutSettingsBox" Style="{StaticResource SettingsTextBox}"/></StackPanel></Grid><TextBlock x:Name="ShortcutValidationText" Foreground="#FF9FB1" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><CheckBox x:Name="DeveloperModeBox" Content="Ativar modo desenvolvedor" Checked="DeveloperMode_Changed" Unchecked="DeveloperMode_Changed"/><Border x:Name="DeveloperInfoPanel" Background="#081A33" BorderBrush="#326B98" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,14,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="Informações técnicas" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DeveloperInfoText" Foreground="#9FC6E6" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Border>
                        </StackPanel></ScrollViewer></TabItem>
                    </TabControl>
                </Grid>
                <DockPanel Grid.Row="2" Margin="280,18,10,0"><TextBlock x:Name="SaveStatusText" Foreground="#79E4B5" VerticalAlignment="Center" TextWrapping="Wrap"/><Button DockPanel.Dock="Right" Style="{StaticResource HomePrimaryButton}" Content="Salvar configurações" Click="Save_Click" MinWidth="190"/></DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
