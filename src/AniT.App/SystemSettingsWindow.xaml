<Window x:Class="AniT.App.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AniT.App"
        Title="Configurações gerais · AniT" Width="1440" Height="900" MinWidth="1060" MinHeight="700"
        Background="#020B1D" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsPanel" TargetType="Border">
                <Setter Property="Background" Value="#E9071B37"/>
                <Setter Property="BorderBrush" Value="#2B72A8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
            <Style x:Key="SettingsTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Background" Value="#0B2548"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CaretBrush" Value="#65D9FF"/>
                <Setter Property="BorderBrush" Value="#3277AB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="13,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#D7EAFF"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.72,0.05" Center="0.72,0.05" RadiusX="0.95" RadiusY="1.05"><GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.43"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeNavButton}" Click="Home_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Home}" Label="Início"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Explore_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Explore}" Label="Explorar"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Library_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Library}" Label="Biblioteca"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Calendar_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Calendar}" Label="Calendário"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="History_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.History}" Label="Histórico"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Achievements_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Achievements}" Label="Conquistas"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Profile_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Profile}" Label="Perfil"/></Button>
                    <Border Height="1" Background="#214874" Margin="20,18,20,11"/>
                    <TextBlock Text="SISTEMA" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,7"/>
                    <Button Style="{StaticResource HomeActiveNavButton}"><local:NavItemContent IconData="{StaticResource AniT.Icon.Settings}" Label="Configurações gerais"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="ConfigureShelf_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Library}" Label="Configurar estante"/></Button>
                </StackPanel>
                <Image Grid.Row="2" Source="Assets/ghost_menu.png" Style="{StaticResource HomeSidebarMascot}"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1">
                <Grid MaxWidth="2500" Margin="28,0">
                    <TextBlock Text="Configurações do AniT" Foreground="#DDF2FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource HomeTopButton}" Content="⌂  Início" Click="Home_Click"/>
                        <Button Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/>
                        <Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/>
                        <local:ProfileAvatarButton/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1240" Margin="34,28,34,54" HorizontalAlignment="Stretch">
                    <TextBlock Text="Configurações gerais" Foreground="White" FontSize="34" FontWeight="Bold"/>
                    <TextBlock Text="Personalize o comportamento do AniT. Novas opções poderão ser adicionadas aqui sem bagunçar as outras telas." Foreground="#9EC4E5" FontSize="14" Margin="0,7,0,24" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource SettingsPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,34,0">
                                <TextBlock Text="◷  Banner da página inicial" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Escolha por quanto tempo cada destaque permanece antes da próxima imagem." Foreground="#94B7D7" FontSize="12" Margin="0,6,0,18"/>
                                <Slider x:Name="BannerIntervalSlider" Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BannerIntervalSlider_ValueChanged"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#12365F" BorderBrush="#3B89BA" BorderThickness="1" CornerRadius="15" Padding="18">
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="TEMPO ENTRE DESTAQUES" Foreground="#83B4D8" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="BannerIntervalText" Text="8 segundos" Foreground="#75DFFF" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock Text="Aplicado ao abrir novamente o Início" Foreground="#9ABBD8" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsPanel}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="✦  Fontes de imagens" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="Wallhaven (fan arts SFW) e AniList (artes oficiais) já vêm integrados. Adicione outras páginas de busca HTTPS usando {query} no lugar do termo pesquisado." Foreground="#94B7D7" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,0,0,16">
                                <Border Background="#123F69" BorderBrush="#42BDEB" BorderThickness="1" CornerRadius="13" Padding="13,7" Margin="0,0,9,8"><TextBlock Text="✓ Wallhaven · fan arts SFW" Foreground="#C9F4FF"/></Border>
                                <Border Background="#123F69" BorderBrush="#42BDEB" BorderThickness="1" CornerRadius="13" Padding="13,7" Margin="0,0,9,8"><TextBlock Text="✓ AniList · artes oficiais" Foreground="#C9F4FF"/></Border>
                            </WrapPanel>

                            <ItemsControl x:Name="SourcesList" ItemsSource="{Binding ImageSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0A2345" BorderBrush="#286797" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding SearchUrlTemplate}" Foreground="#7EB5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><CheckBox Content="Ativa" IsChecked="{Binding IsEnabled}" Margin="0,0,20,0"/><CheckBox Content="Planos de fundo" IsChecked="{Binding UseForProfileBanners}" Margin="0,0,20,0"/><CheckBox Content="Capas de anime" IsChecked="{Binding UseForAnimeCovers}"/></StackPanel></StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Remover" Tag="{Binding Id}" Click="RemoveSource_Click" MinWidth="96" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#091E3B" BorderBrush="#3277AB" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Adicionar uma fonte" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                    <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="SourceNameBox" Style="{StaticResource SettingsTextBox}" ToolTip="Nome da fonte"/><TextBox x:Name="SourceUrlBox" Grid.Column="1" Style="{StaticResource SettingsTextBox}" Margin="10,0" ToolTip="https://exemplo.com/busca?q={query}"/><Button Grid.Column="2" Style="{StaticResource HomePrimaryButton}" Content="Adicionar" Click="AddSource_Click"/></Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,13,0,0"><CheckBox x:Name="UseForBannersBox" Content="Usar em planos de fundo" IsChecked="True" Margin="0,0,22,0"/><CheckBox x:Name="UseForCoversBox" Content="Usar em capas de anime"/></StackPanel>
                                    <TextBlock x:Name="ValidationText" Foreground="#FF9FB1" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,20,0,0"><TextBlock x:Name="SaveStatusText" Foreground="#79E4B5" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Style="{StaticResource HomePrimaryButton}" Content="Salvar configurações" Click="Save_Click" MinWidth="190"/></DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
