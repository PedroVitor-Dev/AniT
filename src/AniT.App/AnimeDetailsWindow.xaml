<Window x:Class="AniT.App.AnimeDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Anime · AniT" Width="1050" Height="760" MinWidth="850" MinHeight="600" Background="#070B16" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Activated="Window_Activated">
    <Window.Resources><Style x:Key="EpisodeRow" TargetType="Border"><Setter Property="Background" Value="#10192A"/><Setter Property="BorderBrush" Value="#2A3C59"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="18,15"/><Setter Property="Cursor" Value="Hand"/><EventSetter Event="MouseLeftButtonUp" Handler="EpisodeRow_Click"/></Style><Style x:Key="ActionButton" TargetType="Button"><Setter Property="Background" Value="#2FA7FF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#59B9FF"/></Trigger></Style.Triggers></Style></Window.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="260"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#101B30" BorderBrush="#294361" BorderThickness="0,0,0,1"><Grid Margin="42,34"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="145" Height="190" CornerRadius="16" Background="#142A48" BorderBrush="#2D527A" BorderThickness="1" VerticalAlignment="Center"><Grid ClipToBounds="True"><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173C65" Offset="0"/><GradientStop Color="#0D1A31" Offset="0.65"/><GradientStop Color="#102B4D" Offset="1"/></LinearGradientBrush></Border.Background></Border><Image Source="Assets/normal-sf.png" Width="105" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-15,-18" Opacity="0.2"/><TextBlock Text="{Binding Initial}" Foreground="#53B6FF" FontSize="70" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle RadiusX="16" RadiusY="16"><Rectangle.Fill><ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle></Grid></Border><StackPanel Grid.Column="1" Margin="28,12,0,0"><TextBlock Text="{Binding AnimeTitle}" Foreground="White" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding EnglishTitleDisplay}" Foreground="#7896BA" FontSize="14" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="#A6BDDB" FontSize="14" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Style="{StaticResource ActionButton}" Content="{Binding PlayNextLabel}" Click="PlayNext_Click"/><TextBlock Text="Progresso salvo localmente" Foreground="#7F9EC4" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></StackPanel></Grid></Border><Grid Grid.Row="1" Margin="42,31"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Episódios" Foreground="White" FontSize="21" FontWeight="SemiBold" DockPanel.Dock="Left"/><TextBlock Text="{Binding EpisodeCountLabel}" Foreground="#8FA9CD" FontSize="13" VerticalAlignment="Bottom" DockPanel.Dock="Right"/></DockPanel><Border Grid.Row="1" Background="#10192A" BorderBrush="#2A405E" BorderThickness="1" CornerRadius="14" Margin="0,18,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Episodes}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource EpisodeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions><Border Width="35" Height="35" CornerRadius="18" Background="#1B3355" VerticalAlignment="Center"><TextBlock Text="{Binding Number}" Foreground="#D9E9FF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProgressLabel}" Foreground="#91ABD0" FontSize="12" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button Grid.Column="3" Style="{StaticResource ActionButton}" Content="{Binding WatchedActionLabel}" Tag="{Binding Id}" Click="ToggleWatched_Click" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border></Grid></Grid>
</Window>
