<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:AniT.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AniT.App.AnimeDetailsWindow" Title="Página do Anime · AniT" Width="1440" Height="900" MinWidth="1060" MinHeight="700" Background="{DynamicResource AniT.Background}" WindowStartupLocation="CenterOwner" WindowState="Maximized" Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AniT.Presentation;component/Themes/Components.xaml" />
                <ResourceDictionary Source="Styles/HomeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DetailPanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AniT.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AniT.Border}" />
                <Setter Property="BorderThickness" Value="1.25" />
                <Setter Property="CornerRadius" Value="{DynamicResource AniT.Radius}" />
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="Tag" Value="18" />
                <EventSetter Event="SizeChanged" Handler="RoundedPanel_SizeChanged" />
            </Style>
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource AniT.ActionButton}">
                <Setter Property="Padding" Value="21,11" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource AniT.SecondaryButton}">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}" />
            </Style>
            <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource AniT.HeaderButton}">
                <Setter Property="Background" Value="{DynamicResource AniT.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource AniT.Text}" />
                <Setter Property="Padding" Value="9,5" />
                <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}" />
            </Style>
            <Style x:Key="AnimeTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource AniT.Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="22,14" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource AniT.Focus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                                </Border>
                                <Border x:Name="SelectionLine" Height="3" CornerRadius="{DynamicResource AniT.ControlRadius}" Background="{DynamicResource AniT.Accent}" VerticalAlignment="Bottom" Margin="12,0" Opacity="0">
                                    </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AniT.Surface}" />
                                    <Setter TargetName="SelectionLine" Property="Opacity" Value="1" />
                                    <Setter Property="Foreground" Value="{DynamicResource AniT.Text}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AniT.Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AniT.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource AniT.Focus}" />
            </Style>
            <Style x:Key="AnimeTabs" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource AnimeTabItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" Background="{DynamicResource AniT.Surface}" CornerRadius="{DynamicResource AniT.ControlRadius}">
                                    <TabPanel IsItemsHost="True" Background="Transparent" Margin="8,2,0,0" />
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,14,0,0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EpisodeRow" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AniT.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AniT.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource AniT.Radius}" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AniT.Surface}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AniT.Border}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ArtworkPreviewButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource AniT.Focus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ArtworkSurface" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ArtworkSurface" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="EpisodeCardTemplate">
                <Border Style="{StaticResource EpisodeRow}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Number, StringFormat=Episódio {0}}" Style="{DynamicResource AniT.Caption}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Title}" Style="{DynamicResource AniT.Body}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding VersionSummary}" Style="{DynamicResource AniT.Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Assistir" Style="{DynamicResource AniT.ActionButton}" Tag="{Binding Id}" Click="EpisodePlay_Click" VerticalAlignment="Top" />
                        </Grid>
                        <TextBlock Text="{Binding ProgressLabel}" Style="{DynamicResource AniT.Caption}" Margin="0,16,0,7" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{DynamicResource AniT.Progress}" />
                        <TextBlock Text="SUA AVALIAÇÃO" Style="{DynamicResource AniT.Caption}" Margin="0,16,0,8" TextWrapping="Wrap" />
                        <WrapPanel>
                            <ToggleButton Content="1 · Horrível" Style="{DynamicResource AniT.RatingButton}" Tag="1" IsChecked="{Binding IsRatingOne, Mode=OneWay}" Click="EpisodeRating_Click" Margin="0,0,8,8" AutomationProperties.Name="Avaliar episódio com uma estrela" />
                            <ToggleButton Content="2 · Ruim" Style="{DynamicResource AniT.RatingButton}" Tag="2" IsChecked="{Binding IsRatingTwo, Mode=OneWay}" Click="EpisodeRating_Click" Margin="0,0,8,8" AutomationProperties.Name="Avaliar episódio com duas estrelas" />
                            <ToggleButton Content="3 · OK" Style="{DynamicResource AniT.RatingButton}" Tag="3" IsChecked="{Binding IsRatingThree, Mode=OneWay}" Click="EpisodeRating_Click" Margin="0,0,8,8" AutomationProperties.Name="Avaliar episódio com três estrelas" />
                            <ToggleButton Content="4 · Boa" Style="{DynamicResource AniT.RatingButton}" Tag="4" IsChecked="{Binding IsRatingFour, Mode=OneWay}" Click="EpisodeRating_Click" Margin="0,0,8,8" AutomationProperties.Name="Avaliar episódio com quatro estrelas" />
                            <ToggleButton Content="5 · Excelente" Style="{DynamicResource AniT.RatingButton}" Tag="5" IsChecked="{Binding IsRatingFive, Mode=OneWay}" Click="EpisodeRating_Click" Margin="0,0,8,8" AutomationProperties.Name="Avaliar episódio com cinco estrelas" />
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="{Binding EpisodeNoteActionLabel}" ToolTip="{Binding EpisodeNoteToolTip}" Style="{DynamicResource AniT.SecondaryButton}" Tag="{Binding Id}" Click="EpisodeNote_Click" Margin="0,0,8,8" />
                            <Button Content="{Binding WatchedActionLabel}" Style="{DynamicResource AniT.SecondaryButton}" Tag="{Binding Id}" Click="ToggleWatched_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource AniT.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:CinematicSidebar x:Name="ShellSidebar" Section="Details" UseBackForHome="True" />
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <local:CinematicHeader x:Name="ShellHeader" SearchChanged="SearchBox_TextChanged" SearchSubmitted="SearchBox_KeyDown" HomeRequested="Back_Click" ActionRequested="PlayNext_Click" ActionLabel="Assistir" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel x:Name="DetailsContentHost" SizeChanged="Content_SizeChanged" MaxWidth="2500" Margin="24,16,24,44" HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource AniT.HeaderButton}" HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AniT.Icon.ArrowLeft}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="Voltar" Margin="7,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="HeroBanner" Padding="24" MinHeight="280" Background="{DynamicResource AniT.Surface}" CornerRadius="{DynamicResource AniT.Radius}">
                        <Grid x:Name="DetailsHeroLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="HeroCopy" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,24,0">
                                <TextBlock x:Name="HeroTitleText" Text="{Binding AnimeTitle}" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.TitleSize}" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding EnglishTitleDisplay}" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,15,0,0">
                                    <Border Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="13,6" Margin="0,0,8,7">
                                        <TextBlock Text="Biblioteca local" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" TextWrapping="Wrap" />
                                    </Border>
                                    <Border Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="13,6" Margin="0,0,8,7">
                                        <TextBlock Text="{Binding WatchStateLabel}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" TextWrapping="Wrap" />
                                    </Border>
                                    <Border Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="13,6" Margin="0,0,8,7">
                                        <TextBlock Text="{Binding EpisodeCountLabel}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" TextWrapping="Wrap" />
                                    </Border>
                                </WrapPanel>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding CriticFiveLabel, StringFormat=Nota pública · {0}/5}" Foreground="{DynamicResource AniT.Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AniT.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource ActionButton}" IsEnabled="{Binding CanPlayNext}" Click="PlayNext_Click" MinWidth="188">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource AniT.Icon.Play}" Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource AniT.OnAccent}" />
                                            <TextBlock Text="{Binding PlayNextLabel}" Margin="8,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AniT.OnAccent}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Click="Favorite_Click" ToolTip="{Binding FavoriteToolTip}" Margin="12,0,0,0" MinWidth="126">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource AniT.Icon.Heart}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding FavoriteFill}" Stroke="{Binding FavoriteStroke}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                            <TextBlock Text="{Binding FavoriteLabel}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Click="OrganizeAnime_Click" ToolTip="Adicionar este anime a tags e coleções" Margin="12,0,0,0" MinWidth="126">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource AniT.Icon.Library}" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                            <TextBlock Text="Organizar" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                            <Border x:Name="HeroArtwork" Height="260" Grid.Column="1" SizeChanged="RoundedPanel_SizeChanged" Tag="Artwork" CornerRadius="{DynamicResource AniT.ControlRadius}">
                                <Grid>
                                    <Image Source="{Binding CoverPath}" Stretch="Uniform" Loaded="Cover_Loaded" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Margin="0,18,0,0" x:Name="DetailsBody">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition x:Name="RightRailColumn" Width="320" />
                        </Grid.ColumnDefinitions>
                        <TabControl x:Name="AnimeTabControl" Style="{StaticResource AnimeTabs}">
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource AniT.Icon.Document}" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.7" StrokeLineJoin="Round" />
                                        <TextBlock Text="Sinopse" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </TabItem.Header>
                                <StackPanel>
                                    <Border Style="{StaticResource DetailPanel}" Padding="20" Margin="0,0,0,14">
                                        <Grid x:Name="SynopsisLayout">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="420" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource AniT.Icon.Document}" Stroke="{DynamicResource AniT.Text}" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.8" />
                                                    <TextBlock Text="Sinopse" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Synopsis}" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" FontWeight="Medium" TextWrapping="Wrap" Margin="0,16,0,0" HorizontalAlignment="Stretch" x:Name="SynopsisText" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Height="224" CornerRadius="{DynamicResource AniT.ControlRadius}" Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" ClipToBounds="False" SizeChanged="RoundedPanel_SizeChanged" Tag="14" x:Name="SynopsisArtwork">
                                                <Button Style="{StaticResource ArtworkPreviewButton}" Click="OpenArtworkProjector_Click" ToolTip="Abrir galeria de artes">
                                                    <Grid>
                                                        <Image Source="{Binding SynopsisArtworkPath}" Stretch="UniformToFill" Loaded="Cover_Loaded" />
                                                        <Border VerticalAlignment="Bottom" Background="{DynamicResource AniT.Surface}" Padding="12,9">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="ArtworkCountText" Text="Arte do anime · clique para ampliar" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <Path Grid.Column="1" Data="{StaticResource AniT.Icon.ArrowRight}" Width="13" Height="13" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="9,0,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DockPanel Margin="4,0,2,10">
                                        <TextBlock Text="Episódios" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding EpisodeCountLabel}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <ItemsControl x:Name="SynopsisEpisodeList" ItemsSource="{Binding Episodes}" ItemTemplate="{StaticResource EpisodeCardTemplate}" />
                                </StackPanel>
                            </TabItem>
                            <TabItem x:Name="EpisodesTab">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource AniT.Icon.List}" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                        <TextBlock Text="Episódios" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </TabItem.Header>
                                <StackPanel>
                                    <DockPanel Margin="4,0,2,12">
                                        <StackPanel>
                                            <TextBlock Text="Sua lista local" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Reproduza, avalie e marque seu progresso." Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding EpisodeCountLabel}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <ItemsControl x:Name="EpisodeList" ItemsSource="{Binding Episodes}" ItemTemplate="{StaticResource EpisodeCardTemplate}" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                        <StackPanel x:Name="DetailsRightRail" Grid.Column="2">
                            <Border Background="{DynamicResource AniT.Surface}" Padding="20" CornerRadius="{DynamicResource AniT.Radius}" Margin="0,0,0,12">
                                <TextBlock Text="Cada episódio é uma nova lembrança na sua jornada." Foreground="{DynamicResource AniT.Muted}" TextWrapping="Wrap" />
                            </Border>
                            <Border Style="{StaticResource DetailPanel}" Padding="17" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource AniT.Icon.Star}" Stroke="{DynamicResource AniT.Text}" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.8" />
                                        <TextBlock Text="Nota do AniList" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,7">
                                        <Path Data="{StaticResource AniT.Icon.Star}" Width="23" Height="23" Stretch="Uniform" Fill="{DynamicResource AniT.Text}" Stroke="{DynamicResource AniT.Text}" StrokeThickness="0.7" />
                                        <TextBlock Text="{Binding CriticFiveLabel}" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.TitleSize}" FontWeight="Bold" Margin="8,-2,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="/5" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" VerticalAlignment="Bottom" Margin="4,0,0,8" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CriticScoreLabel, StringFormat=Pontuação pública · {0}}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource AniT.ActionButton}" Click="OpenEpisodeRatings_Click" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource AniT.Icon.Star}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AniT.OnAccent}" />
                                            <TextBlock Text="Dar minha nota" Margin="7,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AniT.OnAccent}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailPanel}" Padding="17">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource AniT.HeaderButton}" Click="EditComment_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource AniT.Icon.Edit}" Width="13" Height="13" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                                <TextBlock Text="Editar" Margin="6,0,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource AniT.Icon.Document}" Stroke="{DynamicResource AniT.Text}" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.8" />
                                            <TextBlock Text="Sua crítica" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Margin="0,13,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <local:ProfileAvatarButton Width="42" Height="42" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Você" Foreground="{DynamicResource AniT.Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RatedEpisodeCountLabel}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Path Data="{StaticResource AniT.Icon.Star}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AniT.Text}" />
                                            <TextBlock Text="{Binding LocalAverageLabel}" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" FontWeight="Bold" Margin="5,0,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding LocalReviewSummary}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="ArtworkProjectorOverlay" Grid.ColumnSpan="2" Panel.ZIndex="200" Background="{DynamicResource AniT.Surface}" Visibility="Collapsed" Focusable="True" MouseLeftButtonDown="ArtworkProjectorBackdrop_Click">
            <Border MaxWidth="1320" MaxHeight="860" Margin="70" Padding="22" CornerRadius="{DynamicResource AniT.ControlRadius}" Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,0,4,17">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AniT.SecondaryButton}" Width="44" Click="CloseArtworkProjector_Click" ToolTip="Fechar galeria" MinHeight="44">
                            <Path Data="{StaticResource AniT.Icon.Close}" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="ArtworkLockButton" DockPanel.Dock="Right" Style="{StaticResource AniT.SecondaryButton}" Click="ToggleArtworkLock_Click" Margin="0,0,12,0" Padding="15,9">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource AniT.Icon.Lock}" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="1.8" />
                                <TextBlock x:Name="ArtworkLockLabel" Text="Bloquear esta arte" Margin="8,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Projetor de artes" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="Use as setas, as miniaturas ou o teclado para navegar." Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Border CornerRadius="{DynamicResource AniT.ControlRadius}" Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" ClipToBounds="False" SizeChanged="RoundedPanel_SizeChanged" Tag="18">
                            <Image x:Name="ProjectorImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Button Style="{StaticResource AniT.SecondaryButton}" Width="44" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" Click="PreviousArtwork_Click" ToolTip="Arte anterior" MinHeight="44">
                            <Path Data="{StaticResource AniT.Icon.ArrowLeft}" Width="21" Height="21" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button Style="{StaticResource AniT.SecondaryButton}" Width="44" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Click="NextArtwork_Click" ToolTip="Próxima arte" MinHeight="44">
                            <Path Data="{StaticResource AniT.Icon.ArrowRight}" Width="21" Height="21" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,15" Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="13,7">
                            <TextBlock x:Name="ProjectorCounterText" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,17,0,0">
                        <ItemsControl ItemsSource="{Binding ArtworkGallery}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ArtworkPreviewButton}" Tag="{Binding Index}" Click="ArtworkThumbnail_Click" Margin="0,0,10,0" ToolTip="{Binding Label}">
                                        <Border Width="132" Height="74" CornerRadius="{DynamicResource AniT.ControlRadius}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1.5" ClipToBounds="False" SizeChanged="RoundedPanel_SizeChanged" Tag="11">
                                            <Image Source="{Binding Path}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Loaded="Cover_Loaded" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>