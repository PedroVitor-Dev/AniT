<Window x:Class="AniT.App.AnimeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AniT.App"
        Title="Página do Anime · AniT"
        Width="1440" Height="900" MinWidth="1060" MinHeight="700"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DetailPanel" TargetType="Border">
                <Setter Property="Background" Value="#E9081D3C"/>
                <Setter Property="BorderBrush" Value="#28679D"/>
                <Setter Property="BorderThickness" Value="1.25"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="Tag" Value="18"/>
                <EventSetter Event="SizeChanged" Handler="RoundedPanel_SizeChanged"/>
            </Style>

            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource HomePrimaryButton}">
                <Setter Property="Padding" Value="21,11"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource HomeOutlineButton}">
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource HomeTopButton}">
                <Setter Property="Background" Value="#15375E"/>
                <Setter Property="Foreground" Value="#CBEAFF"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="FontSize" Value="10"/>
            </Style>

            <Style x:Key="EpisodeReactionButton" TargetType="ToggleButton">
                <Setter Property="Width" Value="48"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ReactionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="3" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="ReactionScale"/></Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ReactionSurface" Property="Background" Value="#173A63"/><Setter TargetName="ReactionSurface" Property="BorderBrush" Value="#4EC9FF"/></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ReactionSurface" Property="Background" Value="#1C4D7D"/><Setter TargetName="ReactionSurface" Property="BorderBrush" Value="#89E8FF"/><Setter TargetName="ReactionSurface" Property="BorderThickness" Value="2"/><Setter TargetName="ReactionSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#35C7FF" BlurRadius="16" ShadowDepth="0" Opacity="0.72"/></Setter.Value></Setter></Trigger>
                                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ReactionScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.13"/><DoubleAnimation Storyboard.TargetName="ReactionScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.13"/></Storyboard></BeginStoryboard></EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ReactionScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="ReactionScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AnimeTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="#B2C9E6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="22,14"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                </Border>
                                <Border x:Name="SelectionLine" Height="3" CornerRadius="2" Background="#5CD8FF" VerticalAlignment="Bottom" Margin="12,0" Opacity="0">
                                    <Border.Effect><DropShadowEffect Color="#28B9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/></Border.Effect>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#173E69"/><Setter TargetName="SelectionLine" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#8DE7FF"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#142F52"/><Setter Property="Foreground" Value="White"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AnimeTabs" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource AnimeTabItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border BorderBrush="#285F92" BorderThickness="1" Background="#D9081D3C" CornerRadius="16">
                                    <TabPanel IsItemsHost="True" Background="Transparent" Margin="8,2,0,0"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,14,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EpisodeRow" TargetType="Border">
                <Setter Property="Background" Value="#D90A1F40"/>
                <Setter Property="BorderBrush" Value="#285F92"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="13"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#ED10315B"/><Setter Property="BorderBrush" Value="#4EC9FF"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#168BFF" BlurRadius="16" ShadowDepth="1" Opacity="0.25"/></Setter.Value></Setter></Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EpisodePlayButton" TargetType="Button">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#E00A2A51"/>
                <Setter Property="BorderBrush" Value="#B8F0FF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="Reproduzir episódio"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PlaySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PlaySurface" Property="Background" Value="#FF168DE0"/><Setter TargetName="PlaySurface" Property="BorderBrush" Value="White"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="PlaySurface" Property="Opacity" Value="0.72"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ArtworkPreviewButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ArtworkSurface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArtworkSurface" Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>

            <DataTemplate x:Key="EpisodeCardTemplate">
                <Border Style="{StaticResource EpisodeRow}" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="126"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="326"/><ColumnDefinition Width="142"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="116" Height="78" CornerRadius="11" Background="#0A2346" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="11">
                            <Grid><Image Source="{Binding DataContext.CoverPath, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/><Rectangle Fill="#4203152D"/><Button Style="{StaticResource EpisodePlayButton}" HorizontalAlignment="Center" VerticalAlignment="Center" Tag="{Binding Id}" Click="EpisodePlay_Click"><Viewbox Width="15" Height="15"><Path Data="{StaticResource AniT.Icon.Play}" Fill="White" Stretch="Uniform"/></Viewbox></Button></Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#EAF6FF" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Margin="10,0,14,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding ProgressLabel}" Foreground="#C7DDF4" FontSize="9" Margin="0,6,0,0"/><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Height="6" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="7,0">
                            <TextBlock Text="SUA NOTA" Foreground="#79BBDD" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="61" Height="78" Tag="1" ToolTip="Não curti" IsChecked="{Binding IsRatingOne, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/angry-sf.png" Width="49" Height="53" Stretch="Uniform"/><TextBlock Text="Horrível" Foreground="#C8DDF3" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="61" Height="78" Tag="2" ToolTip="Fraquinho" IsChecked="{Binding IsRatingTwo, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/sad-sf.png" Width="49" Height="53" Stretch="Uniform"/><TextBlock Text="Ruim" Foreground="#C8DDF3" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="61" Height="78" Tag="3" ToolTip="Legalzinho" IsChecked="{Binding IsRatingThree, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/boring-sf.png" Width="49" Height="53" Stretch="Uniform"/><TextBlock Text="OK" Foreground="#C8DDF3" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="61" Height="78" Tag="4" ToolTip="Muito bom" IsChecked="{Binding IsRatingFour, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/happy2-sf.png" Width="49" Height="53" Stretch="Uniform"/><TextBlock Text="Boa" Foreground="#C8DDF3" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="61" Height="78" Tag="5" ToolTip="Obra-prima" IsChecked="{Binding IsRatingFive, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/happy-sf.png" Width="49" Height="53" Stretch="Uniform"/><TextBlock Text="Excelente" Foreground="#C8DDF3" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="7,0,0,0">
                            <Button Style="{StaticResource CompactButton}" ToolTip="{Binding EpisodeNoteToolTip}" Tag="{Binding Id}" Click="EpisodeNote_Click" Padding="8,7" Margin="0,0,0,7"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Note}" Width="13" Height="13" Stretch="Uniform" Fill="Transparent" Stroke="#8DE7FF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="{Binding EpisodeNoteActionLabel}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource CompactButton}" Tag="{Binding Id}" Click="ToggleWatched_Click" Padding="8,7"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Eye}" Width="13" Height="13" Stretch="Uniform" Fill="Transparent" Stroke="#8DE7FF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="{Binding WatchedActionLabel}" Margin="6,0,0,0" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="EpisodeCardLargeTemplate">
                <Border Style="{StaticResource EpisodeRow}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="178"/><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="142"/><ColumnDefinition Width="462"/><ColumnDefinition Width="158"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="160" Height="100" CornerRadius="13" Background="#0A2346" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="13">
                            <Grid><Image Source="{Binding DataContext.CoverPath, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/><Rectangle Fill="#4203152D"/><Button Style="{StaticResource EpisodePlayButton}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Tag="{Binding Id}" Click="EpisodePlay_Click"><Viewbox Width="17" Height="17"><Path Data="{StaticResource AniT.Icon.Play}" Fill="White" Stretch="Uniform"/></Viewbox></Button></Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#EAF6FF" FontSize="31" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Margin="13,0,18,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VersionSummary}" Foreground="#8EB5DE" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding ProgressLabel}" Foreground="#C7DDF4" FontSize="11" HorizontalAlignment="Center"/><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Height="8" Margin="0,10,0,0"/></StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="9,0">
                            <TextBlock Text="SUA NOTA" Foreground="#79BBDD" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="84" Height="98" Tag="1" ToolTip="Não curti" IsChecked="{Binding IsRatingOne, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/angry-sf.png" Width="64" Height="68" Stretch="Uniform"/><TextBlock Text="Horrível" Foreground="#C8DDF3" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="84" Height="98" Tag="2" ToolTip="Fraquinho" IsChecked="{Binding IsRatingTwo, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/sad-sf.png" Width="64" Height="68" Stretch="Uniform"/><TextBlock Text="Ruim" Foreground="#C8DDF3" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="84" Height="98" Tag="3" ToolTip="Legalzinho" IsChecked="{Binding IsRatingThree, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/boring-sf.png" Width="64" Height="68" Stretch="Uniform"/><TextBlock Text="OK" Foreground="#C8DDF3" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="84" Height="98" Tag="4" ToolTip="Muito bom" IsChecked="{Binding IsRatingFour, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/happy2-sf.png" Width="64" Height="68" Stretch="Uniform"/><TextBlock Text="Boa" Foreground="#C8DDF3" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                                <ToggleButton Style="{StaticResource EpisodeReactionButton}" Width="84" Height="98" Tag="5" ToolTip="Obra-prima" IsChecked="{Binding IsRatingFive, Mode=OneWay}" Click="EpisodeRating_Click"><StackPanel><Image Source="Assets/happy-sf.png" Width="64" Height="68" Stretch="Uniform"/><TextBlock Text="Excelente" Foreground="#C8DDF3" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="9,0,0,0">
                            <Button Style="{StaticResource CompactButton}" ToolTip="{Binding EpisodeNoteToolTip}" Tag="{Binding Id}" Click="EpisodeNote_Click" Padding="10,9" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Note}" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#8DE7FF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="{Binding EpisodeNoteActionLabel}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource CompactButton}" Tag="{Binding Id}" Click="ToggleWatched_Click" Padding="10,9"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Eye}" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#8DE7FF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="{Binding WatchedActionLabel}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.70,0.04" Center="0.70,0.04" RadiusX="0.96" RadiusY="1.08"><GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.44"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{DynamicResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"><Border.Background><ImageBrush ImageSource="{local:ComfortableImage Path=Assets/logo-fire.png, DecodePixelWidth=320}" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeNavButton}" Click="Back_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Home}" Label="Início"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Explore_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Explore}" Label="Explorar"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Library_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Library}" Label="Biblioteca"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Calendar_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Calendar}" Label="Calendário"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="History_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.History}" Label="Histórico"/></Button>
                    <Button Style="{StaticResource HomeActiveNavButton}"><local:NavItemContent IconData="{StaticResource AniT.Icon.Anime}" Label="Página do Anime"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Profile_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Profile}" Label="Perfil"/></Button>
                    <local:SystemSettingsNavButton/>
                </StackPanel>
                <Image Grid.Row="2" Source="{local:PageMascot Page=Anime, Fallback=Assets/ghost_menu.png}" Style="{StaticResource HomeSidebarMascot}"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1">
                <Grid MaxWidth="2500" Margin="28,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource AniT.Icon.Search}" Width="19" Height="19" Stretch="Uniform" Fill="Transparent" Stroke="#A9C7EC" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/></Grid></Grid></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource HomeTopButton}" Click="Back_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Home}" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#BFD8F3" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="Início" Margin="6,0,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource HomeTopButton}" Click="PlayNext_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Play}" Width="14" Height="14" Stretch="Uniform" Fill="#BFD8F3"/><TextBlock Text="Assistir" Margin="6,0,0,0"/></StackPanel></Button>
                        <Button x:Name="LibraryTopButton" Style="{StaticResource HomeTopButton}" Click="Library_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Library}" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#BFD8F3" StrokeThickness="1.7" StrokeLineJoin="Round"/><TextBlock Text="Biblioteca" Margin="6,0,0,0"/></StackPanel></Button>
                        <Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/><local:ProfileAvatarButton/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel x:Name="DetailsContentHost" MaxWidth="2500" Margin="24,16,24,44" HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource HomeTopButton}" HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.ArrowLeft}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="#BFD8F3" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><TextBlock Text="Voltar" Margin="7,0,0,0"/></StackPanel></Button>

                    <Border x:Name="HeroBanner" Height="322" Background="#43C8FF" CornerRadius="20" Padding="2" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="20">
                        <Border.Effect><DropShadowEffect Color="#168BFF" BlurRadius="25" ShadowDepth="0" Opacity="0.30"/></Border.Effect>
                        <Border CornerRadius="18" Background="#071B38" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="18">
                            <Grid>
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" Opacity="0.48"><Image.Effect><BlurEffect Radius="13"/></Image.Effect></Image>
                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FC05152E" Offset="0"/><GradientStop Color="#F0071A38" Offset="0.42"/><GradientStop Color="#A5081B3A" Offset="0.68"/><GradientStop Color="#4503152D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <Border x:Name="HeroArtwork" Width="410" HorizontalAlignment="Right" Margin="0,0,30,0" Background="#06172E" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="16">
                                    <Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill" Opacity="0.94"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F7071936" Offset="0"/><GradientStop Color="#50071936" Offset="0.28"/><GradientStop Color="#00071936" Offset="0.72"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Grid>
                                </Border>
                                <StackPanel x:Name="HeroCopy" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,18,0,18" MaxWidth="720">
                                    <TextBlock x:Name="HeroTitleText" Text="{Binding AnimeTitle}" Foreground="White" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="None"/>
                                    <TextBlock Text="{Binding EnglishTitleDisplay}" Foreground="#C7DCF4" FontSize="16" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,15,0,0"><Border Background="#8A12345A" BorderBrush="#3B83B8" BorderThickness="1" CornerRadius="12" Padding="13,6" Margin="0,0,8,7"><TextBlock Text="Biblioteca local" Foreground="#D9EFFF" FontSize="11"/></Border><Border Background="#8A12345A" BorderBrush="#3B83B8" BorderThickness="1" CornerRadius="12" Padding="13,6" Margin="0,0,8,7"><TextBlock Text="{Binding WatchStateLabel}" Foreground="#72E0BE" FontSize="11"/></Border><Border Background="#8A12345A" BorderBrush="#3B83B8" BorderThickness="1" CornerRadius="12" Padding="13,6" Margin="0,0,8,7"><TextBlock Text="{Binding EpisodeCountLabel}" Foreground="#D9EFFF" FontSize="11"/></Border></WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Path Data="{StaticResource AniT.Icon.Star}" Width="18" Height="18" Stretch="Uniform" Fill="#FFD45D" Stroke="#FFE08A" StrokeThickness="0.7" VerticalAlignment="Center"/><TextBlock Text="{Binding CriticFiveLabel}" Foreground="#FFF0B0" FontSize="20" FontWeight="Bold" Margin="7,0,0,0"/><TextBlock Text="Nota pública via AniList" Foreground="#A7C1DF" FontSize="11" VerticalAlignment="Center" Margin="11,0,0,0"/><Border Width="1" Height="20" Background="#3A628A" Margin="14,0"/><TextBlock Text="{Binding Summary}" Foreground="#CAE0F5" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Style="{StaticResource ActionButton}" IsEnabled="{Binding CanPlayNext}" Click="PlayNext_Click" MinWidth="188"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Play}" Width="15" Height="15" Stretch="Uniform" Fill="White"/><TextBlock Text="{Binding PlayNextLabel}" Margin="8,0,0,0"/></StackPanel></Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="Favorite_Click" ToolTip="{Binding FavoriteToolTip}" Margin="12,0,0,0" MinWidth="126"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Heart}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding FavoriteFill}" Stroke="{Binding FavoriteStroke}" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="{Binding FavoriteLabel}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="OrganizeAnime_Click" ToolTip="Adicionar este anime a tags e coleções" Margin="12,0,0,0" MinWidth="126"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Library}" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" Stroke="#D2F0FF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="Organizar" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition x:Name="RightRailColumn" Width="320"/></Grid.ColumnDefinitions>

                        <TabControl x:Name="AnimeTabControl" Style="{StaticResource AnimeTabs}">
                            <TabItem>
                                <TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Document}" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.7" StrokeLineJoin="Round"/><TextBlock Text="Sinopse" Margin="8,0,0,0"/></StackPanel></TabItem.Header>
                                <StackPanel>
                                    <Border Style="{StaticResource DetailPanel}" Padding="20" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal"><local:IconTile IconData="{StaticResource AniT.Icon.Document}" Foreground="#7BE1FF" Width="32" Height="32"/><TextBlock Text="Sinopse" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                <TextBlock Text="{Binding Synopsis}" Foreground="#D7E9FA" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" LineHeight="24" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Height="224" CornerRadius="14" Background="#06172E" BorderBrush="#3979AA" BorderThickness="1" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="14">
                                                <Button Style="{StaticResource ArtworkPreviewButton}" Click="OpenArtworkProjector_Click" ToolTip="Abrir galeria de artes">
                                                    <Grid>
                                                        <Image Source="{Binding SynopsisArtworkPath}" Stretch="UniformToFill"/>
                                                        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00112643" Offset="0.48"/><GradientStop Color="#D9051833" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                                        <Border VerticalAlignment="Bottom" Background="#D5071C39" Padding="12,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ArtworkCountText" Text="Arte do anime · clique para ampliar" Foreground="#D7EDFF" FontSize="10" FontWeight="SemiBold"/><Path Grid.Column="1" Data="{StaticResource AniT.Icon.ArrowRight}" Width="13" Height="13" Stretch="Uniform" Fill="Transparent" Stroke="#8DE7FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="9,0,0,0"/></Grid></Border>
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DockPanel Margin="4,0,2,10"><TextBlock Text="Episódios" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding EpisodeCountLabel}" Foreground="#9FBBDD" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                                    <ItemsControl x:Name="SynopsisEpisodeList" ItemsSource="{Binding Episodes}" ItemTemplate="{StaticResource EpisodeCardTemplate}"/>
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="EpisodesTab">
                                <TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.List}" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.8" StrokeStartLineCap="Round"/><TextBlock Text="Episódios" Margin="8,0,0,0"/></StackPanel></TabItem.Header>
                                <StackPanel><DockPanel Margin="4,0,2,12"><StackPanel><TextBlock Text="Sua lista local" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Reproduza, avalie e marque seu progresso." Foreground="#8FACCE" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Text="{Binding EpisodeCountLabel}" Foreground="#9FBBDD" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></DockPanel><ItemsControl x:Name="EpisodeList" ItemsSource="{Binding Episodes}" ItemTemplate="{StaticResource EpisodeCardTemplate}"/></StackPanel>
                            </TabItem>
                        </TabControl>

                        <StackPanel x:Name="DetailsRightRail" Grid.Column="2">
                            <Border Background="#43C8FF" CornerRadius="17" Padding="2" Margin="0,0,0,12" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="17"><Border Background="#0A2347" CornerRadius="15" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="15"><Grid Height="174"><Image Source="Assets/ghost_background.png" Stretch="UniformToFill" Opacity="0.26"/><Image Source="Assets/happy-sf.png" Width="135" Height="150" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,-7"/><StackPanel Margin="134,24,15,15"><TextBlock Text="Baki-Pi diz:" Foreground="White" FontSize="17" FontWeight="Bold"/><TextBlock Text="Cada episódio é uma nova lembrança na sua jornada. ✦" Foreground="#C8DDF3" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"/></StackPanel></Grid></Border></Border>

                            <Border Style="{StaticResource DetailPanel}" Padding="17" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><local:IconTile IconData="{StaticResource AniT.Icon.Star}" Foreground="#8CE7FF" Width="29" Height="29"/><TextBlock Text="Nota do AniList" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,7"><Path Data="{StaticResource AniT.Icon.Star}" Width="23" Height="23" Stretch="Uniform" Fill="#FFD45D" Stroke="#FFE08A" StrokeThickness="0.7"/><TextBlock Text="{Binding CriticFiveLabel}" Foreground="White" FontSize="35" FontWeight="Bold" Margin="8,-2,0,0"/><TextBlock Text="/5" Foreground="#9CB8D7" FontSize="15" VerticalAlignment="Bottom" Margin="4,0,0,8"/></StackPanel>
                                    <TextBlock Text="{Binding CriticScoreLabel, StringFormat=Pontuação pública · {0}}" Foreground="#87A8CC" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <Button Style="{StaticResource HomePrimaryButton}" Click="OpenEpisodeRatings_Click" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Star}" Width="14" Height="14" Stretch="Uniform" Fill="White"/><TextBlock Text="Dar minha nota" Margin="7,0,0,0"/></StackPanel></Button>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DetailPanel}" Padding="17">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Click="EditComment_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Edit}" Width="13" Height="13" Stretch="Uniform" Fill="Transparent" Stroke="#9BDFFF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="Editar" Margin="6,0,0,0"/></StackPanel></Button>
                                        <StackPanel Orientation="Horizontal"><local:IconTile IconData="{StaticResource AniT.Icon.Document}" Foreground="#8DE5FF" Width="29" Height="29"/><TextBlock Text="Sua crítica" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    </DockPanel>
                                    <Grid Margin="0,13,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><local:ProfileAvatarButton Width="42" Height="42"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Você" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding RatedEpisodeCountLabel}" Foreground="#8EAED1" FontSize="9" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Path Data="{StaticResource AniT.Icon.Star}" Width="14" Height="14" Stretch="Uniform" Fill="#FFD45D"/><TextBlock Text="{Binding LocalAverageLabel}" Foreground="#FFF0B0" FontSize="16" FontWeight="Bold" Margin="5,0,0,0"/></StackPanel></Grid>
                                    <TextBlock Text="{Binding LocalReviewSummary}" Foreground="#C4D8EE" FontSize="11" TextWrapping="Wrap" LineHeight="17" MaxHeight="112"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ArtworkProjectorOverlay" Grid.ColumnSpan="2" Panel.ZIndex="200" Background="#E8020A1A" Visibility="Collapsed" Focusable="True" MouseLeftButtonDown="ArtworkProjectorBackdrop_Click">
            <Border MaxWidth="1320" MaxHeight="860" Margin="70" Padding="22" CornerRadius="24" Background="#FA071B38" BorderBrush="#55D2FF" BorderThickness="2">
                <Border.Effect><DropShadowEffect Color="#159CFF" BlurRadius="38" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="4,0,4,17">
                        <Button DockPanel.Dock="Right" Style="{StaticResource EpisodePlayButton}" Width="42" Height="42" Click="CloseArtworkProjector_Click" ToolTip="Fechar galeria"><Path Data="{StaticResource AniT.Icon.Close}" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                        <Button x:Name="ArtworkLockButton" DockPanel.Dock="Right" Style="{StaticResource HomeOutlineButton}" Click="ToggleArtworkLock_Click" Margin="0,0,12,0" Padding="15,9"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Lock}" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#8DE7FF" StrokeThickness="1.8"/><TextBlock x:Name="ArtworkLockLabel" Text="Bloquear esta arte" Margin="8,0,0,0"/></StackPanel></Button>
                        <StackPanel><TextBlock Text="Projetor de artes" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="Use as setas, as miniaturas ou o teclado para navegar." Foreground="#9DBDDD" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Border CornerRadius="18" Background="#020A18" BorderBrush="#2C6C9C" BorderThickness="1" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="18">
                            <Image x:Name="ProjectorImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Button Style="{StaticResource EpisodePlayButton}" Width="52" Height="52" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" Click="PreviousArtwork_Click" ToolTip="Arte anterior"><Path Data="{StaticResource AniT.Icon.ArrowLeft}" Width="21" Height="21" Stretch="Uniform" Fill="Transparent" Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                        <Button Style="{StaticResource EpisodePlayButton}" Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Click="NextArtwork_Click" ToolTip="Próxima arte"><Path Data="{StaticResource AniT.Icon.ArrowRight}" Width="21" Height="21" Stretch="Uniform" Fill="Transparent" Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,15" Background="#D1071B37" BorderBrush="#3E81AF" BorderThickness="1" CornerRadius="13" Padding="13,7"><TextBlock x:Name="ProjectorCounterText" Foreground="#DDF5FF" FontSize="11" FontWeight="SemiBold"/></Border>
                    </Grid>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,17,0,0">
                        <ItemsControl ItemsSource="{Binding ArtworkGallery}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ArtworkPreviewButton}" Tag="{Binding Index}" Click="ArtworkThumbnail_Click" Margin="0,0,10,0" ToolTip="{Binding Label}"><Border Width="132" Height="74" CornerRadius="11" BorderBrush="#3979AA" BorderThickness="1.5" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="11"><Image Source="{Binding Path}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
