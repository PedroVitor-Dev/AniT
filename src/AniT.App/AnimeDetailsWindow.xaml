<Window x:Class="AniT.App.AnimeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Página do Anime · AniT"
        Width="1140" Height="800" MinWidth="720" MinHeight="560"
        Background="#050A15" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Activated="Window_Activated">
    <Window.Resources>
        <Style x:Key="EpisodeRow" TargetType="Border">
            <Setter Property="Background" Value="#D9101B2F"/>
            <Setter Property="BorderBrush" Value="#263F62"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="EpisodeRow_Click"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource BrandButton}">
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#173556"/>
            <Setter Property="Foreground" Value="#9FD8FF"/>
        </Style>
        <Style x:Key="AnimeTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#85A2C8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#173E69"/><Setter Property="Foreground" Value="#71D3FF"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#142B49"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AnimeTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AnimeTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReviewTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#C90A1930"/>
            <Setter Property="Foreground" Value="#EAF4FF"/>
            <Setter Property="BorderBrush" Value="#315983"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="CaretBrush" Value="#58BFFF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ReactionCard" TargetType="RadioButton">
            <Setter Property="Width" Value="118"/>
            <Setter Property="Height" Value="166"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Background" Value="#B90D1D35"/>
            <Setter Property="BorderBrush" Value="#315983"/>
            <Setter Property="Foreground" Value="#DCEBFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ReactionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ReactionBorder" Property="Background" Value="#153257"/><Setter TargetName="ReactionBorder" Property="BorderBrush" Value="#3EAFFF"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ReactionBorder" Property="Background" Value="#183C66"/>
                                <Setter TargetName="ReactionBorder" Property="BorderBrush" Value="#77D7FF"/>
                                <Setter TargetName="ReactionBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="ReactionBorder" Property="Effect"><Setter.Value><DropShadowEffect Color="#24A8FF" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#7EA4CF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="258"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#0E1D34" BorderBrush="#294B70" BorderThickness="0,0,0,1" ClipToBounds="True">
            <Grid>
                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" Opacity="0.22"><Image.Effect><BlurEffect Radius="22"/></Image.Effect></Image>
                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F5081223" Offset="0"/><GradientStop Color="#E9081830" Offset="0.58"/><GradientStop Color="#D20A2344" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                <Image Source="Assets/normal-sf.png" Width="245" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,22,92,-50" Opacity="0.08" IsHitTestVisible="False"/>
                <Grid Margin="38,28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                    <Border Width="145" Height="198" CornerRadius="17" Background="#142A48" BorderBrush="#3D78A9" BorderThickness="1">
                        <Grid ClipToBounds="True"><Image Source="Assets/normal-sf.png" Width="105" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-15,-18" Opacity="0.18"/><TextBlock Text="{Binding Initial}" Foreground="#53B6FF" FontSize="70" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle RadiusX="16" RadiusY="16"><Rectangle.Fill><ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle></Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="28,8,26,0">
                        <TextBlock Text="{Binding AnimeTitle}" Foreground="White" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="78"/>
                        <TextBlock Text="{Binding EnglishTitleDisplay}" Foreground="#86A8D2" FontSize="14" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#B1CBE9" FontSize="14" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Style="{StaticResource ActionButton}" Content="{Binding PlayNextLabel}" IsEnabled="{Binding CanPlayNext}" Click="PlayNext_Click"/><TextBlock Text="Progresso salvo localmente" Foreground="#7F9EC4" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#D308172C" BorderBrush="#3478AA" BorderThickness="1" CornerRadius="16" Padding="14" VerticalAlignment="Top">
                        <StackPanel TextBlock.TextAlignment="Center"><TextBlock Text="NOTA DA CRÍTICA" Foreground="#7195C0" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding CriticScoreLabel}" Foreground="#70D0FF" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="via AniList" Foreground="#5E789B" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <TabControl x:Name="AnimeTabControl" Grid.Row="1" Style="{StaticResource AnimeTabs}" Margin="38,22,38,30">
            <TabItem Header="Episódios">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel><TextBlock Text="Sua lista local" Foreground="White" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left"/><TextBlock Text="{Binding EpisodeCountLabel}" Foreground="#8FA9CD" FontSize="13" VerticalAlignment="Bottom" DockPanel.Dock="Right"/></DockPanel>
                    <Border Grid.Row="1" Background="#10192A" BorderBrush="#2A405E" BorderThickness="1" CornerRadius="14" Margin="0,15,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Episodes}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource EpisodeRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="84"/><ColumnDefinition Width="84"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions><Border Width="35" Height="35" CornerRadius="18" Background="#1B3355" VerticalAlignment="Center"><TextBlock Text="{Binding Number}" Foreground="#D9E9FF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding ProgressLabel}" Foreground="#91ABD0" FontSize="11"/><TextBlock Text="  •  " Foreground="#476481" FontSize="11"/><TextBlock Text="{Binding VersionSummary}" Foreground="#63BDEC" FontSize="11"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Arquivos" Tag="{Binding Id}" Click="EpisodeFiles_Click" Margin="4,0" VerticalAlignment="Center"/><Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Avaliar" Tag="{Binding Id}" Click="ReviewEpisode_Click" Margin="4,0" VerticalAlignment="Center"/><Button Grid.Column="5" Style="{StaticResource ActionButton}" Content="{Binding WatchedActionLabel}" Tag="{Binding Id}" Click="ToggleWatched_Click" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Sinopse">
                <Border Background="#10192A" BorderBrush="#2A405E" BorderThickness="1" CornerRadius="16" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Sobre a obra" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding Synopsis}" Foreground="#B5C9E4" FontSize="14" TextWrapping="Wrap" LineHeight="23" Margin="0,16,0,0"/><Border Background="#0B1527" BorderBrush="#243D5D" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,24,0,0" HorizontalAlignment="Left"><TextBlock Text="Sinopse e nota pública fornecidas pela AniList e mantidas no seu computador." Foreground="#718DB1" FontSize="11"/></Border></StackPanel></ScrollViewer></Border>
            </TabItem>
            <TabItem x:Name="ReviewTab" Header="Avaliar episódio">
                <Border Background="#B90A1528" BorderBrush="#315983" BorderThickness="1" CornerRadius="18" Padding="26">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <ComboBox x:Name="EpisodeReviewSelector" DockPanel.Dock="Right" Width="270" Height="38" Margin="18,0,0,0" ItemsSource="{Binding Episodes}" DisplayMemberPath="ReviewDisplay" SelectionChanged="EpisodeReviewSelector_SelectionChanged" Background="#112542" Foreground="White" BorderBrush="#3474A8" Padding="10,6"/>
                                <StackPanel>
                                    <TextBlock Text="✦  Avaliar episódio" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ReviewEpisodeTitleText" Text="Escolha um episódio" Foreground="#9FC0E5" FontSize="14" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="O que você achou deste episódio?" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <WrapPanel>
                                    <RadioButton x:Name="RatingOne" GroupName="AnimeRating" Tag="1" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/angry-sf.png" Width="95" Height="105" Stretch="Uniform"/><TextBlock Text="Não curti" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="RatingTwo" GroupName="AnimeRating" Tag="2" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/sad-sf.png" Width="95" Height="105" Stretch="Uniform"/><TextBlock Text="Fraquinho" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="RatingThree" GroupName="AnimeRating" Tag="3" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/boring-sf.png" Width="95" Height="105" Stretch="Uniform"/><TextBlock Text="Legalzinho" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="RatingFour" GroupName="AnimeRating" Tag="4" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/happy2-sf.png" Width="95" Height="105" Stretch="Uniform"/><TextBlock Text="Muito bom!" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="RatingFive" GroupName="AnimeRating" Tag="5" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/happy-sf.png" Width="95" Height="105" Stretch="Uniform"/><TextBlock Text="Obra-prima!" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                    </WrapPanel>
                                    <TextBlock Text="●  COMENTÁRIO (OPCIONAL)" Foreground="#9CC6EC" FontSize="11" FontWeight="Bold" Margin="0,12,0,9"/>
                                    <TextBox x:Name="ReviewTextBox" Style="{StaticResource ReviewTextBox}" Height="105" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" ToolTip="Conte o que achou deste episódio"/>
                                    <DockPanel Margin="0,11,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Salvar comentário" Click="SaveComment_Click" Padding="14,7"/>
                                        <TextBlock x:Name="ReviewStatusText" Foreground="#6CDEB2" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <Border Height="226" Background="#D20A1830" BorderBrush="#3479AD" BorderThickness="1" CornerRadius="16">
                                        <Grid ClipToBounds="True"><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle VerticalAlignment="Bottom" Height="76"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00102033" Offset="0"/><GradientStop Color="#F2071224" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel VerticalAlignment="Bottom" Margin="12"><TextBlock x:Name="ReviewEpisodeNumberText" Foreground="White" FontWeight="SemiBold"/><ProgressBar x:Name="ReviewEpisodeProgress" Minimum="0" Maximum="100" Height="5" Margin="0,7,0,0" Background="#31455F" Foreground="#66CCFF" BorderThickness="0"/><TextBlock x:Name="ReviewEpisodeProgressText" Foreground="#C5D9F0" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid>
                                    </Border>
                                    <Border Height="118" Margin="0,12,0,0" Background="#D20A1830" BorderBrush="#3479AD" BorderThickness="1" CornerRadius="16">
                                        <Grid ClipToBounds="True"><Image Source="Assets/normal-sf.png" Width="105" Opacity="0.08" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-28"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="★  SUA NOTA" Foreground="#80A8D2" FontSize="10" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0"><TextBlock x:Name="RatingValueText" Text="—" Foreground="#76D4FF" FontSize="34" FontWeight="Bold"/><TextBlock Text="/5" Foreground="#8FA9CD" FontSize="17" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel><Button Style="{StaticResource GhostButton}" Content="Limpar" Click="ClearRating_Click" Margin="0,1,0,0"/></StackPanel></Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
