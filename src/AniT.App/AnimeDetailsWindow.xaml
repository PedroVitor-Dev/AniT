<Window x:Class="AniT.App.AnimeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Página do Anime · AniT"
        Width="1440" Height="900" MinWidth="1060" MinHeight="700"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DetailPanel" TargetType="Border">
                <Setter Property="Background" Value="#E9081D3C"/>
                <Setter Property="BorderBrush" Value="#28679D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="17"/>
            </Style>

            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource HomePrimaryButton}">
                <Setter Property="Padding" Value="21,11"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource HomeOutlineButton}">
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource HomeTopButton}">
                <Setter Property="Background" Value="#15375E"/>
                <Setter Property="Foreground" Value="#CBEAFF"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="FontSize" Value="10"/>
            </Style>

            <Style x:Key="AnimeTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="#B2C9E6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="22,14"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                </Border>
                                <Border x:Name="SelectionLine" Height="3" CornerRadius="2" Background="#5CD8FF" VerticalAlignment="Bottom" Margin="12,0" Opacity="0">
                                    <Border.Effect><DropShadowEffect Color="#28B9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/></Border.Effect>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#173E69"/><Setter TargetName="SelectionLine" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#8DE7FF"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#142F52"/><Setter Property="Foreground" Value="White"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AnimeTabs" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource AnimeTabItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border BorderBrush="#204F7D" BorderThickness="0,0,0,1" Background="#9A061831" CornerRadius="16,16,0,0">
                                    <TabPanel IsItemsHost="True" Background="Transparent" Margin="8,2,0,0"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,14,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EpisodeRow" TargetType="Border">
                <Setter Property="Background" Value="#D90A1F40"/>
                <Setter Property="BorderBrush" Value="#285F92"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="13"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <EventSetter Event="MouseLeftButtonUp" Handler="EpisodeRow_Click"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#ED10315B"/><Setter Property="BorderBrush" Value="#4EC9FF"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#168BFF" BlurRadius="16" ShadowDepth="1" Opacity="0.25"/></Setter.Value></Setter></Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="EpisodeCardTemplate">
                <Border Style="{StaticResource EpisodeRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="116"/><ColumnDefinition Width="82"/><ColumnDefinition Width="104"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="110" Height="68" CornerRadius="10" Background="#0A2346" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="10">
                            <Grid><Image Source="{Binding DataContext.CoverPath, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/><Rectangle Fill="#4203152D"/><Border Width="34" Height="34" CornerRadius="17" Background="#D90A2A51" BorderBrush="#B8F0FF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="▶" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#EAF6FF" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Margin="8,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VersionSummary}" Foreground="#8EB5DE" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0"><TextBlock Text="{Binding ProgressLabel}" Foreground="#C7DDF4" FontSize="10" HorizontalAlignment="Center"/><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Margin="0,8,0,0"/></StackPanel>
                        <Button Grid.Column="4" Style="{StaticResource CompactButton}" Content="{Binding RatingLabel}" Tag="{Binding Id}" Click="ReviewEpisode_Click" Margin="4,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="4,0"><Button Style="{StaticResource CompactButton}" Content="Arquivos" Tag="{Binding Id}" Click="EpisodeFiles_Click" Margin="0,0,0,4"/><Button Style="{StaticResource CompactButton}" Content="{Binding WatchedActionLabel}" Tag="{Binding Id}" Click="ToggleWatched_Click"/></StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <Style x:Key="ReviewTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#D60A1D3A"/>
                <Setter Property="Foreground" Value="#F0F7FF"/>
                <Setter Property="BorderBrush" Value="#3674A8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="CaretBrush" Value="#58D5FF"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="ReactionCard" TargetType="RadioButton">
                <Setter Property="Width" Value="106"/><Setter Property="Height" Value="145"/><Setter Property="Margin" Value="0,0,9,10"/>
                <Setter Property="Background" Value="#D00B1F3F"/><Setter Property="BorderBrush" Value="#315F91"/><Setter Property="Foreground" Value="#DCEBFF"/>
                <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="ReactionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="7" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="ReactionScale"/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ReactionBorder" Property="Background" Value="#15375F"/><Setter TargetName="ReactionBorder" Property="BorderBrush" Value="#54D2FF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ReactionBorder" Property="Background" Value="#184574"/><Setter TargetName="ReactionBorder" Property="BorderBrush" Value="#8AE9FF"/><Setter TargetName="ReactionBorder" Property="BorderThickness" Value="2"/><Setter TargetName="ReactionBorder" Property="Effect"><Setter.Value><DropShadowEffect Color="#24B8FF" BlurRadius="22" ShadowDepth="0" Opacity="0.72"/></Setter.Value></Setter></Trigger><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ReactionScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.14"/><DoubleAnimation Storyboard.TargetName="ReactionScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ReactionScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="ReactionScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></EventTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource HomeTopButton}">
                <Setter Property="Foreground" Value="#8CB6DE"/><Setter Property="Padding" Value="7,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.70,0.04" Center="0.70,0.04" RadiusX="0.96" RadiusY="1.08"><GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.44"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"><Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="⌂    Início" Click="Back_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="◉    Explorar" Click="Explore_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="▱    Biblioteca" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="▣    Calendário"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="◷    Histórico" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeActiveNavButton}" Content="☆    Página do Anime"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="♙    Perfil"/>
                </StackPanel>
                <Image Grid.Row="2" Source="Assets/ghost_menu.png" Width="218" Height="218" Stretch="Uniform" Opacity="0.33" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-18,0,0,-30" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1">
                <Grid MaxWidth="2500" Margin="28,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#A9C7EC" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/></Grid></Grid></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource HomeTopButton}" Content="⌂  Início" Click="Back_Click"/><Button Style="{StaticResource HomeTopButton}" Content="▶  Assistir" Click="PlayNext_Click"/><Button x:Name="LibraryTopButton" Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/><Button x:Name="CollectionsTopButton" Style="{StaticResource HomeTopButton}" Content="▱  Coleções" Click="Library_Click"/><Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/><Border Width="44" Height="44" CornerRadius="22" Background="#103461" BorderBrush="#4BC8FF" BorderThickness="1"><Grid><Ellipse Fill="#153F70" Margin="3"/><TextBlock Text="♙" Foreground="#C9F0FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel x:Name="DetailsContentHost" MaxWidth="2500" Margin="24,16,24,44" HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource HomeTopButton}" Content="←   Voltar" HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"/>

                    <Border x:Name="HeroBanner" Height="322" Background="#43C8FF" CornerRadius="20" Padding="2" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="20">
                        <Border.Effect><DropShadowEffect Color="#168BFF" BlurRadius="25" ShadowDepth="0" Opacity="0.30"/></Border.Effect>
                        <Border CornerRadius="18" Background="#071B38" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="18">
                            <Grid>
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" Opacity="0.48"><Image.Effect><BlurEffect Radius="13"/></Image.Effect></Image>
                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FC05152E" Offset="0"/><GradientStop Color="#F0071A38" Offset="0.42"/><GradientStop Color="#A5081B3A" Offset="0.68"/><GradientStop Color="#4503152D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <Border x:Name="HeroArtwork" Width="410" HorizontalAlignment="Right" Margin="0,0,30,0" Background="#06172E" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="16">
                                    <Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill" Opacity="0.94"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F7071936" Offset="0"/><GradientStop Color="#50071936" Offset="0.28"/><GradientStop Color="#00071936" Offset="0.72"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Grid>
                                </Border>
                                <StackPanel x:Name="HeroCopy" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,18,0,18" MaxWidth="720">
                                    <TextBlock x:Name="HeroTitleText" Text="{Binding AnimeTitle}" Foreground="White" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="None"/>
                                    <TextBlock Text="{Binding EnglishTitleDisplay}" Foreground="#C7DCF4" FontSize="16" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,15,0,0"><Border Background="#8A12345A" BorderBrush="#3B83B8" BorderThickness="1" CornerRadius="12" Padding="13,6" Margin="0,0,8,7"><TextBlock Text="Biblioteca local" Foreground="#D9EFFF" FontSize="11"/></Border><Border Background="#8A12345A" BorderBrush="#3B83B8" BorderThickness="1" CornerRadius="12" Padding="13,6" Margin="0,0,8,7"><TextBlock Text="{Binding WatchStateLabel}" Foreground="#72E0BE" FontSize="11"/></Border><Border Background="#8A12345A" BorderBrush="#3B83B8" BorderThickness="1" CornerRadius="12" Padding="13,6" Margin="0,0,8,7"><TextBlock Text="{Binding EpisodeCountLabel}" Foreground="#D9EFFF" FontSize="11"/></Border></WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="★" Foreground="#FFD45D" FontSize="22"/><TextBlock Text="{Binding CriticFiveLabel}" Foreground="#FFF0B0" FontSize="20" FontWeight="Bold" Margin="7,0,0,0"/><TextBlock Text="  Nota pública via AniList" Foreground="#A7C1DF" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0"/><Border Width="1" Height="20" Background="#3A628A" Margin="14,0"/><TextBlock Text="{Binding Summary}" Foreground="#CAE0F5" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Style="{StaticResource ActionButton}" Content="{Binding PlayNextLabel}" IsEnabled="{Binding CanPlayNext}" Click="PlayNext_Click" MinWidth="188"/><Button Style="{StaticResource HomeOutlineButton}" Content="☆   Minha avaliação" Margin="12,0,0,0" Click="OpenReviewTab_Click" MinWidth="168"/></StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition x:Name="RightRailColumn" Width="320"/></Grid.ColumnDefinitions>

                        <TabControl x:Name="AnimeTabControl" Style="{StaticResource AnimeTabs}">
                            <TabItem Header="▣   Sinopse">
                                <StackPanel>
                                    <Border Style="{StaticResource DetailPanel}" Padding="22" Margin="0,0,0,14">
                                        <Grid><Image Source="{Binding CoverPath}" Width="280" HorizontalAlignment="Right" Stretch="UniformToFill" Opacity="0.10"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F0081D3C" Offset="0"/><GradientStop Color="#E0081D3C" Offset="0.68"/><GradientStop Color="#90081D3C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#7BE1FF" FontSize="23"/><TextBlock Text="Sinopse" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel><TextBlock Text="{Binding Synopsis}" Foreground="#C6D9EE" FontSize="13" TextWrapping="Wrap" LineHeight="21" Margin="0,13,0,0" MaxWidth="920" HorizontalAlignment="Left"/></StackPanel></Grid>
                                    </Border>
                                    <DockPanel Margin="4,0,2,10"><TextBlock Text="Episódios" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding EpisodeCountLabel}" Foreground="#9FBBDD" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                                    <ItemsControl ItemsSource="{Binding Episodes}" ItemTemplate="{StaticResource EpisodeCardTemplate}"/>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="☷   Episódios">
                                <StackPanel><DockPanel Margin="4,0,2,12"><StackPanel><TextBlock Text="Sua lista local" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Reproduza, gerencie arquivos e marque seu progresso." Foreground="#8FACCE" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Text="{Binding EpisodeCountLabel}" Foreground="#9FBBDD" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></DockPanel><ItemsControl ItemsSource="{Binding Episodes}" ItemTemplate="{StaticResource EpisodeCardTemplate}"/></StackPanel>
                            </TabItem>

                            <TabItem x:Name="ReviewTab" Header="☆   Minha avaliação">
                                <Border Style="{StaticResource DetailPanel}" Padding="23">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True"><ComboBox x:Name="EpisodeReviewSelector" DockPanel.Dock="Right" Width="280" Height="40" Margin="18,0,0,0" ItemsSource="{Binding Episodes}" DisplayMemberPath="ReviewDisplay" SelectionChanged="EpisodeReviewSelector_SelectionChanged" Background="#112B50" Foreground="White" BorderBrush="#4388BD" Padding="10,6"/><StackPanel><TextBlock Text="✦  Avaliar episódio" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ReviewEpisodeTitleText" Text="Escolha um episódio" Foreground="#9FC0E5" FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
                                        <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="O que você achou deste episódio?" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/><WrapPanel><RadioButton x:Name="RatingOne" GroupName="AnimeRating" Tag="1" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/angry-sf.png" Width="82" Height="90" Stretch="Uniform"/><TextBlock Text="Não curti" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></RadioButton><RadioButton x:Name="RatingTwo" GroupName="AnimeRating" Tag="2" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/sad-sf.png" Width="82" Height="90" Stretch="Uniform"/><TextBlock Text="Fraquinho" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></RadioButton><RadioButton x:Name="RatingThree" GroupName="AnimeRating" Tag="3" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/boring-sf.png" Width="82" Height="90" Stretch="Uniform"/><TextBlock Text="Legalzinho" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></RadioButton><RadioButton x:Name="RatingFour" GroupName="AnimeRating" Tag="4" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/happy2-sf.png" Width="82" Height="90" Stretch="Uniform"/><TextBlock Text="Muito bom!" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></RadioButton><RadioButton x:Name="RatingFive" GroupName="AnimeRating" Tag="5" Style="{StaticResource ReactionCard}" Checked="RatingCard_Checked"><StackPanel><Image Source="Assets/happy-sf.png" Width="82" Height="90" Stretch="Uniform"/><TextBlock Text="Obra-prima!" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></RadioButton></WrapPanel><TextBlock Text="●  COMENTÁRIO (OPCIONAL)" Foreground="#9DD4F4" FontSize="11" FontWeight="Bold" Margin="0,10,0,8"/><TextBox x:Name="ReviewTextBox" Style="{StaticResource ReviewTextBox}" Height="108" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"/><DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Salvar comentário" Click="SaveComment_Click" Padding="14,7"/><TextBlock x:Name="ReviewStatusText" Foreground="#6CDEB2" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0"><Border Height="220" Background="#43C8FF" CornerRadius="16" Padding="2" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="16"><Border CornerRadius="14" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="14"><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle VerticalAlignment="Bottom" Height="78"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00102033" Offset="0"/><GradientStop Color="#F2071224" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel VerticalAlignment="Bottom" Margin="12"><TextBlock x:Name="ReviewEpisodeNumberText" Foreground="White" FontWeight="SemiBold"/><ProgressBar x:Name="ReviewEpisodeProgress" Maximum="100" Style="{StaticResource HomeProgress}" Margin="0,7,0,0"/><TextBlock x:Name="ReviewEpisodeProgressText" Foreground="#D3E6F7" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></Border></Border><Border Height="116" Margin="0,12,0,0" Style="{StaticResource DetailPanel}"><Grid ClipToBounds="True"><Image Source="Assets/normal-sf.png" Width="110" Opacity="0.10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-28"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="★  SUA NOTA" Foreground="#8AB7DF" FontSize="10" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"><TextBlock x:Name="RatingValueText" Text="—" Foreground="#76DFFF" FontSize="34" FontWeight="Bold"/><TextBlock Text="/5" Foreground="#9BB5D3" FontSize="16" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel><Button Style="{StaticResource GhostButton}" Content="Limpar" Click="ClearRating_Click"/></StackPanel></Grid></Border></StackPanel></Grid>
                                    </StackPanel>
