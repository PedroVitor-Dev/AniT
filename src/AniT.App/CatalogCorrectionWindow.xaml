<Window x:Class="AniT.App.CatalogCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corrigir títulos · AniT" Width="860" Height="670" MinWidth="720" MinHeight="560"
        Background="#071426" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/HomeTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Corrigir títulos identificados" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="As correções preservam arquivos, progresso, avaliações e histórico." Foreground="#91B5D6" Margin="0,6,0,18"/></StackPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#2D6898" Foreground="White">
            <TabItem Header="Mesclar títulos"><StackPanel Margin="20"><TextBlock Text="Una um título duplicado ao catálogo correto" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Tudo que estiver na origem será transferido para o destino. Quando houver o mesmo episódio nos dois, as versões e o maior progresso serão mantidos." Foreground="#8FB2D2" TextWrapping="Wrap" Margin="0,7,0,18"/><TextBlock Text="Título duplicado · origem" Foreground="#BFD9EF"/><ComboBox x:Name="MergeSourceBox" Style="{StaticResource SettingsComboBox}" DisplayMemberPath="Title" SelectedValuePath="Id" Margin="0,6,0,15"/><TextBlock Text="Título correto · destino" Foreground="#BFD9EF"/><ComboBox x:Name="MergeTargetBox" Style="{StaticResource SettingsComboBox}" DisplayMemberPath="Title" SelectedValuePath="Id" Margin="0,6,0,20"/><Button Style="{StaticResource HomePrimaryButton}" Content="Revisar e mesclar" Click="Merge_Click" HorizontalAlignment="Left" MinWidth="180"/></StackPanel></TabItem>
            <TabItem Header="Separar episódios"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Retire episódios associados ao título errado" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Selecione os episódios e informe o novo título. O AniT cria a nova obra sem mover os arquivos no disco." Foreground="#8FB2D2" TextWrapping="Wrap" Margin="0,7,0,15"/><ComboBox x:Name="SplitSourceBox" Style="{StaticResource SettingsComboBox}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="SplitSource_SelectionChanged"/></StackPanel><Grid Grid.Row="1" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Novo título" Foreground="#BFD9EF" VerticalAlignment="Center"/><TextBox x:Name="NewTitleBox" Grid.Column="1" Style="{StaticResource SettingsTextBox}"/></Grid><ListBox x:Name="SplitEpisodesList" Grid.Row="2" Background="#081D38" BorderBrush="#2D6898" BorderThickness="1" Padding="8" ItemsSource="{Binding SplitEpisodes}"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="7,6"/></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="3" Style="{StaticResource HomePrimaryButton}" Content="Criar título com selecionados" Click="Split_Click" HorizontalAlignment="Right" MinWidth="220" Margin="0,15,0,0"/></Grid></TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Foreground="#79E4B5" VerticalAlignment="Center" TextWrapping="Wrap"/><Button DockPanel.Dock="Right" Style="{StaticResource HomeOutlineButton}" Content="Fechar" Click="Close_Click" MinWidth="110"/></DockPanel>
    </Grid>
</Window>
