<Window x:Class="AniT.App.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AniT.App"
        Title="Conquistas · AniT" Width="1500" Height="920" MinWidth="1080" MinHeight="700"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/HomeTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <local:AchievementIconConverter x:Key="AchievementIconConverter"/>
            <Style x:Key="FilterCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="44"/>
                <Setter Property="MinWidth" Value="172"/>
                <Setter Property="Foreground" Value="#E8F4FF"/>
                <Setter Property="Background" Value="#0A2343"/>
                <Setter Property="BorderBrush" Value="#3475A8"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#DDEEFF"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="13,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#174F83"/><Setter Property="Foreground" Value="White"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1C6BAE"/><Setter Property="Foreground" Value="White"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                    <Grid Margin="14,0,12,0">
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                          VerticalAlignment="Center" Margin="0,0,24,0"/>
                                        <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#9FDDFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,6,0,0" Padding="6"
                                            Background="#FF091F3D" BorderBrush="#3B83B8" BorderThickness="1.5" CornerRadius="12">
                                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#61D4FF"/><Setter TargetName="ComboSurface" Property="Background" Value="#10345D"/></Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#8BE8FF"/><Setter TargetName="ComboSurface" Property="Background" Value="#123C68"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AchievementCardButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="CardHitSurface" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardHitSurface" Property="Opacity" Value="0.93"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardHitSurface" Property="Opacity" Value="0.76"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardHitSurface" Property="Opacity" Value="0.88"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="AchievementCardTemplate">
                <Button Click="Achievement_Click" Tag="{Binding Id}" Style="{StaticResource AchievementCardButton}" Margin="8">
                    <Border Width="282" Height="346" CornerRadius="22" Padding="15" Background="{Binding CardBackground}" BorderBrush="{Binding AccentBrush}" BorderThickness="1.5" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="154"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border CornerRadius="17" Background="#0B1E39" BorderBrush="#315F87" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding IconPath, Converter={StaticResource AchievementIconConverter}}" Stretch="Uniform" Margin="8" Visibility="{Binding IconVisibility}"/>
                                    <TextBlock Text="?" Foreground="#7992AD" FontSize="74" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LockedVisibility}"/>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Padding="8,4" CornerRadius="10" Background="#D9071830">
                                        <TextBlock Text="{Binding IdLabel}" Foreground="#A9CBE8" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="2,12,2,9">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Padding="9,4" CornerRadius="10" Background="{Binding RarityBackground}">
                                        <TextBlock Text="{Binding RarityLabel}" Foreground="{Binding AccentBrush}" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="44"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DisplayDescription}" Foreground="#9EBBD6" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,7,0,0" MaxHeight="36"/>
                                <TextBlock Text="{Binding ChainLabel}" Foreground="#6CA9D3" FontSize="9" Margin="0,7,0,0" Visibility="{Binding ChainVisibility}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <DockPanel Margin="0,0,0,5"><TextBlock Text="{Binding ProgressLabel}" Foreground="#D9ECFA" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="{Binding PercentLabel}" Foreground="{Binding AccentBrush}" FontSize="10" FontWeight="Bold"/></DockPanel>
                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="7" Style="{StaticResource HomeProgress}"/>
                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.7,0" Center="0.7,0" RadiusX="1" RadiusY="1.15"><GradientStop Color="#0B356A" Offset="0"/><GradientStop Color="#041A36" Offset="0.42"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#F2051730" BorderBrush="#1E5D91" BorderThickness="0,0,0,1" Padding="34,20">
            <Grid MaxWidth="1640">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CONQUISTAS" Foreground="White" FontSize="36" FontWeight="Black"/>
                    <TextBlock Text="Cada episódio conta uma história. Cada conquista conta a sua." Foreground="#A8CCE9" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0">
                    <DockPanel><TextBlock Text="{Binding UnlockedLabel}" Foreground="White" FontSize="15" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="{Binding AniPointsLabel}" Foreground="#FFE06D" FontSize="15" FontWeight="Bold"/></DockPanel>
                    <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}" Maximum="100" Height="10" Style="{StaticResource HomeProgress}" Margin="0,9,0,0"/>
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙  Configurações" Style="{StaticResource HomeOutlineButton}" Click="Settings_Click" Margin="0,0,10,0"/>
                    <Button Content="⌂  Início" Style="{StaticResource HomePrimaryButton}" Click="Home_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#D9061831" BorderBrush="#245A87" BorderThickness="0,0,0,1" Padding="28,13">
            <WrapPanel HorizontalAlignment="Center">
                <ComboBox x:Name="StatusFilter" Style="{StaticResource FilterCombo}" SelectionChanged="Filter_Changed" Margin="5"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="Desbloqueadas"/><ComboBoxItem Content="Bloqueadas"/><ComboBoxItem Content="Em progresso"/><ComboBoxItem Content="Secretas"/></ComboBox>
                <ComboBox x:Name="CategoryFilter" Style="{StaticResource FilterCombo}" SelectionChanged="Filter_Changed" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="5"/>
                <ComboBox x:Name="RarityFilter" Style="{StaticResource FilterCombo}" SelectionChanged="Filter_Changed" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="5"/>
                <ComboBox x:Name="SortFilter" Style="{StaticResource FilterCombo}" SelectionChanged="Filter_Changed" Margin="5"><ComboBoxItem Content="Ordem original"/><ComboBoxItem Content="Raridade"/><ComboBoxItem Content="Progresso"/><ComboBoxItem Content="Recém desbloqueadas"/></ComboBox>
                <Button Content="↻  Recalcular" Style="{StaticResource HomeOutlineButton}" Click="Recalculate_Click" Margin="10,5,5,5"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="AchievementsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,18,24,42" ScrollChanged="AchievementsScroll_ScrollChanged">
                <StackPanel MaxWidth="1660" HorizontalAlignment="Center">
                    <Border x:Name="ChainPanel" CornerRadius="18" Background="#D709213F" BorderBrush="#2B72A8" BorderThickness="1" Padding="17" Margin="8,0,8,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CADEIAS DE PROGRESSÃO" Foreground="#72D8FF" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding ChainSummary}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="Marcos individuais permanecem registrados" Foreground="#8FB2D1" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid>
                    </Border>
                    <TextBlock x:Name="EmptyState" Text="Nenhuma conquista corresponde aos filtros escolhidos." Foreground="#88A8C8" FontSize="15" HorizontalAlignment="Center" Margin="0,60" Visibility="Collapsed"/>
                    <ItemsControl ItemsSource="{Binding VisibleAchievements}" ItemTemplate="{StaticResource AchievementCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="LoadingState" Background="#F2071933" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✦" Foreground="#59D7FF" FontSize="34" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingTitle" Text="Carregando conquistas…" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock x:Name="LoadingDetail" Text="Preparando suas jornadas e AniPoints." Foreground="#91B8D8" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
