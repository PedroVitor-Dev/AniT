<Window x:Class="AniT.App.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil · AniT" Width="1520" Height="940" MinWidth="1080" MinHeight="720"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/HomeTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProfilePanel" TargetType="Border"><Setter Property="Background" Value="#EE071B37"/><Setter Property="BorderBrush" Value="#2B72A8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/></Style>
            <Style x:Key="StatLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#9AB9DA"/><Setter Property="FontSize" Value="11"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
            <Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextAlignment" Value="Center"/></Style>
            <DataTemplate x:Key="HighlightTemplate">
                <Border Style="{StaticResource ProfilePanel}" Margin="0,0,10,0" Padding="16" MinHeight="100">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{Binding AccentBackground}" VerticalAlignment="Top"><TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Label}" Foreground="#93B5D7" FontSize="10"/><TextBlock Text="{Binding Value}" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock Text="{Binding Detail}" Foreground="#7FC9EF" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="FavoriteTemplate">
                <Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,9,8">
                    <Border Width="158" Height="186" CornerRadius="14" Background="#0A2243" BorderBrush="#2A679A" BorderThickness="1" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="14">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="142"/><RowDefinition Height="*"/></Grid.RowDefinitions><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.55"/><GradientStop Color="#C8041730" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel Grid.Row="1" Margin="10,7"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#8FB5D7" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Grid>
                    </Border>
                </Button>
            </DataTemplate>
            <DataTemplate x:Key="RankTemplate">
                <Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" HorizontalAlignment="Stretch">
                    <Grid Height="48" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" Foreground="#8EDBFF" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="8"><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="2" Margin="9,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#7FA8CC" FontSize="8"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding ScoreLabel}" Foreground="#FFD75A" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </Button>
            </DataTemplate>
            <DataTemplate x:Key="ActivityTemplate">
                <Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" HorizontalAlignment="Stretch"><Grid Height="51" Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><Border Width="46" Height="43" CornerRadius="8" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="8"><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="7,2"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#82BFE5" FontSize="8" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding WhenLabel}" Foreground="#89A9C9" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Button>
            </DataTemplate>
            <DataTemplate x:Key="AchievementTemplate">
                <Border Width="188" Height="248" Margin="0,0,10,10" Background="{Binding CardBackground}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="16" Opacity="{Binding Opacity}">
                    <Grid ClipToBounds="True"><Ellipse Width="138" Height="138" Fill="{Binding Glow}" Opacity="0.28" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-34,0,0"><Ellipse.Effect><BlurEffect Radius="28"/></Ellipse.Effect></Ellipse><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Image Source="{Binding BadgePath}" Width="108" Height="108" Stretch="Uniform" Opacity="{Binding BadgeOpacity}" HorizontalAlignment="Center" VerticalAlignment="Center"><Image.Effect><DropShadowEffect Color="{Binding GlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.62"/></Image.Effect></Image><Border Visibility="{Binding LockedVisibility}" Width="34" Height="34" CornerRadius="17" Background="#DD061326" BorderBrush="#6E8BA9" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,7"><TextBlock Text="⌑" Foreground="#B6C7D8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                        <StackPanel Grid.Row="1"><Border Background="{Binding RarityBackground}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Center"><TextBlock Text="{Binding Rarity}" Foreground="{Binding Accent}" FontSize="8" FontWeight="Bold"/></Border><TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="4,6,4,0"/></StackPanel>
                        <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="#91B1D0" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" LineHeight="13" Margin="2,4"/>
                        <Grid Grid.Row="3" Margin="0,4,0,0"><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Height="6"/><TextBlock Text="{Binding ProgressLabel}" Foreground="#C4D9EC" FontSize="8" HorizontalAlignment="Right" Margin="0,8,0,0"/></Grid>
                        <DockPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding PointsLabel}" Foreground="#FFD86A" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding Accent}" FontSize="8" FontWeight="Bold"/></DockPanel>
                    </Grid></Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="CalendarDayTemplate"><Border Width="34" Height="32" Margin="2" CornerRadius="9" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1"><TextBlock Text="{Binding Day}" Foreground="{Binding Foreground}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.7,0.02" Center="0.7,0.02" RadiusX="1" RadiusY="1.1"><GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.45"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/><Button Style="{StaticResource HomeNavButton}" Content="⌂    Início" Click="Home_Click"/><Button Style="{StaticResource HomeNavButton}" Content="◉    Explorar" Click="Explore_Click"/><Button Style="{StaticResource HomeNavButton}" Content="▱    Biblioteca" Click="Library_Click"/><Button Style="{StaticResource HomeNavButton}" Content="▣    Calendário" Click="Calendar_Click"/><Button Style="{StaticResource HomeNavButton}" Content="◷    Histórico" Click="History_Click"/><Button Style="{StaticResource HomeActiveNavButton}" Content="♙    Perfil"/></StackPanel>
                <Grid Grid.Row="2" IsHitTestVisible="False"><TextBlock Text="Mais animes, mais boas memórias. ♡" Foreground="#9ED7FF" FontFamily="Segoe Print" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="165" VerticalAlignment="Bottom" Margin="0,0,0,220"/><Image Source="Assets/Profile/2.png" Width="200" Height="200" Stretch="Uniform" Opacity="0.86" VerticalAlignment="Bottom" Margin="0,0,0,25"/></Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1"><Grid MaxWidth="2500" Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#A9C7EC" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/></Grid></Grid></Border><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource HomeTopButton}" Content="⌂  Início" Click="Home_Click"/><Button Style="{StaticResource HomeTopButton}" Content="▶  Assistir" Click="Continue_Click"/><Button x:Name="LibraryTopButton" Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/><Button x:Name="CollectionsTopButton" Style="{StaticResource HomeTopButton}" Content="▱  Coleções" Click="Library_Click"/><Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/><Border Width="44" Height="44" CornerRadius="22" Background="#103461" BorderBrush="#4BC8FF" BorderThickness="1"><TextBlock Text="♙" Foreground="#C9F0FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Grid></Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ProfileContentHost" MaxWidth="2500" Margin="24,16,24,46">
                    <Border x:Name="HeroPanel" Height="330" Background="#43C8FF" Padding="2" CornerRadius="20" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="20">
                        <Border CornerRadius="18" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="18"><Grid><Image Source="Assets/History/2.png" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FA06162F" Offset="0"/><GradientStop Color="#E30A2346" Offset="0.42"/><GradientStop Color="#77102B50" Offset="0.78"/><GradientStop Color="#B2051730" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                            <Grid Margin="30,24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="142" Height="142" CornerRadius="71" BorderBrush="#76E5FF" BorderThickness="3" Background="#102B50" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="71" HorizontalAlignment="Left" VerticalAlignment="Center"><Image Source="{Binding AvatarPath}" Stretch="UniformToFill"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="35" FontWeight="Bold"/><TextBlock Text="  ✎" Foreground="#9AE4FF" FontSize="21" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding Bio}" Foreground="#E3EEFA" FontSize="16" TextWrapping="Wrap" MaxWidth="660" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Border Background="#184B7C" BorderBrush="#68DFFF" BorderThickness="1" CornerRadius="14" Padding="13,6"><TextBlock Text="{Binding LevelLabel}" Foreground="White" FontWeight="SemiBold"/></Border><Border Background="#3D2B58" BorderBrush="#E5BAFF" BorderThickness="1" CornerRadius="14" Padding="13,6" Margin="9,0,0,0"><TextBlock Text="★  Explorador de Mundos" Foreground="#FFF0CB" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="{Binding MemberSinceLabel}" Foreground="#A2C5E4" FontSize="11" Margin="0,11,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Style="{StaticResource HomeOutlineButton}" Content="✎  Editar perfil" Click="EditProfile_Click" MinWidth="150"/><Button Style="{StaticResource HomeOutlineButton}" Content="⇩  Exportar backup" Click="ExportBackup_Click" MinWidth="165" Margin="10,0,0,0"/></StackPanel>
                            </Grid>
                            <UniformGrid Grid.Row="1" Columns="5" Margin="0,8,0,0"><Border Style="{StaticResource ProfilePanel}" Margin="0,0,8,0" Padding="10"><StackPanel><TextBlock Text="▣  DIAS ASSISTIDOS" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding DaysWatchedLabel}" Style="{StaticResource StatValue}"/><TextBlock Text="dias com histórias" Style="{StaticResource StatLabel}"/></StackPanel></Border><Border Style="{StaticResource ProfilePanel}" Margin="0,0,8,0" Padding="10"><StackPanel><TextBlock Text="▶  EPISÓDIOS VISTOS" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding EpisodesWatchedLabel}" Style="{StaticResource StatValue}"/><TextBlock Text="na sua jornada" Style="{StaticResource StatLabel}"/></StackPanel></Border><Border Style="{StaticResource ProfilePanel}" Margin="0,0,8,0" Padding="10"><StackPanel><TextBlock Text="◷  HORAS ASSISTIDAS" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding HoursWatchedLabel}" Style="{StaticResource StatValue}"/><TextBlock Text="de boas histórias" Style="{StaticResource StatLabel}"/></StackPanel></Border><Border Style="{StaticResource ProfilePanel}" Margin="0,0,8,0" Padding="10"><StackPanel><TextBlock Text="✓  ANIMES CONCLUÍDOS" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding CompletedAnimeLabel}" Style="{StaticResource StatValue}"/><TextBlock Text="continuando a jornada" Style="{StaticResource StatLabel}"/></StackPanel></Border><Border Style="{StaticResource ProfilePanel}" Padding="10"><StackPanel><TextBlock Text="★  NOTA MÉDIA" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding AverageRatingLabel}" Style="{StaticResource StatValue}"/><TextBlock Text="{Binding RatingsCountLabel}" Style="{StaticResource StatLabel}"/></StackPanel></Border></UniformGrid>
                        </Grid></Grid></Border>
                    </Border>

                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="RightRailColumn" Width="330"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="✦  Meus destaques" Style="{StaticResource HomeSectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Highlights}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><StaticResource ResourceKey="HighlightTemplate"/></ItemsControl.ItemTemplate></ItemsControl>
                            <Grid Margin="0,17,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver biblioteca  →" Click="Library_Click"/><TextBlock Text="♡  Favoritos" Style="{StaticResource HomeSectionTitle}"/></DockPanel><ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource FavoriteTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock x:Name="FavoritesEmpty" Text="Marque títulos como favoritos para encontrá-los aqui." Foreground="#84A8CB" FontSize="11" Margin="4,16" Visibility="Collapsed"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →" Click="Library_Click"/><TextBlock Text="♛  Top 5 pessoal" Style="{StaticResource HomeSectionTitle}"/></DockPanel><Border Style="{StaticResource ProfilePanel}" Padding="10" Margin="0,8,0,0"><ItemsControl ItemsSource="{Binding TopAnime}" ItemTemplate="{StaticResource RankTemplate}"/></Border><TextBlock x:Name="RankingEmpty" Text="Avalie episódios para criar seu ranking pessoal." Foreground="#84A8CB" FontSize="11" Margin="4,16" Visibility="Collapsed"/></StackPanel></Grid>
                            <Border Style="{StaticResource ProfilePanel}" Margin="0,10,0,0" Padding="18"><StackPanel><Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="♛  Jornada de conquistas" Style="{StaticResource HomeSectionTitle}"/><TextBlock Text="Cada marco da sua jornada desbloqueia um emblema exclusivo." Foreground="#8EAFD0" FontSize="11" Margin="2,4,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><DockPanel><TextBlock Text="{Binding AchievementPointsLabel}" Foreground="#FFD967" FontSize="10" FontWeight="Bold" DockPanel.Dock="Right"/><TextBlock Text="{Binding AchievementsUnlockedLabel}" Foreground="#C8E8FA" FontSize="10"/></DockPanel><ProgressBar Value="{Binding AchievementProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Height="8" Margin="0,7,0,0"/></StackPanel></Grid><ItemsControl ItemsSource="{Binding Achievements}" ItemTemplate="{StaticResource AchievementTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></Border>
                        </StackPanel>

                        <StackPanel x:Name="RightRail" Grid.Column="2">
                            <Border Style="{StaticResource ProfilePanel}" Margin="0,0,0,10" Padding="14"><Grid Height="210"><Image Source="Assets/Profile/1.png" Width="180" Height="180" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-18,-12,0"/><StackPanel VerticalAlignment="Top" MaxWidth="170" HorizontalAlignment="Left"><TextBlock Text="♨  Baki-Pi no seu perfil!" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="Você faz parte de algo especial! Cada anime assistido é uma nova história na sua jornada. Continue explorando! ♡" Foreground="#CEE3F7" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,92,0,0"/></StackPanel></Grid></Border>
                            <Border Style="{StaticResource ProfilePanel}" Margin="0,0,0,10" Padding="14"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Calendário  →" Click="Calendar_Click"/><TextBlock Text="▣  Meu calendário" Foreground="White" FontSize="15" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding CurrentMonthLabel}" Foreground="#BFD6EE" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6"/><UniformGrid Columns="7"><TextBlock Text="D" Style="{StaticResource StatLabel}"/><TextBlock Text="S" Style="{StaticResource StatLabel}"/><TextBlock Text="T" Style="{StaticResource StatLabel}"/><TextBlock Text="Q" Style="{StaticResource StatLabel}"/><TextBlock Text="Q" Style="{StaticResource StatLabel}"/><TextBlock Text="S" Style="{StaticResource StatLabel}"/><TextBlock Text="S" Style="{StaticResource StatLabel}"/></UniformGrid><ItemsControl ItemsSource="{Binding CalendarDays}" ItemTemplate="{StaticResource CalendarDayTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Border Height="1" Background="#24577F" Margin="0,10"/><DockPanel><TextBlock Text="Atividade recente" Foreground="White" FontSize="13" FontWeight="SemiBold"/></DockPanel><ItemsControl ItemsSource="{Binding RecentActivities}" ItemTemplate="{StaticResource ActivityTemplate}"/></StackPanel></Border>
                            <Border Style="{StaticResource ProfilePanel}" Padding="14"><StackPanel><TextBlock Text="✧  Minha coleção" Foreground="White" FontSize="15" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><Border Background="#164E7F" CornerRadius="14" Padding="12,7" Margin="0,0,7,7"><TextBlock Text="{Binding FavoriteCountLabel}" Foreground="#9DE6FF" FontSize="10"/></Border><Border Background="#214D43" CornerRadius="14" Padding="12,7" Margin="0,0,7,7"><TextBlock Text="{Binding CompletedCountLabel}" Foreground="#9FFFD8" FontSize="10"/></Border><Border Background="#4A3658" CornerRadius="14" Padding="12,7" Margin="0,0,7,7"><TextBlock Text="{Binding WatchingCountLabel}" Foreground="#F0C6FF" FontSize="10"/></Border></WrapPanel></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
