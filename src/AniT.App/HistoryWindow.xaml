<Window x:Class="AniT.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AniT.App"
        Title="Histórico · AniT" Width="1520" Height="940" MinWidth="1080" MinHeight="720"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HistoryPanel" TargetType="Border">
                <Setter Property="Background" Value="#EC071B37"/>
                <Setter Property="BorderBrush" Value="#2873AA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>

            <Style x:Key="HistoryPeriodButton" TargetType="Button" BasedOn="{StaticResource HomeOutlineButton}">
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="HistoryComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="42"/><Setter Property="Foreground" Value="#E8F4FF"/><Setter Property="Background" Value="#081E3E"/>
                <Setter Property="BorderBrush" Value="#24639B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DDEEFF"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="13,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#174D82"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1D68A9"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><Grid Margin="14,0,12,0"><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/><TextBlock Text="⌄" Foreground="#A9DFFF" FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Padding="5" Background="#F20A1F40" BorderBrush="#337EB9" BorderThickness="1" CornerRadius="12"><ScrollViewer MaxHeight="250"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#5AD5FF"/><Setter TargetName="ComboSurface" Property="Background" Value="#103158"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#79E3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>

            <Style x:Key="HistorySummaryLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#C7DAEF"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,7"/></Style>
            <Style x:Key="HistorySummaryValue" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,5"/></Style>

            <StreamGeometry x:Key="History.Icon.Play">M8,5 L19,12 8,19 Z</StreamGeometry>
            <StreamGeometry x:Key="History.Icon.Clock">M12,3 A9,9 0 1 1 11.99,3 M12,7 L12,12 16,14</StreamGeometry>
            <StreamGeometry x:Key="History.Icon.Flame">M12,22 C7,22 4,18.5 5,14 C5.7,11 8,9.5 9,6 C10.5,7.4 11.2,9 11,11 C13,9.7 15,7.2 14,3 C18.5,6.2 21,10.5 20,15 C19.2,19.3 16.2,22 12,22 Z</StreamGeometry>
            <StreamGeometry x:Key="History.Icon.Session">M5,5 L19,5 19,19 5,19 Z M8,8 L16,8 M8,12 L16,12 M8,16 L13,16</StreamGeometry>
            <StreamGeometry x:Key="History.Icon.Search">M10.5,4 A6.5,6.5 0 1 1 10.49,4 M15.2,15.2 L21,21</StreamGeometry>
            <StreamGeometry x:Key="History.Icon.Comment">M4,5 L20,5 20,17 10,17 6,21 6,17 4,17 Z M8,9 L16,9 M8,13 L14,13</StreamGeometry>
            <StreamGeometry x:Key="History.Icon.Edit">M5,19 L6,14 16,4 20,8 10,18 Z M14.5,5.5 L18.5,9.5</StreamGeometry>
            <StreamGeometry x:Key="History.Icon.Chevron">M7,9 L12,14 17,9</StreamGeometry>

            <DataTemplate x:Key="HistoryActivityTemplate">
                <Border Style="{StaticResource HistoryPanel}" CornerRadius="14" Margin="0,0,0,8" Padding="10" Tag="{Binding AnimeId}" Cursor="Hand" MouseLeftButtonUp="HistoryRow_Click">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid MinHeight="84">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/><ColumnDefinition Width="166"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
                            <Border Width="132" Height="78" CornerRadius="10" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="10"><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle Fill="#26031228"/></Grid></Border>
                            <StackPanel Grid.Column="1" Margin="10,2,18,0"><TextBlock Text="{Binding AnimeTitle}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding EpisodeLabel}" Foreground="#55CFFF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding EpisodeTitle}" Foreground="#9BB8D6" FontSize="10" Margin="10,1,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Path Data="{StaticResource History.Icon.Clock}" Stroke="#8FD9FF" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/><TextBlock Text="{Binding SessionTimeLabel}" Foreground="#A9C5E0" FontSize="9" Margin="6,0,14,0"/><Path Data="{StaticResource History.Icon.Session}" Stroke="#8FD9FF" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/><TextBlock Text="{Binding DurationLabel}" Foreground="#A9C5E0" FontSize="9" Margin="6,0,0,0"/></StackPanel><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Height="6" Margin="0,8,8,0"/></StackPanel>
                            <Border Grid.Column="2" Width="148" Height="66" Background="{Binding RatingBackground}" BorderBrush="{Binding RatingBorder}" BorderThickness="1" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding RatingImagePath}" Width="58" Height="58" Stretch="Uniform" Margin="3,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="1,0,6,0"><TextBlock Text="SUA NOTA" Foreground="#79CFF5" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding RatingLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                            <ToggleButton x:Name="CommentToggle" Grid.Column="3" Height="44" Margin="8,0,0,0" VerticalAlignment="Center" Background="#9B0A2445" BorderBrush="#2E6C9F" BorderThickness="1" Cursor="Hand" FocusVisualStyle="{x:Null}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="CommentSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><Path Data="{StaticResource History.Icon.Comment}" Stroke="#65D8FF" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="COMENTÁRIO" Foreground="#7CCFF3" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding CommentButtonLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><Path x:Name="CommentChevron" Grid.Column="2" Data="{StaticResource History.Icon.Chevron}" Stroke="#9ADFFF" StrokeThickness="2" Width="13" Height="9" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CommentSurface" Property="BorderBrush" Value="#60D8FF"/><Setter TargetName="CommentSurface" Property="Background" Value="#173B64"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="CommentSurface" Property="Background" Value="#184872"/><Setter TargetName="CommentSurface" Property="BorderBrush" Value="#72E1FF"/><Setter TargetName="CommentChevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
                        </Grid>
                        <Button Grid.Row="1" Tag="{Binding AnimeId}" Click="EditComment_Click" Margin="150,9,0,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent" Padding="0"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=CommentToggle}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Border BorderBrush="#2E78A9" BorderThickness="1" CornerRadius="12" Padding="14,10"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F20A2343" Offset="0"/><GradientStop Color="#E90D2C50" Offset="0.62"/><GradientStop Color="#E7133A61" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Path Data="{StaticResource History.Icon.Comment}" Stroke="#62D8FF" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0"/><TextBlock Grid.Column="1" Text="{Binding ReviewText}" Foreground="#D6E8F8" FontSize="11" TextWrapping="Wrap" LineHeight="17"/><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Path Data="{StaticResource History.Icon.Edit}" Stroke="#8CE6FF" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/><TextBlock Text="Editar" Foreground="#8CE6FF" FontSize="10" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel></Grid></Border>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="HistoryGroupTemplate">
                <StackPanel Margin="0,0,0,8">
                    <DockPanel Margin="2,0,2,8"><TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="#9BC5E8" FontSize="10" VerticalAlignment="Bottom"/><StackPanel Orientation="Horizontal"><Border Width="4" Height="27" CornerRadius="2" Background="{Binding Accent}" Margin="0,0,9,0"/><TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
                    <ItemsControl ItemsSource="{Binding Activities}" ItemTemplate="{StaticResource HistoryActivityTemplate}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.72,0.03" Center="0.72,0.03" RadiusX="0.96" RadiusY="1.08"><GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.44"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeNavButton}" Click="Home_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Home}" Label="Início"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Explore_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Explore}" Label="Explorar"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Library_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Library}" Label="Biblioteca"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Calendar_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Calendar}" Label="Calendário"/></Button>
                    <Button Style="{StaticResource HomeActiveNavButton}"><local:NavItemContent IconData="{StaticResource AniT.Icon.History}" Label="Histórico"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Profile_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Profile}" Label="Perfil"/></Button>
                    <local:SystemSettingsNavButton/>
                </StackPanel>
                <Grid Grid.Row="2" IsHitTestVisible="False"><TextBlock Text="Cada episódio é uma nova história!&#x0a;— Baki-Pi" Style="{StaticResource HomeSidebarMascotCaption}"/><Image Source="Assets/History/3.png" Style="{StaticResource HomeSidebarMascot}"/></Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1"><Grid MaxWidth="2500" Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource History.Icon.Search}" Stroke="#A9DFFF" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="GlobalSearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="GlobalSearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" TextChanged="GlobalSearchBox_TextChanged" KeyDown="GlobalSearchBox_KeyDown"/></Grid></Grid></Border><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource HomeTopButton}" Content="⌂  Início" Click="Home_Click"/><Button Style="{StaticResource HomeTopButton}" Content="▶  Assistir" Click="Continue_Click"/><Button x:Name="LibraryTopButton" Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/><Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/><local:ProfileAvatarButton/></StackPanel></Grid></Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HistoryContentHost" MaxWidth="2500" Margin="24,0,24,44">
                    <Border Height="150" CornerRadius="0,0,20,20" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="20"><Grid><Image Source="Assets/History/2.png" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F6041732" Offset="0"/><GradientStop Color="#BD061A38" Offset="0.35"/><GradientStop Color="#3C061A38" Offset="0.8"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel Margin="32,0" VerticalAlignment="Center"><TextBlock Text="Histórico" Foreground="White" FontSize="42" FontWeight="Bold"/><TextBlock Text="Seu diário pessoal de animes assistidos." Foreground="#D8E8FA" FontSize="18" FontStyle="Italic" Margin="0,2,0,0"/></StackPanel></Grid></Border>

                    <UniformGrid Columns="4" Margin="0,12,0,12">
                        <Border Style="{StaticResource HistoryPanel}" Margin="0,0,8,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="23" Background="#174F84"><Path Data="{StaticResource History.Icon.Play}" Stroke="#80E7FF" StrokeThickness="1.8" Width="21" Height="21" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Episódios assistidos" Foreground="#C8DDF2" FontSize="11"/><TextBlock Text="{Binding TotalEpisodesLabel}" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding WeekEpisodesLabel}" Foreground="#55D6FF" FontSize="9"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource HistoryPanel}" Margin="0,0,8,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="23" Background="#174F84"><Path Data="{StaticResource History.Icon.Clock}" Stroke="#80E7FF" StrokeThickness="1.8" Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Horas assistidas" Foreground="#C8DDF2" FontSize="11"/><TextBlock Text="{Binding TotalHoursLabel}" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding WeekHoursLabel}" Foreground="#55D6FF" FontSize="9"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource HistoryPanel}" Margin="0,0,8,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="23" Background="#59412D"><Path Data="{StaticResource History.Icon.Flame}" Stroke="#FFB34F" StrokeThickness="1.7" Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Sequência de dias" Foreground="#C8DDF2" FontSize="11"/><TextBlock Text="{Binding StreakLabel}" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="Continue assim!" Foreground="#55D6FF" FontSize="9"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource HistoryPanel}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="23" Background="#174F84"><Path Data="{StaticResource History.Icon.Session}" Stroke="#80E7FF" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Última sessão" Foreground="#C8DDF2" FontSize="11"/><TextBlock Text="{Binding LatestSessionLabel}" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding LatestSessionDetail}" Foreground="#55D6FF" FontSize="9"/></StackPanel></Grid></Border>
                    </UniformGrid>

                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="TodayButton" Style="{StaticResource HistoryPeriodButton}" Content="Hoje" Tag="Today" Click="Period_Click"/><Button x:Name="WeekButton" Style="{StaticResource HistoryPeriodButton}" Content="Semana" Tag="Week" Click="Period_Click"/><Button x:Name="MonthButton" Style="{StaticResource HistoryPeriodButton}" Content="Mês" Tag="Month" Click="Period_Click"/><Button x:Name="AllButton" Style="{StaticResource HistoryPeriodButton}" Content="Todos" Tag="All" Click="Period_Click"/></StackPanel><Border Grid.Column="1" Height="42" Margin="4,0,12,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource History.Icon.Search}" Stroke="#8FDFFF" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="HistorySearchHint" Text="Buscar no histórico..." Foreground="#7194BB" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="HistorySearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" Padding="0,0,12,0" VerticalContentAlignment="Center" TextChanged="HistorySearchBox_TextChanged"/></Grid></Grid></Border><ComboBox x:Name="AnimeFilter" Grid.Column="2" Style="{StaticResource HistoryComboBox}" ItemsSource="{Binding AnimeFilters}" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,10,0"/><ComboBox x:Name="OrderFilter" Grid.Column="3" Style="{StaticResource HistoryComboBox}" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Mais recentes"/><ComboBoxItem Content="Mais antigos"/><ComboBoxItem Content="Melhor avaliados"/><ComboBoxItem Content="Maior progresso"/></ComboBox></Grid>

                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="RightRailColumn" Width="300"/></Grid.ColumnDefinitions>
                        <Grid><ItemsControl ItemsSource="{Binding HistoryGroups}" ItemTemplate="{StaticResource HistoryGroupTemplate}"/><Border x:Name="HistoryEmptyState" Style="{StaticResource HistoryPanel}" Padding="35" VerticalAlignment="Top" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center"><TextBlock Text="◷" Foreground="#63D9FF" FontSize="38" HorizontalAlignment="Center"/><TextBlock Text="Nenhuma sessão encontrada" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Ajuste os filtros ou assista a um episódio para criar uma nova memória." Foreground="#8EAECE" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,6,0,0"/></StackPanel></Border></Grid>

                        <StackPanel x:Name="RightRail" Grid.Column="2">
                            <Border Style="{StaticResource HistoryPanel}" Padding="12" Margin="0,0,0,10"><Grid Height="134"><Image Source="Assets/History/4.png" Width="132" Height="132" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-12,0,0,-8"/><StackPanel Margin="116,7,2,2"><TextBlock Text="Baki-Pi diz:" Foreground="White" FontSize="15" FontWeight="Bold"/><TextBlock Text="Que jornada incrível! Cada episódio que você assiste torna sua história ainda mais especial." Foreground="#C8DDF3" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="0,8,0,0"/></StackPanel></Grid></Border>
                            <Border Style="{StaticResource HistoryPanel}" Padding="15" Margin="0,0,0,10"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" Width="112" Height="30" Style="{StaticResource HistoryComboBox}" SelectedIndex="0" IsHitTestVisible="False"><ComboBoxItem Content="{Binding PeriodLabel}"/></ComboBox><TextBlock Text="▥  Resumo do período" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><Border Height="1" Background="#28567E" Margin="0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▣   Episódios assistidos" Style="{StaticResource HistorySummaryLabel}"/><TextBlock Text="◷   Horas assistidas" Style="{StaticResource HistorySummaryLabel}"/><TextBlock Text="▣   Dias ativos" Style="{StaticResource HistorySummaryLabel}"/><TextBlock Text="◉   Animes diferentes" Style="{StaticResource HistorySummaryLabel}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding PeriodEpisodesLabel}" Style="{StaticResource HistorySummaryValue}"/><TextBlock Text="{Binding PeriodHoursLabel}" Style="{StaticResource HistorySummaryValue}"/><TextBlock Text="{Binding ActiveDaysLabel}" Style="{StaticResource HistorySummaryValue}"/><TextBlock Text="{Binding UniqueAnimeLabel}" Style="{StaticResource HistorySummaryValue}"/></StackPanel></Grid></StackPanel></Border>
