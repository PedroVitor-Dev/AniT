<Window x:Class="AniT.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico · AniT" Width="1520" Height="940" MinWidth="1080" MinHeight="720"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HistoryPanel" TargetType="Border">
                <Setter Property="Background" Value="#EC071B37"/>
                <Setter Property="BorderBrush" Value="#2873AA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>

            <Style x:Key="HistoryPeriodButton" TargetType="Button" BasedOn="{StaticResource HomeOutlineButton}">
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="HistoryComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="42"/><Setter Property="Foreground" Value="#E8F4FF"/><Setter Property="Background" Value="#081E3E"/>
                <Setter Property="BorderBrush" Value="#24639B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DDEEFF"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="13,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#174D82"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1D68A9"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><Grid Margin="14,0,12,0"><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/><TextBlock Text="⌄" Foreground="#A9DFFF" FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Padding="5" Background="#F20A1F40" BorderBrush="#337EB9" BorderThickness="1" CornerRadius="12"><ScrollViewer MaxHeight="250"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#5AD5FF"/><Setter TargetName="ComboSurface" Property="Background" Value="#103158"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#79E3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>

            <Style x:Key="HistorySummaryLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#C7DAEF"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,7"/></Style>
            <Style x:Key="HistorySummaryValue" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,5"/></Style>

            <DataTemplate x:Key="HistoryActivityTemplate">
                <Border Style="{StaticResource HistoryPanel}" CornerRadius="12" Margin="0,0,0,7" Padding="9" Tag="{Binding AnimeId}" Cursor="Hand" MouseLeftButtonUp="HistoryRow_Click">
                    <Grid Height="82">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/><ColumnDefinition Width="220"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <Border Width="132" Height="78" CornerRadius="9" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="9"><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle Fill="#36031228"/></Grid></Border>
                        <StackPanel Grid.Column="1" Margin="9,1,12,0"><TextBlock Text="{Binding AnimeTitle}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding EpisodeLabel}" Foreground="#55CFFF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding EpisodeTitle}" Foreground="#9BB8D6" FontSize="10" Margin="10,1,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="◷" Foreground="#9FC8E8" FontSize="11"/><TextBlock Text="{Binding SessionTimeLabel}" Foreground="#A9C5E0" FontSize="9" Margin="5,0,12,0"/><TextBlock Text="◷" Foreground="#9FC8E8" FontSize="11"/><TextBlock Text="{Binding DurationLabel}" Foreground="#A9C5E0" FontSize="9" Margin="5,0,0,0"/></StackPanel><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Height="6" Margin="0,7,28,0"/></StackPanel>
                        <Border Grid.Column="2" Background="{Binding RatingBackground}" BorderBrush="{Binding RatingBorder}" BorderThickness="1" CornerRadius="18" Padding="11,7" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RatingIcon}" Foreground="#FFE070" FontSize="16"/><TextBlock Text="{Binding RatingLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" Margin="7,1,0,0"/></StackPanel></Border>
                        <Button Grid.Column="3" Tag="{Binding AnimeId}" Click="EditComment_Click" Background="#A60A2445" BorderBrush="#255C8C" BorderThickness="1" Padding="12,8" Margin="8,4" Cursor="Hand" FocusVisualStyle="{x:Null}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="CommentSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><TextBlock Text="{Binding ReviewText}" Foreground="#C7DAEF" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CommentSurface" Property="BorderBrush" Value="#54D4FF"/><Setter TargetName="CommentSurface" Property="Background" Value="#173A63"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                        <TextBlock Grid.Column="4" Text="⋮" Foreground="#8CC8ED" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="HistoryGroupTemplate">
                <StackPanel Margin="0,0,0,8">
                    <DockPanel Margin="2,0,2,8"><TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="#9BC5E8" FontSize="10" VerticalAlignment="Bottom"/><StackPanel Orientation="Horizontal"><Border Width="4" Height="27" CornerRadius="2" Background="{Binding Accent}" Margin="0,0,9,0"/><TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
                    <ItemsControl ItemsSource="{Binding Activities}" ItemTemplate="{StaticResource HistoryActivityTemplate}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.72,0.03" Center="0.72,0.03" RadiusX="0.96" RadiusY="1.08"><GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.44"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/><Button Style="{StaticResource HomeNavButton}" Content="⌂    Início" Click="Home_Click"/><Button Style="{StaticResource HomeNavButton}" Content="◉    Explorar" Click="Explore_Click"/><Button Style="{StaticResource HomeNavButton}" Content="▱    Biblioteca" Click="Library_Click"/><Button Style="{StaticResource HomeNavButton}" Content="▣    Calendário" Click="Calendar_Click"/><Button Style="{StaticResource HomeActiveNavButton}" Content="◷    Histórico"/><Button Style="{StaticResource HomeNavButton}" Content="♙    Perfil" Click="Profile_Click"/></StackPanel>
                <Grid Grid.Row="2" IsHitTestVisible="False"><TextBlock Text="Cada episódio é uma nova história!&#x0a;— Baki-Pi" Foreground="#A7D8FF" FontFamily="Segoe Print" FontSize="12" TextAlignment="Center" Margin="15,0,15,300" VerticalAlignment="Bottom"/><Image Source="Assets/History/3.png" Width="218" Height="218" Stretch="Uniform" Opacity="0.78" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,78"/></Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1"><Grid MaxWidth="2500" Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#A9C7EC" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="GlobalSearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="GlobalSearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" TextChanged="GlobalSearchBox_TextChanged" KeyDown="GlobalSearchBox_KeyDown"/></Grid></Grid></Border><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource HomeTopButton}" Content="⌂  Início" Click="Home_Click"/><Button Style="{StaticResource HomeTopButton}" Content="▶  Assistir" Click="Continue_Click"/><Button x:Name="LibraryTopButton" Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/><Button x:Name="CollectionsTopButton" Style="{StaticResource HomeTopButton}" Content="▱  Coleções" Click="Library_Click"/><Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/><Border Width="44" Height="44" CornerRadius="22" Background="#103461" BorderBrush="#4BC8FF" BorderThickness="1"><TextBlock Text="♙" Foreground="#C9F0FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Grid></Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HistoryContentHost" MaxWidth="2500" Margin="24,0,24,44">
                    <Border Height="150" CornerRadius="0,0,20,20" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="20"><Grid><Image Source="Assets/History/2.png" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F6041732" Offset="0"/><GradientStop Color="#BD061A38" Offset="0.35"/><GradientStop Color="#3C061A38" Offset="0.8"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel Margin="32,0" VerticalAlignment="Center"><TextBlock Text="Histórico" Foreground="White" FontSize="42" FontWeight="Bold"/><TextBlock Text="Seu diário pessoal de animes assistidos." Foreground="#D8E8FA" FontSize="18" FontStyle="Italic" Margin="0,2,0,0"/></StackPanel></Grid></Border>

                    <UniformGrid Columns="4" Margin="0,12,0,12">
                        <Border Style="{StaticResource HistoryPanel}" Margin="0,0,8,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="23" Background="#174F84"><TextBlock Text="▶" Foreground="#80E7FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Episódios assistidos" Foreground="#C8DDF2" FontSize="11"/><TextBlock Text="{Binding TotalEpisodesLabel}" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding WeekEpisodesLabel}" Foreground="#55D6FF" FontSize="9"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource HistoryPanel}" Margin="0,0,8,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="23" Background="#174F84"><TextBlock Text="◷" Foreground="#80E7FF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Horas assistidas" Foreground="#C8DDF2" FontSize="11"/><TextBlock Text="{Binding TotalHoursLabel}" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding WeekHoursLabel}" Foreground="#55D6FF" FontSize="9"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource HistoryPanel}" Margin="0,0,8,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="23" Background="#59412D"><TextBlock Text="♨" Foreground="#FFB34F" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Sequência de dias" Foreground="#C8DDF2" FontSize="11"/><TextBlock Text="{Binding StreakLabel}" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="Continue assim!" Foreground="#55D6FF" FontSize="9"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource HistoryPanel}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="23" Background="#174F84"><TextBlock Text="▣" Foreground="#80E7FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Última sessão" Foreground="#C8DDF2" FontSize="11"/><TextBlock Text="{Binding LatestSessionLabel}" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding LatestSessionDetail}" Foreground="#55D6FF" FontSize="9"/></StackPanel></Grid></Border>
                    </UniformGrid>

                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="TodayButton" Style="{StaticResource HistoryPeriodButton}" Content="Hoje" Tag="Today" Click="Period_Click"/><Button x:Name="WeekButton" Style="{StaticResource HistoryPeriodButton}" Content="Semana" Tag="Week" Click="Period_Click"/><Button x:Name="MonthButton" Style="{StaticResource HistoryPeriodButton}" Content="Mês" Tag="Month" Click="Period_Click"/><Button x:Name="AllButton" Style="{StaticResource HistoryPeriodButton}" Content="Todos" Tag="All" Click="Period_Click"/></StackPanel><Border Grid.Column="1" Height="42" Margin="4,0,12,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#8FDFFF" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="HistorySearchHint" Text="Buscar no histórico..." Foreground="#7194BB" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="HistorySearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" Padding="0,0,12,0" VerticalContentAlignment="Center" TextChanged="HistorySearchBox_TextChanged"/></Grid></Grid></Border><ComboBox x:Name="AnimeFilter" Grid.Column="2" Style="{StaticResource HistoryComboBox}" ItemsSource="{Binding AnimeFilters}" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,10,0"/><ComboBox x:Name="OrderFilter" Grid.Column="3" Style="{StaticResource HistoryComboBox}" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Mais recentes"/><ComboBoxItem Content="Mais antigos"/><ComboBoxItem Content="Melhor avaliados"/><ComboBoxItem Content="Maior progresso"/></ComboBox></Grid>

                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="RightRailColumn" Width="300"/></Grid.ColumnDefinitions>
                        <Grid><ItemsControl ItemsSource="{Binding HistoryGroups}" ItemTemplate="{StaticResource HistoryGroupTemplate}"/><Border x:Name="HistoryEmptyState" Style="{StaticResource HistoryPanel}" Padding="35" VerticalAlignment="Top" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center"><TextBlock Text="◷" Foreground="#63D9FF" FontSize="38" HorizontalAlignment="Center"/><TextBlock Text="Nenhuma sessão encontrada" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Ajuste os filtros ou assista a um episódio para criar uma nova memória." Foreground="#8EAECE" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,6,0,0"/></StackPanel></Border></Grid>

                        <StackPanel x:Name="RightRail" Grid.Column="2">
                            <Border Style="{StaticResource HistoryPanel}" Padding="12" Margin="0,0,0,10"><Grid Height="134"><Image Source="Assets/History/4.png" Width="132" Height="132" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-12,0,0,-8"/><StackPanel Margin="116,7,2,2"><TextBlock Text="Baki-Pi diz:" Foreground="White" FontSize="15" FontWeight="Bold"/><TextBlock Text="Que jornada incrível! Cada episódio que você assiste torna sua história ainda mais especial." Foreground="#C8DDF3" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="0,8,0,0"/></StackPanel></Grid></Border>
                            <Border Style="{StaticResource HistoryPanel}" Padding="15" Margin="0,0,0,10"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" Width="112" Height="30" Style="{StaticResource HistoryComboBox}" SelectedIndex="0" IsHitTestVisible="False"><ComboBoxItem Content="{Binding PeriodLabel}"/></ComboBox><TextBlock Text="▥  Resumo do período" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><Border Height="1" Background="#28567E" Margin="0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▣   Episódios assistidos" Style="{StaticResource HistorySummaryLabel}"/><TextBlock Text="◷   Horas assistidas" Style="{StaticResource HistorySummaryLabel}"/><TextBlock Text="▣   Dias ativos" Style="{StaticResource HistorySummaryLabel}"/><TextBlock Text="◉   Animes diferentes" Style="{StaticResource HistorySummaryLabel}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding PeriodEpisodesLabel}" Style="{StaticResource HistorySummaryValue}"/><TextBlock Text="{Binding PeriodHoursLabel}" Style="{StaticResource HistorySummaryValue}"/><TextBlock Text="{Binding ActiveDaysLabel}" Style="{StaticResource HistorySummaryValue}"/><TextBlock Text="{Binding UniqueAnimeLabel}" Style="{StaticResource HistorySummaryValue}"/></StackPanel></Grid></StackPanel></Border>
                            <Border Style="{StaticResource HistoryPanel}" Padding="13" Margin="0,0,0,10"><StackPanel><TextBlock Text="★  Destaque do período" Foreground="White" FontSize="15" FontWeight="SemiBold"/><Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="68" Height="76" CornerRadius="9" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="9"><Image Source="{Binding HighlightCoverPath}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="9,3,0,0"><TextBlock Text="{Binding HighlightTitle}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38"/><TextBlock Text="{Binding HighlightSubtitle}" Foreground="#7ECFF4" FontSize="9" Margin="0,6,0,0"/><ProgressBar Value="{Binding HighlightPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Height="7" Margin="0,10,0,0"/></StackPanel></Grid></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
