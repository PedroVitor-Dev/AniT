<UserControl x:Class="AniT.App.CinematicSidebar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Focusable="False">
 <Border Background="{DynamicResource AniT.Sidebar}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="0,0,1,0" Padding="16,24,16,16">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="8,0,0,24">
    <Border Width="150" Height="64" HorizontalAlignment="Left"><Border.Background><ImageBrush ImageSource="/AniT;component/Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
    <TextBlock Text="SUA PRÓXIMA HISTÓRIA" Style="{DynamicResource AniT.Caption}" Margin="0,10,0,0"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" BorderThickness="0" Padding="4">
    <StackPanel x:Name="NavigationItems">
     <RadioButton AutomationProperties.Name="Início" Tag="Home" GroupName="Shell" Style="{DynamicResource AniT.NavigationItem}" Click="Navigate_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource AniT.Icon.Home}" Stroke="{DynamicResource AniT.Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Início" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton AutomationProperties.Name="Explorar" Tag="Explore" GroupName="Shell" Style="{DynamicResource AniT.NavigationItem}" Click="Navigate_Click" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource AniT.Icon.Explore}" Stroke="{DynamicResource AniT.Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Explorar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton AutomationProperties.Name="Biblioteca" Tag="Library" GroupName="Shell" Style="{DynamicResource AniT.NavigationItem}" Click="Navigate_Click" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource AniT.Icon.Library}" Stroke="{DynamicResource AniT.Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Biblioteca" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton AutomationProperties.Name="Calendário" Tag="Calendar" GroupName="Shell" Style="{DynamicResource AniT.NavigationItem}" Click="Navigate_Click" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource AniT.Icon.Calendar}" Stroke="{DynamicResource AniT.Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Calendário" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton AutomationProperties.Name="Histórico" Tag="History" GroupName="Shell" Style="{DynamicResource AniT.NavigationItem}" Click="Navigate_Click" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource AniT.Icon.History}" Stroke="{DynamicResource AniT.Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Histórico" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton AutomationProperties.Name="Conquistas" Tag="Achievements" GroupName="Shell" Style="{DynamicResource AniT.NavigationItem}" Click="Navigate_Click" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource AniT.Icon.Achievements}" Stroke="{DynamicResource AniT.Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Conquistas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton AutomationProperties.Name="Perfil" Tag="Profile" GroupName="Shell" Style="{DynamicResource AniT.NavigationItem}" Click="Navigate_Click" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource AniT.Icon.Profile}" Stroke="{DynamicResource AniT.Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Perfil" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></RadioButton>
     <Border Height="1" Background="{DynamicResource AniT.Border}" Margin="8,20,8,12"/>
     <RadioButton AutomationProperties.Name="Configurações" Tag="Settings" GroupName="Shell" Style="{DynamicResource AniT.NavigationItem}" Click="Navigate_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource AniT.Icon.Settings}" Stroke="{DynamicResource AniT.Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Configurações" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></RadioButton>
    </StackPanel>
   </ScrollViewer>
   <StackPanel x:Name="Identity" Grid.Row="2" Margin="8,20,0,0">
    <Image Source="/AniT;component/Assets/normal-sf.png" Width="56" Height="64" Stretch="Uniform" HorizontalAlignment="Left"/>
    <TextBlock Text="Um episódio por vez." Style="{DynamicResource AniT.Caption}" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
