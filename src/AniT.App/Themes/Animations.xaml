<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Duration x:Key="AniT.Motion.Fast">0:0:0.14</Duration>
    <Duration x:Key="AniT.Motion.Normal">0:0:0.20</Duration>
    <Duration x:Key="AniT.Motion.Slow">0:0:0.28</Duration>

    <CubicEase x:Key="AniT.Motion.EaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="AniT.Motion.EaseInOut" EasingMode="EaseInOut"/>
</ResourceDictionary>
