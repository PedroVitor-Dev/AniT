<Window x:Class="AniT.App.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar perfil · AniT" Width="760" Height="720" MinWidth="700" MinHeight="600"
        Background="#050E20" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
    <Grid Margin="18">
        <Border Background="#EC081B38" BorderBrush="#3487BE" BorderThickness="1" CornerRadius="18" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Editar perfil" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Suas alterações só aparecem depois de salvar." Foreground="#91B5D9" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,14,0,0" Padding="14" Background="#A20B254B" BorderBrush="#2D6D9F" BorderThickness="1" CornerRadius="15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Height="112" CornerRadius="12" BorderBrush="#43C9FF" BorderThickness="2" ClipToBounds="True" Background="#081B35">
                            <Image x:Name="BannerPreview" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CAPA DO PERFIL" Foreground="#73BFE8" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Escolha uma arte panorâmica em alta qualidade." Foreground="#D2E7F8" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="BannerStatusText" Text="Capa padrão do AniT" Foreground="#83A8CC" FontSize="10" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                <Button Style="{StaticResource HomePrimaryButton}" Content="Escolher arte online" Click="ChooseBanner_Click" MinWidth="155"/>
                                <Button Style="{StaticResource HomeOutlineButton}" Content="Usar padrão" Click="ClearBanner_Click" MinWidth="105" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,14,0,0" Padding="16" Background="#A20B254B" BorderBrush="#2D6D9F" BorderThickness="1" CornerRadius="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="200" Height="200" HorizontalAlignment="Center">
                            <Ellipse Fill="#102B50" Stroke="#69DEFF" StrokeThickness="3">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#35CFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.42"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="AvatarPreview" Width="142" Height="142" Stroke="#9AE9FF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarPreviewBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FOTO DE PERFIL" Foreground="#73BFE8" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Escolha uma imagem e ajuste o tamanho do avatar." Foreground="#D2E7F8" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AvatarFileText" Text="Avatar automático" Foreground="#83A8CC" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Button Style="{StaticResource HomePrimaryButton}" Content="Escolher foto" Click="ChooseAvatar_Click" MinWidth="125"/>
                                <Button Style="{StaticResource HomeOutlineButton}" Content="Usar automático" Click="ClearAvatar_Click" MinWidth="125" Margin="9,0,0,0"/>
                            </StackPanel>
                            <Grid Margin="0,16,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="TAMANHO DO AVATAR" Foreground="#73BFE8" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="AvatarSizeText" Grid.Column="1" Foreground="#C9F2FF" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            </Grid>
                            <Slider x:Name="AvatarSizeSlider" Minimum="104" Maximum="190" Value="142" TickFrequency="2"
                                    IsSnapToTickEnabled="True" ValueChanged="AvatarSizeSlider_ValueChanged"
                                    Foreground="#55D8FF" Background="#173E67"/>
                            <TextBlock Text="O tamanho será aplicado na capa do seu perfil." Foreground="#7398BD" FontSize="10" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="NOME" Foreground="#73BFE8" FontSize="10" FontWeight="Bold" Margin="2,0,0,7"/>
                    <Border Height="44" Background="#0B2445" BorderBrush="#2D6D9F" BorderThickness="1" CornerRadius="11">
                        <TextBox x:Name="NameTextBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#55D8FF" Padding="13,0" VerticalContentAlignment="Center" FontSize="14" MaxLength="32"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock Text="SUA FRASE" Foreground="#73BFE8" FontSize="10" FontWeight="Bold" Margin="2,0,0,7"/>
                    <Border Background="#0B2445" BorderBrush="#2D6D9F" BorderThickness="1" CornerRadius="11">
                        <TextBox x:Name="BioTextBox" MinHeight="66" MaxHeight="78" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#55D8FF" Padding="13,10" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="180"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="ValidationText" Grid.Row="5" Foreground="#FF8C9B" FontSize="10" Margin="2,8,0,0"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource HomeOutlineButton}" Content="Cancelar" Click="Cancel_Click" MinWidth="105"/>
                    <Button Style="{StaticResource HomePrimaryButton}" Content="Salvar perfil  ✓" Click="Save_Click" MinWidth="145" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
