<Window x:Class="AniT.App.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar perfil · AniT" Width="520" Height="430" MinWidth="480" MinHeight="400"
        Background="#050E20" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/HomeTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="26">
        <Border Background="#EC081B38" BorderBrush="#3487BE" BorderThickness="1" CornerRadius="18" Padding="24">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Editar perfil" Foreground="White" FontSize="26" FontWeight="Bold"/><TextBlock Text="Personalize como sua jornada aparece no AniT." Foreground="#91B5D9" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,23,0,0"><TextBlock Text="NOME" Foreground="#73BFE8" FontSize="10" FontWeight="Bold" Margin="2,0,0,7"/><Border Height="44" Background="#0B2445" BorderBrush="#2D6D9F" BorderThickness="1" CornerRadius="11"><TextBox x:Name="NameTextBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#55D8FF" Padding="13,0" VerticalContentAlignment="Center" FontSize="14" MaxLength="32"/></Border></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,17,0,0"><TextBlock Text="SUA FRASE" Foreground="#73BFE8" FontSize="10" FontWeight="Bold" Margin="2,0,0,7"/><Border Background="#0B2445" BorderBrush="#2D6D9F" BorderThickness="1" CornerRadius="11"><TextBox x:Name="BioTextBox" MinHeight="92" MaxHeight="110" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#55D8FF" Padding="13,10" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="180"/></Border></StackPanel>
                <TextBlock x:Name="ValidationText" Grid.Row="3" Foreground="#FF8C9B" FontSize="10" Margin="2,8,0,0"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource HomeOutlineButton}" Content="Cancelar" Click="Cancel_Click" MinWidth="105"/><Button Style="{StaticResource HomePrimaryButton}" Content="Salvar perfil  ✓" Click="Save_Click" MinWidth="145" Margin="10,0,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
