<Window x:Class="AniT.App.OnlineAnimeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AniT.App" local:StableWindowRendering.Enabled="True" Title="Online Anime Player · Beta · AniT" Width="820" Height="640" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterScreen" Icon="/AniT;component/Assets/anit.ico" Background="{DynamicResource AniT.Brush.Background}" Foreground="{DynamicResource AniT.Brush.TextPrimary}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/HomeTheme.xaml"/><ResourceDictionary Source="Styles/TheaterTheme.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AniT.Brush.TextPrimary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="Button" BasedOn="{StaticResource CinemaAction}"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,10"/></Style>
 <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource AniT.Brush.TextPrimary}"/><Setter Property="Background" Value="{DynamicResource AniT.Brush.Surface}"/><Setter Property="Padding" Value="16"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource AniT.Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AniT.Brush.AccentCyan}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AniT.Brush.AccentCyan}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,24"><TextBlock FontSize="27" FontWeight="Bold" Text="Online Anime Player · Beta"/><TextBlock Text="Adicione uma fonte. Seus episódios ficam na biblioteca." Foreground="{DynamicResource AniT.Brush.TextSecondary}" Margin="0,8,0,0"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
 <Border x:Name="ConsentPanel" VerticalAlignment="Top" Background="{DynamicResource AniT.Brush.Surface}" BorderBrush="{DynamicResource AniT.Brush.Border}" BorderThickness="1" CornerRadius="18" Padding="24"><StackPanel>
 <TextBlock Text="Antes de começar" FontSize="23" FontWeight="SemiBold"/>
 <TextBlock Text="Utilize somente conteúdo que você tem autorização para baixar, assistir e compartilhar. Você é responsável pelos arquivos e links adicionados; o AniT não fornece conteúdo." Margin="0,16,0,12"/>
 <TextBlock Text="O BitTorrent também pode enviar partes dos arquivos para outras pessoas. Os episódios ficam no seu PC; Cloud indica que o download ainda está em andamento." Foreground="{DynamicResource AniT.Brush.TextSecondary}"/>
 <CheckBox x:Name="ConsentCheck" Style="{StaticResource AniT.Input.CheckBox}" Background="{DynamicResource AniT.Brush.Surface}" Foreground="{DynamicResource AniT.Brush.TextPrimary}" Margin="0,24,0,20"><TextBlock Tag="ThemeManaged" Text="Tenho autorização para usar os conteúdos que vou adicionar e entendi como funciona." Foreground="{DynamicResource AniT.Brush.TextPrimary}"/></CheckBox>
 <Button Content="Concordar e continuar" IsEnabled="{Binding IsChecked, ElementName=ConsentCheck}" HorizontalAlignment="Left" Click="Consent_Click"/>
 </StackPanel></Border>
 <StackPanel x:Name="Workspace" Visibility="Collapsed">
 <TextBlock Text="Como deseja adicionar?" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
 <UniformGrid Columns="2" Margin="0,0,0,22">
 <RadioButton x:Name="TorrentChoice" GroupName="Source" Checked="SourceMode_Changed" Margin="0,0,8,0"><StackPanel><TextBlock Text="Arquivo .torrent" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Selecione um arquivo ou cole sua URL." Margin="0,8,0,0" Foreground="{DynamicResource AniT.Brush.TextSecondary}"/></StackPanel></RadioButton>
 <RadioButton x:Name="MagnetChoice" GroupName="Source" Checked="SourceMode_Changed" Margin="8,0,0,0"><StackPanel><TextBlock Text="Link magnético" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Cole um magnet link manualmente." Margin="0,8,0,0" Foreground="{DynamicResource AniT.Brush.TextSecondary}"/></StackPanel></RadioButton>
 </UniformGrid>
 <StackPanel x:Name="InputPanel" Visibility="Collapsed">
 <Button x:Name="PickTorrentButton" Content="Selecionar arquivo .torrent…" HorizontalAlignment="Left" Click="PickTorrent_Click" Margin="0,0,0,18"/>
 <TextBlock x:Name="SourceLabel" Text="URL do arquivo .torrent" Margin="0,0,0,8"/>
 <TextBox x:Name="SourceBox" Style="{StaticResource AniT.Input.TextBox}" MinHeight="48" AutomationProperties.Name="Fonte do torrent"/>
 <TextBlock Text="O nome, a capa e os episódios são identificados automaticamente. O download do vídeo começa quando você abrir um episódio." Foreground="{DynamicResource AniT.Brush.TextSecondary}" Margin="0,14,0,22"/>
 <Button x:Name="AddButton" IsDefault="True" Content="Adicionar à biblioteca" HorizontalAlignment="Left" Click="Add_Click"/>
 </StackPanel>
 </StackPanel>
 </Grid></ScrollViewer>
 <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource AniT.Brush.TextSecondary}"/><Button Grid.Column="1" Content="Voltar ao AniT" Click="Back_Click"/></Grid>
 </Grid>
</Window>
