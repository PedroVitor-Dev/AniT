<Window x:Class="AniT.App.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AniT" Width="1380" Height="860" MinWidth="1060" MinHeight="700" Background="#031027" WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#BCD3F7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="20,13"/><Setter Property="Margin" Value="8,2"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="0,13,13,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#153A69"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Background" Value="#1B5596"/><Setter Property="Foreground" Value="White"/></Style>
        <Style x:Key="TopNavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D9E8FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#62D6FF"/></Trigger></Style.Triggers></Style>
        <Style x:Key="OutlineButton" TargetType="Button"><Setter Property="Background" Value="#7A04132C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#A7D8FF"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="Padding" Value="22,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ImageCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CardFocus" Background="{TemplateBinding Background}" CornerRadius="14" Padding="2" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardFocus" Property="Background" Value="#173B68"/><Setter TargetName="CardFocus" Property="BorderBrush" Value="#4EC5FF"/><Setter TargetName="CardFocus" Property="Effect"><Setter.Value><DropShadowEffect Color="#168BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/></Setter.Value></Setter></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CardFocus" Property="Background" Value="#0E294D"/><Setter TargetName="CardFocus" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardFocus" Property="BorderBrush" Value="#9DE8FF"/><Setter TargetName="CardFocus" Property="Background" Value="#14345E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionLink" TargetType="Button" BasedOn="{StaticResource TopNavButton}"><Setter Property="Foreground" Value="#9EC8F1"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,4"/></Style>
    </Window.Resources>
    <Grid x:Name="ResponsiveRoot">
        <Grid.LayoutTransform><ScaleTransform x:Name="InterfaceScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.63,0.12" Center="0.63,0.12" RadiusX="0.92" RadiusY="0.88"><GradientStop Color="#0A346D" Offset="0"/><GradientStop Color="#041A3B" Offset="0.42"/><GradientStop Color="#020A1B" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#C9051B3B" BorderBrush="#163D6C" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="215"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="Assets/fire.png" Width="31" Height="40" Stretch="Uniform" Margin="0,0,-9,0"/><Border Width="88" Height="44"><Border.Background><ImageBrush ImageSource="Assets/logo-letter-white.png" Viewbox="0.04,0.20,0.92,0.45" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,12,0,0"><Button Style="{StaticResource ActiveNavButton}" Content="⌂    Início"/><Button Style="{StaticResource NavButton}" Content="◉    Explorar" Click="Library_Click"/><Button Style="{StaticResource NavButton}" Content="▱    Minha lista" Click="Library_Click"/><Button Style="{StaticResource NavButton}" Content="▣    Calendário"/><Button Style="{StaticResource NavButton}" Content="◷    Histórico" Click="Library_Click"/><Button Style="{StaticResource NavButton}" Content="☆    Avaliações" Click="Library_Click"/><Button Style="{StaticResource NavButton}" Content="♙    Perfil"/><Border Height="1" Background="#214874" Margin="18,16,18,10"/><Button Style="{StaticResource NavButton}" Content="⚙    Configurar estante" Click="ConfigureShelf_Click"/></StackPanel>
                <Image Grid.Row="2" Source="Assets/ghost_menu.png" Width="230" Height="230" Stretch="Uniform" Opacity="0.30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-20,0,0,-35" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#A9041938" BorderBrush="#15487B" BorderThickness="0,0,0,1"><Grid Margin="20,0,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="SearchContainer" MinWidth="260" MaxWidth="500" Height="42" Margin="0,0,18,0" Background="#87102A50" BorderBrush="#2A5D91" BorderThickness="1" CornerRadius="21" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#A9C7EC" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7899C4" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,12,0" ToolTip="Buscar animes e episódios" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/></Grid></Grid></Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource TopNavButton}" Content="⌂  Início"/><Button Style="{StaticResource TopNavButton}" Content="▶  Assistir" Click="ContinueTop_Click"/><Button x:Name="MyListTopButton" Style="{StaticResource TopNavButton}" Content="♡  Minha Lista" Click="Library_Click"/><Button x:Name="CollectionsTopButton" Style="{StaticResource TopNavButton}" Content="▱  Coleções" Click="Library_Click"/><Border Width="1" Height="30" Background="#1B4777" Margin="10,0"/><Border Width="42" Height="42" CornerRadius="21" Background="#0E315D" BorderBrush="#48BFFF" BorderThickness="1" ToolTip="Perfil (em breve)"><Grid><Ellipse Fill="#123B6C" Margin="3"/><TextBlock Text="♙" Foreground="#BFE9FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></StackPanel>
            </Grid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="18,12,18,24"><Grid.RowDefinitions><RowDefinition Height="278"/><RowDefinition Height="232"/><RowDefinition Height="210"/><RowDefinition Height="210"/></Grid.RowDefinitions>
                <Border x:Name="HeroBanner" CornerRadius="10" Background="#071B38" BorderBrush="#5ACBFF" BorderThickness="4" HorizontalAlignment="Stretch"><Border.Effect><DropShadowEffect Color="#168BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.38"/></Border.Effect><Border CornerRadius="6" Background="#071B38" ClipToBounds="True"><Grid><Image Source="{Binding HeroCoverPath}" Stretch="UniformToFill" Opacity="0.45"><Image.Effect><BlurEffect Radius="8"/></Image.Effect></Image><Image Source="{Binding HeroCoverPath}" Width="360" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.88" Margin="0,-70,70,-70"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FA051735" Offset="0"/><GradientStop Color="#E2061B3A" Offset="0.43"/><GradientStop Color="#65031A38" Offset="0.78"/><GradientStop Color="#A002142F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Grid Margin="34,28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" MaxWidth="1050" HorizontalAlignment="Left"><TextBlock Text="Novos caminhos. Novas histórias." Foreground="#9FC9F4" FontSize="14"/><TextBlock x:Name="HeroTitleText" Text="{Binding HeroTitle}" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="96"/><TextBlock Text="{Binding HeroSubtitle}" Foreground="#D6E9FF" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,21,0,0"><Button Style="{StaticResource BrandButton}" Content="▶   Continuar" IsEnabled="{Binding CanPlayHero}" Click="HeroContinue_Click" MinWidth="166"/><Button Style="{StaticResource OutlineButton}" Content="ⓘ   Detalhes" Click="HeroDetails_Click" Margin="13,0,0,0" MinWidth="150"/></StackPanel></StackPanel><TextBlock x:Name="HeroQuote" Grid.Column="1" Text="Às vezes,&#x0a;o amanhã brilha&#x0a;mais longe." Foreground="#E4F0FF" FontFamily="Georgia" FontStyle="Italic" FontSize="18" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,15"><Ellipse Width="10" Height="10" Fill="#A8E7FF"/><Ellipse Width="10" Height="10" Fill="#315A89" Margin="9,0,0,0"/><Ellipse Width="10" Height="10" Fill="#315A89" Margin="9,0,0,0"/><Ellipse Width="10" Height="10" Fill="#315A89" Margin="9,0,0,0"/></StackPanel></Grid></Border></Border>
                <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SessionCardColumn" Width="240"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Foreground="#82DCFF" FontSize="24" VerticalAlignment="Center"/><TextBlock Text="Continuar assistindo" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></DockPanel><Grid Grid.Row="1"><ItemsControl ItemsSource="{Binding ContinueCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ImageCardButton}" Tag="{Binding EpisodeId}" Click="ContinueCard_Click" Margin="0,0,12,0"><Border Width="202" Height="172" CornerRadius="14" BorderBrush="#2D6A9F" BorderThickness="1" Background="#0A1C37" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Border Width="34" Height="34" CornerRadius="17" Background="#D4082649" BorderBrush="#9FE6FF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,9"><TextBlock Text="▶" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><StackPanel Grid.Row="1" Margin="11,6"><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,4,0,0"><TextBlock Text="{Binding Subtitle}" Foreground="#AFC9E9" FontSize="11" DockPanel.Dock="Left"/><TextBlock Text="{Binding ProgressLabel}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" Margin="0,5,0,0" Foreground="#62D6FF" Background="#214267" BorderThickness="0"/></StackPanel></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="ContinueEmptyText" Text="Comece um episódio e ele aparecerá aqui." Foreground="#7897BD" FontSize="13" Margin="5,22"/></Grid></Grid>
                    <Border Grid.Column="1" CornerRadius="10" Background="#071B38" BorderBrush="#4EC5FF" BorderThickness="3" Margin="10,0,0,0"><Border CornerRadius="6" Background="#071B38" ClipToBounds="True"><Grid><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#071B38" Offset="0"/><GradientStop Color="#102F5A" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Image Source="Assets/ghost_background.png" Stretch="UniformToFill" Opacity="0.32" Margin="-18,-10,-18,-28" IsHitTestVisible="False"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,8" TextBlock.TextAlignment="Center"><Image Source="Assets/ghost_popcorn.png" Width="138" Height="100" Stretch="Uniform" HorizontalAlignment="Center"/><Border Background="#E8071B38" BorderBrush="#7ADFFF" BorderThickness="1" CornerRadius="9" Padding="9,6" Margin="8,-4,8,0"><StackPanel><TextBlock Text="Boa sessão!" Foreground="White" FontWeight="Bold" FontSize="19"/><TextBlock Text="Grandes histórias&#x0a;te esperam aqui." Foreground="#D9EDFF" FontSize="13" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></Grid></Border></Border>
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CalendarColumn" Width="390"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="#5FD1FF" FontSize="24"/><TextBlock Text="Adicionados recentemente" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="9,0,0,0"/></StackPanel></DockPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding RecentCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ImageCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,11,0"><StackPanel Width="150"><Border Height="116" CornerRadius="12" ClipToBounds="True" BorderBrush="#255C91" BorderThickness="1"><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Title}" Foreground="#F4F9FF" FontWeight="SemiBold" FontSize="12" Margin="3,6,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SecondaryText}" Foreground="#8EB4DF" FontSize="10" Margin="3,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                    <Border Grid.Column="1" Background="#071B38" BorderBrush="#4EC5FF" BorderThickness="2" CornerRadius="10" Margin="12,0,0,0" VerticalAlignment="Top" MinHeight="92" MaxHeight="165"><Border CornerRadius="7" Background="#071B38" ClipToBounds="True" Padding="12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SectionLink}" Content="Ver todos  →" Click="Library_Click"/><TextBlock Text="▣  Calendário da semana" Foreground="White" FontSize="14" FontWeight="SemiBold"/></DockPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarItems}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DayLabel}" Foreground="#77BFFF" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#D8E8FC" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding EpisodeLabel}" Foreground="#9BB8DA" FontSize="9" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border></Border>
                </Grid>
                <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SectionLink}" Content="Ver todos  →" Click="Library_Click"/><TextBlock Text="♥  Favoritos" Foreground="White" FontSize="19" FontWeight="SemiBold"/></DockPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding FavoriteCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ImageCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,10,0"><StackPanel Width="142"><Border Height="105" CornerRadius="11" ClipToBounds="True" BorderBrush="#285E92" BorderThickness="1"><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><TextBlock Text="♥" Foreground="#6CD9FF" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,7,0"/></Grid></Border><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="3,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="FavoritesEmptyText" Grid.Row="1" Text="Seus favoritos aparecerão aqui." Foreground="#7897BD" Margin="4,28"/></Grid>
                    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SectionLink}" Content="Ver todos  →" Click="Library_Click"/><TextBlock Text="★  Mais bem avaliados" Foreground="White" FontSize="19" FontWeight="SemiBold"/></DockPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding TopRatedCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ImageCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,10,0"><StackPanel Width="142"><Border Height="105" CornerRadius="11" ClipToBounds="True" BorderBrush="#285E92" BorderThickness="1"><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="3,6,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ScoreLabel}" Foreground="#FFD05A" FontWeight="Bold" FontSize="11" Margin="3,3,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="TopRatedEmptyText" Grid.Row="1" Text="Avalie episódios para montar este ranking." Foreground="#7897BD" Margin="4,28"/></Grid>
                </Grid>
            </Grid></ScrollViewer>
        </Grid>
    </Grid>
</Window>
