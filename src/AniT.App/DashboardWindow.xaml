<Window x:Class="AniT.App.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AniT" Width="1280" Height="780" MinWidth="1024" MinHeight="650" Background="#101114" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources><Style x:Key="Nav" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#AAB1C0"/><Setter Property="Padding" Value="15,11"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="8,2"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#292D38"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Window.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#181A20" BorderBrush="#292C35" BorderThickness="0,0,1,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="18,25"><StackPanel Orientation="Horizontal" Margin="0,0,0,27"><Border Width="35" Height="35" CornerRadius="10" Background="#F56B48"><TextBlock Text="A" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="AniT" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="Sua biblioteca de animes" Foreground="#80889A" FontSize="10"/></StackPanel></StackPanel><Button Style="{StaticResource Nav}" Content="⌂   Início" Foreground="White" Background="#292D38"/><Button Style="{StaticResource Nav}" Content="▦   Biblioteca" Click="Library_Click"/><Button Style="{StaticResource Nav}" Content="▶   Continuar assistindo" Click="Library_Click"/><Button Style="{StaticResource Nav}" Content="♡   Favoritos"/><Button Style="{StaticResource Nav}" Content="◷   Histórico"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,24"><Separator Background="#2B2F39" Margin="0,0,0,13"/><Button Style="{StaticResource Nav}" Content="⚙   Configurar estante" Click="ConfigureShelf_Click"/></StackPanel></DockPanel></Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="44,35"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Início" Foreground="White" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Seu diário de animes, em um só lugar." Foreground="#939BAD" FontSize="14" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="WelcomeText" DockPanel.Dock="Right" Foreground="#9299AA" VerticalAlignment="Center"/></DockPanel><WrapPanel Grid.Row="1" Margin="0,35,0,0"><Border Width="190" Height="105" Background="#1A1D24" CornerRadius="11" Margin="0,0,15,0" Padding="16"><StackPanel><TextBlock Text="ANIMES" Foreground="#838B9D" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="AnimeCountText" Text="0" Foreground="White" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border><Border Width="190" Height="105" Background="#1A1D24" CornerRadius="11" Margin="0,0,15,0" Padding="16"><StackPanel><TextBlock Text="EPISÓDIOS" Foreground="#838B9D" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="EpisodeCountText" Text="0" Foreground="White" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border><Border Width="190" Height="105" Background="#1A1D24" CornerRadius="11" Padding="16"><StackPanel><TextBlock Text="CONCLUÍDOS" Foreground="#838B9D" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="CompletedCountText" Text="0" Foreground="#79D89A" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border></WrapPanel><Border Grid.Row="2" Background="#1A1D24" BorderBrush="#2B2F39" BorderThickness="1" CornerRadius="13" Margin="0,29,0,0" Padding="26"><StackPanel><TextBlock Text="Continuar assistindo" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ContinueText" Text="Quando você começar um episódio, ele aparecerá aqui para continuar de onde parou." Foreground="#99A1B1" FontSize="14" Margin="0,13,0,0"/><Separator Background="#2C303B" Margin="0,26,0,20"/><TextBlock Text="Adicionados recentemente" Foreground="White" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="RecentText" Text="Sua estante ainda não tem animes identificados." Foreground="#99A1B1" FontSize="14" Margin="0,11,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid></ScrollViewer>
    </Grid>
</Window>
