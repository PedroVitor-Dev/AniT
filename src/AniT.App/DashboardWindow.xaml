<Window x:Class="AniT.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AniT" Width="1440" Height="900" MinWidth="1060" MinHeight="700"
        Background="#020B1D" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="HeroBanner" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.38"/>
                <DoubleAnimation Storyboard.TargetName="HeroEntrance" Storyboard.TargetProperty="Y" From="16" To="0" Duration="0:0:0.38"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MainBody" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.10" Duration="0:0:0.42"/>
                <DoubleAnimation Storyboard.TargetName="BodyEntrance" Storyboard.TargetProperty="Y" From="18" To="0" BeginTime="0:0:0.10" Duration="0:0:0.42"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.72,0.05" Center="0.72,0.05" RadiusX="0.95" RadiusY="1.05"><GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.43"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
                <Border Width="178"
                        Height="92"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,2,0,0">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/logo-fire.png"
                                    Viewbox="0,0.28,1,0.46"
                                    ViewboxUnits="RelativeToBoundingBox"
                                    Stretch="Uniform"/>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeActiveNavButton}" Content="⌂    Início"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="◉    Explorar" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="▱    Biblioteca" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="▣    Calendário"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="◷    Histórico" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="☆    Avaliações" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="♙    Perfil"/>
                    <Border Height="1" Background="#214874" Margin="20,18,20,11"/>
                    <TextBlock Text="SISTEMA" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,7"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="⚙    Configurar estante" Click="ConfigureShelf_Click"/>
                </StackPanel>
                <Image Grid.Row="2" Source="Assets/ghost_menu.png" Width="218" Height="218" Stretch="Uniform" Opacity="0.33" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-18,0,0,-30" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1">
                <Grid MaxWidth="2500" Margin="28,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#A9C7EC" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" ToolTip="Buscar animes e episódios" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/></Grid></Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource HomeTopButton}" Content="⌂  Início"/>
                        <Button Style="{StaticResource HomeTopButton}" Content="▶  Continuar" Click="ContinueTop_Click"/>
                        <Button x:Name="MyListTopButton" Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/>
                        <Button x:Name="CollectionsTopButton" Style="{StaticResource HomeTopButton}" Content="▱  Coleções" Click="Library_Click"/>
                        <Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/>
                        <Border Width="44" Height="44" CornerRadius="22" Background="#103461" BorderBrush="#4BC8FF" BorderThickness="1" ToolTip="Perfil (em breve)" Cursor="Hand"><Grid><Ellipse Fill="#153F70" Margin="3"/><TextBlock Text="♙" Foreground="#C9F0FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <Grid x:Name="MainContentHost" MaxWidth="2500" Margin="24,20,24,40" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="HeroBanner" Height="344" CornerRadius="20" Background="#50C9FF" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><TranslateTransform x:Name="HeroEntrance"/></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect Color="#168BFF" BlurRadius="25" ShadowDepth="0" Opacity="0.32"/></Border.Effect>
                        <Border x:Name="HeroContent" Tag="18" CornerRadius="18" Background="#071B38" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged">
                            <Grid>
                                <Image Source="{Binding HeroCoverPath}" Stretch="UniformToFill" Opacity="0.38"><Image.Effect><BlurEffect Radius="11"/></Image.Effect></Image>
                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF06172F" Offset="0"/><GradientStop Color="#F2071C3B" Offset="0.38"/><GradientStop Color="#A3071C3A" Offset="0.66"/><GradientStop Color="#4202172F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <Grid Margin="38,32">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="1080" HorizontalAlignment="Left">
                                        <Border Background="#183B68" BorderBrush="#347BAD" BorderThickness="1" CornerRadius="10" Padding="11,5" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#61D9FF" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="RETOME SUA HISTÓRIA" Foreground="#BFEFFF" FontSize="10" FontWeight="Bold"/></StackPanel></Border>
                                        <TextBlock x:Name="HeroTitleText" Text="{Binding HeroTitle}" Foreground="White" FontSize="40" FontWeight="Bold" Margin="0,13,0,0" TextWrapping="Wrap" MaxHeight="108"/>
                                        <TextBlock Text="{Binding HeroSubtitle}" Foreground="#D4E8FF" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,20,0,0" MaxWidth="540" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar Value="{Binding HeroProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding HeroProgressLabel}" Foreground="#BFEAFF" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Style="{StaticResource HomePrimaryButton}" Content="▶   Continuar assistindo" IsEnabled="{Binding CanPlayHero}" Click="HeroContinue_Click" MinWidth="196"/><Button Style="{StaticResource HomeOutlineButton}" Content="ⓘ   Ver detalhes" Click="HeroDetails_Click" Margin="14,0,0,0" MinWidth="158"/></StackPanel>
                                    </StackPanel>
                                    <Border x:Name="HeroArtwork" Grid.Column="1" Tag="17" Width="300" Height="278" CornerRadius="17" HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#4A97C9" BorderThickness="1" Background="#0A2243" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged">
                                        <Grid><Image Source="{Binding HeroCoverPath}" Stretch="UniformToFill" Opacity="0.92"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#05000000" Offset="0.34"/><GradientStop Color="#E0041530" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border x:Name="HeroQuotePanel" Background="#BC071A34" BorderBrush="#558EC0" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="16" VerticalAlignment="Bottom"><TextBlock x:Name="HeroQuoteText" Text="{Binding HeroQuote}" Foreground="#F5FAFF" FontFamily="Georgia" FontStyle="Italic" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="66"/></Border></Grid>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,18"><Ellipse x:Name="HeroDot0" Tag="0" Width="18" Height="7" Fill="#A8E7FF" Cursor="Hand" MouseLeftButtonDown="HeroDot_Click"/><Ellipse x:Name="HeroDot1" Tag="1" Width="7" Height="7" Fill="#315A89" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="HeroDot_Click"/><Ellipse x:Name="HeroDot2" Tag="2" Width="7" Height="7" Fill="#315A89" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="HeroDot_Click"/><Ellipse x:Name="HeroDot3" Tag="3" Width="7" Height="7" Fill="#315A89" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="HeroDot_Click"/></StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <Grid x:Name="MainBody" Grid.Row="1" Margin="0,24,0,0" Opacity="0">
                        <Grid.RenderTransform><TranslateTransform x:Name="BodyEntrance"/></Grid.RenderTransform>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightRailColumn" Width="320"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver biblioteca  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#163C67" BorderBrush="#2A679D" BorderThickness="1"><TextBlock Text="◷" Foreground="#75DCFF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,-2,0,0"><TextBlock Text="Continuar assistindo" Style="{StaticResource HomeSectionTitle}"/><TextBlock Text="Volte exatamente de onde parou" Foreground="{StaticResource HomeMutedBrush}" FontSize="11"/></StackPanel></StackPanel></DockPanel>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding ContinueCards}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding EpisodeId}" Click="ContinueCard_Click" Margin="0,0,14,16"><Border Width="286" Height="218" CornerRadius="16" BorderBrush="#2D6A9F" BorderThickness="1" Background="{StaticResource HomePanelBrush}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.46"/><GradientStop Color="#C403132C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border Width="42" Height="42" CornerRadius="21" Background="#DF0A2D55" BorderBrush="#A7EAFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"><TextBlock Text="▶" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/></Border></Grid><Grid Grid.Row="1" Margin="13,9,13,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><DockPanel Grid.Row="1" Margin="0,5,0,7"><TextBlock Text="{Binding Subtitle}" Foreground="#ABC7E8" FontSize="11" DockPanel.Dock="Left"/><TextBlock Text="{Binding ProgressLabel}" Foreground="#D9F5FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel><ProgressBar Grid.Row="2" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}"/></Grid></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="ContinueEmptyText" Background="#7A091C38" BorderBrush="#265A8A" BorderThickness="1" CornerRadius="16" Padding="24" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="▷" Foreground="#63D5FF" FontSize="28" VerticalAlignment="Center"/><StackPanel Margin="14,0,0,0"><TextBlock Text="Nenhum episódio em andamento" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Abra a biblioteca e comece uma nova história." Foreground="{StaticResource HomeMutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></StackPanel></Border>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,22,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#163C67" BorderBrush="#2A679D" BorderThickness="1"><TextBlock Text="✦" Foreground="#66D8FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,-2,0,0"><TextBlock Text="Adicionados recentemente" Style="{StaticResource HomeSectionTitle}"/><TextBlock Text="Novidades encontradas na sua estante" Foreground="{StaticResource HomeMutedBrush}" FontSize="11"/></StackPanel></StackPanel></DockPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentCards}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,14,14"><StackPanel Width="176"><Border Height="218" CornerRadius="15" ClipToBounds="True" BorderBrush="#2C659A" BorderThickness="1" Background="#0A1D3A"><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle VerticalAlignment="Bottom" Height="72"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="#D503122A" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Background="#CA0A2344" CornerRadius="8" Padding="8,4"><TextBlock Text="NOVO NA ESTANTE" Foreground="#BFEFFF" FontSize="9" FontWeight="Bold"/></Border></Grid></Border><TextBlock Text="{Binding Title}" Foreground="#F7FAFF" FontWeight="SemiBold" FontSize="13" Margin="3,8,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SecondaryText}" Foreground="#8EB4DF" FontSize="10" Margin="3,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="♥" Foreground="#6FDCFF" FontSize="22" VerticalAlignment="Center"/><TextBlock Text="Favoritos" Style="{StaticResource HomeSectionTitle}" Margin="10,0,0,0"/></StackPanel></DockPanel>
                                    <Grid Grid.Row="1" Margin="0,9,0,0">
                                        <ItemsControl ItemsSource="{Binding FavoriteCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,12,12"><StackPanel Width="154"><Border Height="174" CornerRadius="14" ClipToBounds="True" BorderBrush="#2B6599" BorderThickness="1"><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Border Width="32" Height="32" CornerRadius="16" Background="#E80B2447" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0"><TextBlock Text="♥" Foreground="#70DCFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="3,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <Border x:Name="FavoritesEmptyText" Background="#72091C38" BorderBrush="#265A8A" BorderThickness="1" CornerRadius="16" Padding="22" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="15" Background="#163C67"><TextBlock Text="♡" Foreground="#70DCFF" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,1,0,0"><TextBlock Text="Sua coleção favorita começa aqui" Foreground="White" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Marque títulos na biblioteca para encontrá-los mais rápido." Foreground="{StaticResource HomeMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="★" Foreground="#FFD15C" FontSize="22" VerticalAlignment="Center"/><TextBlock Text="Mais bem avaliados" Style="{StaticResource HomeSectionTitle}" Margin="10,0,0,0"/></StackPanel></DockPanel>
                                    <Grid Grid.Row="1" Margin="0,9,0,0">
                                        <ItemsControl ItemsSource="{Binding TopRatedCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,12,12"><StackPanel Width="154"><Border Height="174" CornerRadius="14" ClipToBounds="True" BorderBrush="#2B6599" BorderThickness="1"><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Border Background="#E9091C38" CornerRadius="9" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"><TextBlock Text="{Binding ScoreLabel}" Foreground="#FFD66C" FontWeight="Bold" FontSize="12"/></Border></Grid></Border><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="3,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <Border x:Name="TopRatedEmptyText" Background="#72091C38" BorderBrush="#265A8A" BorderThickness="1" CornerRadius="16" Padding="22" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="15" Background="#163C67"><TextBlock Text="☆" Foreground="#FFD15C" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,1,0,0"><TextBlock Text="Seu ranking ainda está vazio" Foreground="White" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Avalie episódios e seus destaques aparecem aqui." Foreground="{StaticResource HomeMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="RightRail" Grid.Column="1">
                            <Border CornerRadius="19" Background="#3DB9F2" BorderThickness="0" Padding="1.5" Height="286">
                                <Border x:Name="SessionContent" Tag="17.5" CornerRadius="17.5" Background="{StaticResource HomePanelBrush}" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged">
                                    <Grid><Image Source="Assets/ghost_background.png" Stretch="UniformToFill" Opacity="0.22" Margin="-24,-16,-24,-36" IsHitTestVisible="False"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00091D3A"/><GradientStop Color="#B1081B36" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,13" TextBlock.TextAlignment="Center"><Image Source="Assets/ghost_popcorn.png" Width="170" Height="136" Stretch="Uniform"/><TextBlock Text="Boa sessão!" Foreground="#F5FBFF" FontSize="21" FontWeight="Bold" Margin="0,-4,0,0"/><TextBlock Text="{Binding SessionMessage}" Foreground="#C4DDF5" FontSize="12" TextWrapping="Wrap" MaxWidth="220" Margin="0,7,0,0"/></StackPanel></Grid>
                                </Border>
                            </Border>
                            <Border Background="{StaticResource HomePanelBrush}" BorderBrush="#2F76AC" BorderThickness="1" CornerRadius="17" Margin="0,16,0,0" Padding="18,16">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Abrir  →" Click="Library_Click"/><StackPanel><TextBlock Text="SUA ESTANTE" Foreground="#67D4FF" FontSize="10" FontWeight="Bold"/><TextBlock Text="Visão rápida" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></DockPanel><Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding LibraryAnimeCount}" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="ANIMES" Foreground="#779CC8" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel><Border Grid.Column="1" Background="#28517D" Margin="0,3"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding LibraryEpisodeCount}" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="EPISÓDIOS" Foreground="#779CC8" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel><Border Grid.Column="3" Background="#28517D" Margin="0,3"/><StackPanel Grid.Column="4"><TextBlock Text="{Binding LibraryCompletedCount}" Foreground="#66D8FF" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="CONCLUÍDOS" Foreground="#779CC8" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Grid><TextBlock Grid.Row="2" Text="Títulos e capas permanecem salvos localmente." Foreground="#7899BE" FontSize="10" TextAlignment="Center" Margin="0,15,0,0"/></Grid>
                            </Border>
                            <Border Background="{StaticResource HomePanelBrush}" BorderBrush="#2F76AC" BorderThickness="1" CornerRadius="17" Margin="0,16,0,0" Padding="18,15" MinHeight="180">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#66D8FF" FontSize="18"/><TextBlock Text="Próximos da estante" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0"/></StackPanel></DockPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarItems}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#6A102B50" CornerRadius="10" Padding="10,9" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Border Background="#194873" CornerRadius="7" Padding="6,3" HorizontalAlignment="Left"><TextBlock Text="{Binding DayLabel}" Foreground="#84DFFF" FontSize="9" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#E7F2FF" FontSize="11" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding EpisodeLabel}" Foreground="#A9C8E8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
