<Window x:Class="AniT.App.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AniT" Width="1280" Height="780" MinWidth="1024" MinHeight="650" Background="#070B16" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Activated="Window_Activated">
    <Window.Resources>
        <Style x:Key="Nav" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#A4B7D6"/><Setter Property="Padding" Value="14,11"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="6,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#17233A"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="#E6121B2E"/><Setter Property="BorderBrush" Value="#273955"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.74,0.08" Center="0.74,0.08" RadiusX="0.75" RadiusY="0.85"><GradientStop Color="#132B56" Offset="0"/><GradientStop Color="#070B16" Offset="0.54"/><GradientStop Color="#050810" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#0A1020" BorderBrush="#253550" BorderThickness="0,0,1,0"><DockPanel Margin="14,18">
            <StackPanel DockPanel.Dock="Top">
                <Border Width="205" Height="72" HorizontalAlignment="Center" Margin="0,2,0,30"><Border.Background><ImageBrush ImageSource="Assets/logo-letter-white.png" Viewbox="0.04,0.20,0.92,0.45" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
                <TextBlock Text="NAVEGAÇÃO" Foreground="#607A9F" FontWeight="SemiBold" FontSize="10" Margin="13,0,0,8"/>
                <Button Style="{StaticResource Nav}" Content="⌂   Visão geral" Foreground="White" Background="#1C365A"/>
                <Button Style="{StaticResource Nav}" Content="▦   Biblioteca" Click="Library_Click"/>
                <Button Style="{StaticResource Nav}" Content="▶   Continuar assistindo" Click="Library_Click"/>
                <Button Style="{StaticResource Nav}" Content="♡   Favoritos"/>
                <Button Style="{StaticResource Nav}" Content="◷   Histórico"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#243550" Margin="6,0,6,12"/><Button Style="{StaticResource Nav}" Content="⚙   Configurar estante" Click="ConfigureShelf_Click"/></StackPanel>
        </DockPanel></Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="46,38"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Olá, otaku." Foreground="White" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Seu espaço pessoal para acompanhar cada história." Foreground="#9DB2D0" FontSize="14" Margin="0,7,0,0"/></StackPanel><Border DockPanel.Dock="Right" Width="230" Height="38" Background="#101A2C" BorderBrush="#29415F" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="18,-20,0,0" VerticalAlignment="Top"><TextBlock x:Name="WelcomeText" Foreground="#9DBBE0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></DockPanel>
            <Grid Grid.Row="1" Margin="0,34,0,0">
                <Image Source="Assets/normal-sf.png" Width="290" Height="245" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-82,34,-54" Opacity="0.24" IsHitTestVisible="False"/>
                <UniformGrid Columns="3"><Border Style="{StaticResource MetricCard}" Height="105"><StackPanel><TextBlock Text="ANIMES" Foreground="#7795BA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="AnimeCountText" Text="0" Foreground="White" FontSize="33" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}" Height="105"><StackPanel><TextBlock Text="EPISÓDIOS" Foreground="#7795BA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="EpisodeCountText" Text="0" Foreground="White" FontSize="33" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource MetricCard}" Height="105"><StackPanel><TextBlock Text="CONCLUÍDOS" Foreground="#7795BA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CompletedCountText" Text="0" Foreground="#65C4FF" FontSize="33" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
            </Grid>
            <Border Grid.Row="2" Background="#10192A" BorderBrush="#2B405F" BorderThickness="1" CornerRadius="18" Margin="0,28,0,32" Padding="28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Continuar assistindo" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ContinueText" Text="Quando você começar um episódio, ele aparecerá aqui para continuar de onde parou." Foreground="#9EB1CF" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/><Separator Background="#2A3B57" Margin="0,27,0,20"/><TextBlock Text="ADICIONADOS RECENTEMENTE" Foreground="#6F8CB1" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RecentText" Foreground="#D5E4FA" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" CornerRadius="14" Background="#0B1322" BorderBrush="#253A59" BorderThickness="1" Margin="18,0,0,0"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="✦" Foreground="#49AEFF" FontSize="35" HorizontalAlignment="Center"/><TextBlock Text="Seu progresso&#x0a;é só seu." Foreground="#AFC8E8" FontSize="12" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border></Grid></Border>
        </Grid></ScrollViewer>
    </Grid>
</Window>
