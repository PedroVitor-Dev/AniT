<Window x:Class="AniT.App.DashboardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AniT.App" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="AniT" Width="1440" Height="900" MinWidth="1060" MinHeight="700" Background="{DynamicResource AniT.Background}"
 WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged"
 UseLayoutRounding="True" SnapsToDevicePixels="True" local:StableWindowRendering.Enabled="True">
 <Grid Background="{DynamicResource AniT.Background}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <local:CinematicSidebar x:Name="ShellSidebar" Section="Home"/>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <local:CinematicHeader x:Name="ShellHeader" SearchChanged="SearchBox_TextChanged" SearchSubmitted="SearchBox_KeyDown" ActionRequested="ContinueTop_Click" ActionLabel="{Binding HeroActionLabel}"/>
   <ScrollViewer x:Name="HomeScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False" BorderThickness="0">
    <Grid x:Name="MainContentHost" MaxWidth="2100" Margin="28,24,28,40" SizeChanged="Content_SizeChanged">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,24"><TextBlock Text="Seu próximo episódio espera." FontSize="{DynamicResource AniT.TitleSize}" FontWeight="SemiBold" Foreground="{DynamicResource AniT.Text}" TextWrapping="Wrap"/><TextBlock Text="Suas histórias, no seu ritmo." Style="{DynamicResource AniT.Caption}" Margin="0,6,0,0"/></StackPanel>
     <Border x:Name="HeroBanner" Grid.Row="1" MinHeight="300" Style="{DynamicResource AniT.Panel}" Padding="32" MouseEnter="HeroPointer_Changed" MouseLeave="HeroPointer_Changed" IsKeyboardFocusWithinChanged="HeroFocus_Changed">
      <Grid x:Name="HeroLayout">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
        <TextBlock Text="{Binding HeroEyebrow}" Style="{DynamicResource AniT.Caption}" FontWeight="SemiBold"/>
        <TextBlock x:Name="HeroTitleText" Text="{Binding HeroTitle}" FontSize="{DynamicResource Home.HeroTitleSize}" FontWeight="SemiBold" Foreground="{DynamicResource AniT.Text}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding HeroSubtitle}" Style="{DynamicResource AniT.Body}" Foreground="{DynamicResource AniT.Muted}" Margin="0,10,0,0"/>
        <StackPanel x:Name="HeroProgressPanel" Margin="0,20,0,0">
         <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding CanPlayHero}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <TextBlock Text="{Binding HeroProgressLabel}" Style="{DynamicResource AniT.Caption}" Margin="0,0,0,8"/>
         <ProgressBar Value="{Binding HeroProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource AniT.Progress}" AutomationProperties.Name="Progresso do episódio em destaque"/>
        </StackPanel>
        <WrapPanel Margin="0,24,0,0">
         <ui:Button x:Name="HeroPrimaryAction" Content="{Binding HeroActionLabel}" Style="{DynamicResource AniT.Button.Primary}" Click="HeroContinue_Click" Margin="0,0,12,8"/>
         <ui:Button Content="Ver detalhes" Style="{DynamicResource AniT.Button.Secondary}" Visibility="{Binding HasHeroAnime, Converter={StaticResource Home.BoolVisibility}}" Click="HeroDetails_Click" Margin="0,0,0,8"/>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="-4,8,0,0">
         <Button x:Name="HeroDot0" Tag="0" Style="{StaticResource Home.Dot}" Click="HeroDot_Click" AutomationProperties.Name="Mostrar destaque 1"/>
         <Button x:Name="HeroDot1" Tag="1" Style="{StaticResource Home.Dot}" Click="HeroDot_Click" AutomationProperties.Name="Mostrar destaque 2"/>
         <Button x:Name="HeroDot2" Tag="2" Style="{StaticResource Home.Dot}" Click="HeroDot_Click" AutomationProperties.Name="Mostrar destaque 3"/>
         <Button x:Name="HeroDot3" Tag="3" Style="{StaticResource Home.Dot}" Click="HeroDot_Click" AutomationProperties.Name="Mostrar destaque 4"/>
        </StackPanel>
       </StackPanel>
       <Border Tag="Artwork" x:Name="HeroArtwork" Grid.Column="1" Height="280" Background="Transparent" BorderThickness="0" CornerRadius="{DynamicResource AniT.ControlRadius}" SizeChanged="RoundedPanel_SizeChanged">
        <Grid><Image x:Name="HeroCoverImage" Source="{Binding HeroArtworkPath}" Loaded="Cover_Loaded" Stretch="Uniform"/></Grid>
       </Border>
      </Grid>
     </Border>
     <Grid x:Name="MainBody" Grid.Row="2" Margin="0,32,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightRailColumn" Width="300"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="HomeSectionsHost" Margin="0,0,24,0">
       <StackPanel x:Name="ContinueSection">
        <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Ver biblioteca →" Style="{StaticResource Home.Link}" Click="Library_Click"/><TextBlock Text="Continuar assistindo" Style="{DynamicResource AniT.Section}" VerticalAlignment="Center"/></DockPanel>
        <ItemsControl x:Name="ContinueList" ItemsSource="{Binding ContinueCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Button Style="{StaticResource AniT.PosterAction}" Click="ContinueCard_Click" Margin="0,0,16,16" AutomationProperties.Name="{Binding Title}">
          <StackPanel Width="280">
           <Border Tag="Artwork" Height="158" CornerRadius="{DynamicResource AniT.ControlRadius}" Background="{DynamicResource AniT.Raised}" SizeChanged="RoundedPanel_SizeChanged"><Grid><Image Source="{Binding CoverPath}" Loaded="Cover_Loaded" Stretch="UniformToFill"/></Grid></Border>
           <TextBlock Text="{Binding Title}" Style="{DynamicResource AniT.Body}" FontWeight="SemiBold" Margin="0,12,0,0"/>
           <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource AniT.Caption}" Margin="0,4,0,8"/>
           <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource AniT.Progress}"/>
           <TextBlock Text="{Binding ProgressLabel}" Style="{DynamicResource AniT.Caption}" Margin="0,6,0,0"/>
          </StackPanel>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Border x:Name="ContinueEmptyText" Style="{DynamicResource AniT.EmptyState}" Visibility="Collapsed"><StackPanel><TextBlock Text="Uma nova história começa com um episódio." Style="{DynamicResource AniT.Body}" FontWeight="SemiBold"/><TextBlock Text="Escolha um título da sua biblioteca para continuar por aqui." Style="{DynamicResource AniT.Caption}" Margin="0,6,0,0"/><Button Content="Escolher na biblioteca →" Style="{StaticResource Home.Link}" Click="Library_Click" HorizontalAlignment="Left" Margin="-10,12,0,0"/></StackPanel></Border>
       </StackPanel>
       <StackPanel x:Name="RecentSection" Margin="0,28,0,0">
        <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Ver todos →" Style="{StaticResource Home.Link}" Click="Library_Click"/><TextBlock Text="Adicionados recentemente" Style="{DynamicResource AniT.Section}" VerticalAlignment="Center"/></DockPanel>
        <ItemsControl x:Name="RecentList" ItemsSource="{Binding RecentCards}" ItemTemplate="{StaticResource Home.PosterTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <Border x:Name="RecentEmptyText" Style="{DynamicResource AniT.EmptyState}" Visibility="Collapsed"><StackPanel><TextBlock Text="Sua estante está pronta para receber histórias." Style="{DynamicResource AniT.Body}"/><TextBlock Text="Adicione uma pasta na Biblioteca. Os títulos encontrados aparecem aqui." Style="{DynamicResource AniT.Caption}" Margin="0,6,0,0"/></StackPanel></Border>
       </StackPanel>
       <Grid x:Name="HighlightsSection" Margin="0,28,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="FavoritesGroup">
         <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Ver todos →" Style="{StaticResource Home.Link}" Click="Library_Click"/><TextBlock Text="Favoritos" Style="{DynamicResource AniT.Section}" VerticalAlignment="Center"/></DockPanel>
         <ItemsControl ItemsSource="{Binding FavoriteCards}" ItemTemplate="{StaticResource Home.PosterTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
         <Border x:Name="FavoritesEmptyText" Style="{DynamicResource AniT.EmptyState}" Visibility="Collapsed"><TextBlock Text="Marque seus títulos favoritos na Biblioteca para encontrá-los com facilidade." Style="{DynamicResource AniT.Caption}"/></Border>
        </StackPanel>
        <StackPanel x:Name="TopRatedGroup" Grid.Column="2">
         <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Ver todos →" Style="{StaticResource Home.Link}" Click="Library_Click"/><TextBlock Text="Mais bem avaliados" Style="{DynamicResource AniT.Section}" VerticalAlignment="Center"/></DockPanel>
         <ItemsControl ItemsSource="{Binding TopRatedCards}" ItemTemplate="{StaticResource Home.PosterTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
         <Border x:Name="TopRatedEmptyText" Style="{DynamicResource AniT.EmptyState}" Visibility="Collapsed"><TextBlock Text="Suas avaliações ajudam a destacar as histórias que mais valem a pena." Style="{DynamicResource AniT.Caption}"/></Border>
        </StackPanel>
       </Grid>
      </StackPanel>
      <StackPanel x:Name="RightRail" Grid.Column="1">
       <Border Style="{DynamicResource AniT.Card}"><StackPanel><TextBlock Text="SUA ESTANTE" Style="{DynamicResource AniT.Caption}"/><TextBlock Text="Visão rápida" Style="{DynamicResource AniT.Section}" Margin="0,8,0,16"/><WrapPanel><StackPanel MinWidth="76" Margin="0,0,12,16"><TextBlock Text="{Binding LibraryAnimeCount}" FontSize="{DynamicResource AniT.TitleSize}" Foreground="{DynamicResource AniT.Text}" FontWeight="SemiBold"/><TextBlock Text="Animes" Style="{DynamicResource AniT.Caption}"/></StackPanel><StackPanel MinWidth="76" Margin="0,0,12,16"><TextBlock Text="{Binding LibraryEpisodeCount}" FontSize="{DynamicResource AniT.TitleSize}" Foreground="{DynamicResource AniT.Text}" FontWeight="SemiBold"/><TextBlock Text="Episódios" Style="{DynamicResource AniT.Caption}"/></StackPanel><StackPanel MinWidth="76" Margin="0,0,0,16"><TextBlock Text="{Binding LibraryCompletedCount}" FontSize="{DynamicResource AniT.TitleSize}" Foreground="{DynamicResource AniT.Text}" FontWeight="SemiBold"/><TextBlock Text="Concluídos" Style="{DynamicResource AniT.Caption}"/></StackPanel></WrapPanel><Button Content="Abrir biblioteca →" Style="{StaticResource Home.Link}" Click="Library_Click" HorizontalAlignment="Left" Margin="-10,0,0,0"/></StackPanel></Border>
       <Border Style="{DynamicResource AniT.Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="NO SEU RITMO" Style="{DynamicResource AniT.Caption}"/><TextBlock Text="{Binding SessionMessage}" Style="{DynamicResource AniT.Body}" Margin="0,10,0,0"/><TextBlock Text="{Binding HeroQuote}" Style="{DynamicResource AniT.Caption}" FontStyle="Italic" Margin="0,12,0,0"/><TextBlock Text="Sua coleção permanece neste computador." Style="{DynamicResource AniT.Caption}" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{DynamicResource AniT.Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Próximos da estante" Style="{DynamicResource AniT.Section}" Margin="0,0,0,14"/><ItemsControl ItemsSource="{Binding CalendarItems}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,14"><TextBlock Text="{Binding Title}" Style="{DynamicResource AniT.Body}"/><TextBlock Text="{Binding EpisodeLabel}" Style="{DynamicResource AniT.Caption}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Ver biblioteca →" Style="{StaticResource Home.Link}" Click="Library_Click" HorizontalAlignment="Left" Margin="-10,0,0,0"/></StackPanel></Border>
      </StackPanel>
     </Grid>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
