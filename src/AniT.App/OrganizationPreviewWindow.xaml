<Window x:Class="AniT.App.OrganizationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prévia de organização · AniT" Width="1040" Height="720" MinWidth="760" MinHeight="560"
        Background="#070B16" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PreviewCard" TargetType="Border"><Setter Property="Background" Value="#0D182A"/><Setter Property="BorderBrush" Value="#294564"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="15"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Organizar biblioteca" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Prévia obrigatória — nenhum arquivo será movido antes da sua confirmação." Foreground="#90ACCE" Margin="0,6,0,0"/></StackPanel><Image Grid.Column="1" Source="Assets/normal-sf.png" Width="70" Opacity="0.75"/></Grid>
        <Border Grid.Row="1" Background="#0D182A" BorderBrush="#294564" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,18,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Destino base" Foreground="#BBD2EC" FontWeight="SemiBold"/><TextBlock x:Name="DestinationText" Text="Escolha onde criar as pastas organizadas" Foreground="#7896BA" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Style="{StaticResource BrandButton}" Content="Escolher e gerar prévia" Click="ChooseDestination_Click"/></Grid></Border>
        <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding PreviewItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PreviewCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanExecute}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="ANTES" Foreground="#6487AD" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding SourcePath}" Foreground="#AFC5DF" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="DEPOIS" Foreground="#42BBFF" FontSize="9" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="{Binding DestinationPath}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#F0AE70" FontSize="10" Margin="0,6,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center"><TextBlock Text="Nada será alterado sem uma prévia" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Escolha o destino para visualizar cada operação Antes → Depois." Foreground="#86A2C4" Margin="0,8,0,0"/></StackPanel></Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Foreground="#88A8CD" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Padding="18,10" Margin="0,0,10,0" Click="Cancel_Click"/><Button x:Name="ExecuteButton" Style="{StaticResource BrandButton}" Content="Executar selecionados" IsEnabled="False" Click="Execute_Click"/></StackPanel></Grid>
    </Grid>
</Window>
