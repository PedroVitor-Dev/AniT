<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:AniT.App" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AniT.App.OnboardingWindow" Title="Bem-vindo ao AniT" Width="1040" Height="740" MinWidth="580" MinHeight="420" WindowStartupLocation="CenterScreen" Background="{DynamicResource AniT.Brush.Background}" Foreground="{DynamicResource AniT.Brush.TextPrimary}" FontFamily="Segoe UI" Icon="/AniT;component/Assets/anit.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ScrollViewer">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="{DynamicResource Onboarding.Font15}" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
                <Setter Property="Foreground" Value="{DynamicResource AniT.Brush.TextSecondary}" />
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AniT.Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AniT.Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource Onboarding.CornerRadius}" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style x:Key="OnboardingButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="{DynamicResource Onboarding.Font15}" />
                <Setter Property="Padding" Value="16,10" />
            </Style>
            <Style x:Key="OnboardingInput" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="{DynamicResource Onboarding.Font15}" />
                <Setter Property="Padding" Value="16,10" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="RootGrid" SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="StoryColumn" Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="StoryPanel" Padding="28,32" Background="{DynamicResource Onboarding.Sidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="BrandLogo" Width="132" Height="60" Stretch="Uniform" HorizontalAlignment="Left" local:ComfortableImageSource.AutoOptimize="False" AutomationProperties.Name="AniT">
                            <Image.Source>
                                <CroppedBitmap SourceRect="0,330,1254,580">
                                    <CroppedBitmap.Source>
                                        <BitmapImage UriSource="/AniT;component/Assets/logo-fire.png" />
                                    </CroppedBitmap.Source>
                                </CroppedBitmap>
                            </Image.Source>
                        </Image>
                    </StackPanel>
                    <TextBlock Text="CONFIGURAÇÃO INICIAL" FontSize="{DynamicResource Onboarding.Font10}" FontWeight="SemiBold" Foreground="{DynamicResource AniT.Brush.TextSecondary}" Margin="0,14,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Image Source="/AniT;component/Assets/happy-sf.png" Width="152" Height="160" Stretch="Uniform" local:ComfortableImageSource.AutoOptimize="False" />
                    <TextBlock Text="01   Boas-vindas" FontSize="{DynamicResource Onboarding.Font14}" Margin="0,18,0,0" Foreground="{DynamicResource AniT.Brush.TextSecondary}" x:Name="StepLabel0" />
                    <TextBlock Text="02   Perfil" FontSize="{DynamicResource Onboarding.Font14}" Margin="0,18,0,0" Foreground="{DynamicResource AniT.Brush.TextSecondary}" x:Name="StepLabel1" />
                    <TextBlock Text="03   Pasta de animes" FontSize="{DynamicResource Onboarding.Font14}" Margin="0,18,0,0" Foreground="{DynamicResource AniT.Brush.TextSecondary}" x:Name="StepLabel2" />
                    <TextBlock Text="04   Revisão" FontSize="{DynamicResource Onboarding.Font14}" Margin="0,18,0,0" Foreground="{DynamicResource AniT.Brush.TextSecondary}" x:Name="StepLabel3" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="30,28" MaxWidth="680" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="StepText" FontSize="{DynamicResource Onboarding.Font11}" FontWeight="SemiBold" Foreground="{DynamicResource AniT.Brush.AccentCyan}" />
                <ProgressBar x:Name="StepProgress" Height="3" Maximum="4" Margin="0,12,0,24" Foreground="{DynamicResource AniT.Brush.AccentBlue}" Background="{DynamicResource AniT.Brush.Surface}" AutomationProperties.Name="Progresso da configuração">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                <Grid x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>
            <ScrollViewer x:Name="StepScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}">
                <StackPanel Margin="8,8,18,20">
                    <TextBlock x:Name="Heading" FontSize="{DynamicResource Onboarding.Font32}" FontWeight="SemiBold" />
                    <StackPanel x:Name="WelcomeStep">
                        <TextBlock Style="{StaticResource Body}" Text="Configure seu perfil e selecione a pasta dos seus animes." />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="{DynamicResource Onboarding.CornerRadius}" Background="{DynamicResource AniT.Brush.SurfaceSelected}" VerticalAlignment="Top">
                                    <TextBlock Text="01" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Perfil" FontSize="{DynamicResource Onboarding.Font16}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Body}" Text="Escolha um nome e uma foto, se quiser." FontSize="{DynamicResource Onboarding.Font14}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="{DynamicResource Onboarding.CornerRadius}" Background="{DynamicResource AniT.Brush.SurfaceSelected}" VerticalAlignment="Top">
                                    <TextBlock Text="02" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Pasta de animes" FontSize="{DynamicResource Onboarding.Font16}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Body}" Text="Selecione a pasta principal ou configure depois." FontSize="{DynamicResource Onboarding.Font14}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource AniT.Brush.TextMuted}" FontSize="{DynamicResource Onboarding.Font13}" Margin="0,22,0,0" Text="Sem cadastro. Seus perfis e seu progresso ficam neste computador." />
                    </StackPanel>
                    <StackPanel x:Name="ProfileStep" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Body}" Text="Nome e foto são opcionais. Você pode alterá-los depois no perfil." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Width="106" Height="106" CornerRadius="53" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <Border.Background>
                                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" ImageSource="/AniT;component/Assets/Profile/1.png" />
                                    </Border.Background>
                                </Border>
                                <WrapPanel>
                                    <ui:Button Content="Escolher _foto" Style="{StaticResource OnboardingButton}" Click="ChooseAvatar_Click" Margin="0,0,10,8" />
                                    <ui:Button Content="Usar _padrão" Style="{StaticResource OnboardingButton}" Click="ResetAvatar_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                                <Label Content="Seu _nome (opcional)" Target="{Binding ElementName=NameBox}" Foreground="{DynamicResource AniT.Brush.TextSecondary}" Padding="0" Margin="0,16,0,8" />
                                <ui:TextBox x:Name="NameBox" Style="{StaticResource OnboardingInput}" MaxLength="32" FontSize="{DynamicResource Onboarding.Font17}" AutomationProperties.Name="Nome do perfil, opcional" PlaceholderText="Meu perfil" />
                                <TextBlock Text="Se deixar em branco, usaremos Meu perfil." Style="{StaticResource Body}" FontSize="{DynamicResource Onboarding.Font12}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="FolderStep" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Body}" Text="Escolha a pasta onde você guarda seus animes. O AniT vai procurar episódios nela e nas subpastas." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PASTA PRINCIPAL" FontSize="{DynamicResource Onboarding.Font11}" FontWeight="SemiBold" Foreground="{DynamicResource AniT.Brush.AccentCyan}" />
                                <TextBlock x:Name="FolderText" Text="Nenhuma pasta selecionada" FontSize="{DynamicResource Onboarding.Font15}" Margin="0,12,0,18" />
                                <ui:Button Content="_Escolher pasta" Style="{StaticResource OnboardingButton}" HorizontalAlignment="Left" Click="ChooseFolder_Click" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Body}" Text="A busca apenas lê seus arquivos. Seus vídeos não serão movidos, renomeados ou apagados." />
                        <ui:Button x:Name="SkipFolderButton" Content="Configurar a pasta _depois" Style="{StaticResource OnboardingButton}" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SkipFolder_Click" />
                    </StackPanel>
                    <StackPanel x:Name="ReadyStep" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Body}" Text="Confira o perfil e a pasta selecionada antes de concluir." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SEU PERFIL" FontSize="{DynamicResource Onboarding.Font11}" Foreground="{DynamicResource AniT.Brush.AccentCyan}" />
                                <TextBlock x:Name="SummaryName" FontSize="{DynamicResource Onboarding.Font22}" FontWeight="SemiBold" Margin="0,7,0,22" />
                                <TextBlock Text="PASTA DE ANIMES" FontSize="{DynamicResource Onboarding.Font11}" Foreground="{DynamicResource AniT.Brush.AccentCyan}" />
                                <TextBlock x:Name="SummaryFolder" FontSize="{DynamicResource Onboarding.Font14}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Body}" Text="Altere o nome e a foto em Perfil. A pasta pode ser alterada em Configurações → Estante." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="8,16,8,0">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource AniT.Brush.Danger}" FontSize="{DynamicResource Onboarding.Font13}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
                <Grid Margin="4,4,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="BackButton" Content="_Voltar" Style="{StaticResource OnboardingButton}" Click="Back_Click" />
                    <ui:Button x:Name="NextButton" Grid.Column="2" Content="_Começar" Style="{StaticResource OnboardingButton}" Click="Next_Click" IsDefault="True" Appearance="Primary" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>