<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- These templates are scoped to Movie Theater. All reading surfaces follow the app theme. -->
    <Style x:Key="CinemaAction" TargetType="Button">
        <Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="20,12"/>
        <Setter Property="Background" Value="{DynamicResource AniT.Brush.SurfaceAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource AniT.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AniT.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid>
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <Border x:Name="Focus" BorderBrush="{DynamicResource AniT.Brush.AccentCyan}" BorderThickness="2" CornerRadius="15" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AniT.Brush.AccentCyan}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CinemaMode" TargetType="RadioButton">
        <Setter Property="Background" Value="{DynamicResource AniT.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource AniT.Brush.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="24"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid>
                <Border x:Name="Card" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource AniT.Brush.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Border>
                <Border x:Name="Selection" CornerRadius="18" BorderBrush="{DynamicResource AniT.Brush.AccentBlueStrong}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Background="{DynamicResource AniT.Brush.SurfaceAlt}" BorderBrush="{DynamicResource AniT.Brush.Border}" BorderThickness="1" IsHitTestVisible="False">
                    <TextBlock x:Name="Check" Text="✓" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AniT.Brush.AccentCyan}" Visibility="Collapsed"/>
                </Border>
                <Border x:Name="Focus" CornerRadius="21" BorderBrush="{DynamicResource AniT.Brush.TextPrimary}" BorderThickness="2" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource AniT.Brush.SurfaceAlt}"/><Setter TargetName="Selection" Property="Opacity" Value="0.45"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Selection" Property="Opacity" Value="1"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CinemaTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource AniT.Brush.TextSecondary}"/><Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="44"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Border x:Name="Tab" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="10" Margin="0,0,8,8" BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AniT.Brush.SurfaceAlt}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AniT.Brush.SurfaceAlt}"/><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AniT.Brush.AccentCyan}"/><Setter Property="Foreground" Value="{DynamicResource AniT.Brush.TextPrimary}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AniT.Brush.TextPrimary}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CinemaProgress" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource AniT.Brush.SurfaceAlt}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
            <Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                <Border x:Name="PART_Indicator" Background="{DynamicResource AniT.Brush.AccentCyan}" CornerRadius="4" HorizontalAlignment="Left"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CinemaScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Margin="2,0">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" Background="{DynamicResource AniT.Brush.Border}" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource AniT.Brush.AccentBlueStrong}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
