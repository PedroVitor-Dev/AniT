<Window x:Class="AniT.App.SetupShelfWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preparar sua estante · AniT" Width="580" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#17191F">
    <Window.Resources><Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#F56B48"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="19,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
    <Grid Margin="43,38"><StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#F56B48" HorizontalAlignment="Left"><TextBlock Text="A" Foreground="White" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="Vamos preparar sua estante" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock Text="Escolha a pasta principal onde ficam seus animes. O AniT identifica os episódios e mantém tudo no seu computador." Foreground="#A2A9B8" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/><Border Background="#222631" BorderBrush="#303541" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,27,0,0"><TextBlock x:Name="FolderText" Text="Nenhuma pasta selecionada" Foreground="#C9CED9" TextTrimming="CharacterEllipsis"/></Border><StackPanel Orientation="Horizontal" Margin="0,19,0,0"><Button Style="{StaticResource Primary}" Content="Escolher pasta" Click="ChooseFolder_Click"/><Button x:Name="FinishButton" Content="Começar" Click="Finish_Click" IsEnabled="False" Margin="11,0,0,0" Padding="19,11"/><TextBlock x:Name="StatusText" Foreground="#8E96A7" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></StackPanel></Grid>
</Window>
