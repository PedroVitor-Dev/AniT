<Window x:Class="AniT.App.SetupShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar estante · AniT"
        Width="620" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#07172E">
    <Window.Resources>
        <Style x:Key="ShelfButton" TargetType="Button">
            <Setter Property="Background" Value="#13345B"/>
            <Setter Property="Foreground" Value="#D9EBFF"/>
            <Setter Property="BorderBrush" Value="#2B659B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1B4A7F"/><Setter TargetName="Surface" Property="BorderBrush" Value="#48BCFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.76"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryShelfButton" TargetType="Button" BasedOn="{StaticResource ShelfButton}">
            <Setter Property="Background" Value="#27A8F6"/>
            <Setter Property="BorderBrush" Value="#52CDFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="44,34">
        <StackPanel>
            <Border Width="50" Height="50" CornerRadius="15" Background="#149CEB" HorizontalAlignment="Left">
                <TextBlock Text="A" Foreground="White" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ShelfTitleText" Text="Prepare sua estante" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <TextBlock x:Name="ShelfDescriptionText" Text="Defina a única pasta principal que o AniT deve organizar. Ela ficará fixada até você entrar no modo de edição e salvar outra pasta." Foreground="#A8BFDA" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>

            <Border Background="#0C2343" BorderBrush="#285E8E" BorderThickness="1" CornerRadius="11" Padding="17,14" Margin="0,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DIRETÓRIO PRINCIPAL" Foreground="#5DAFE5" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FolderText" Text="Nenhuma pasta selecionada" Foreground="#EDF7FF" FontSize="13" FontWeight="Medium" Margin="0,5,12,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border x:Name="LockBadge" Grid.Column="1" Background="#183B62" BorderBrush="#367CAE" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0"><Canvas Width="16" Height="16"><Path Data="M4,7 L4,5 C4,2.8 5.8,1 8,1 C10.2,1 12,2.8 12,5 L12,7 M3,7 L13,7 13,15 3,15 Z" Stroke="#78D8FF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/></Canvas></Viewbox>
                            <TextBlock Text="FIXADA" Foreground="#8DDEFF" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="EditButton" Style="{StaticResource PrimaryShelfButton}" Content="Editar" Click="Edit_Click" Visibility="Collapsed"/>
                <Button x:Name="ChooseFolderButton" Style="{StaticResource PrimaryShelfButton}" Content="Escolher pasta" Click="ChooseFolder_Click"/>
                <Button x:Name="FinishButton" Style="{StaticResource ShelfButton}" Content="Salvar" Click="Finish_Click" IsEnabled="False" Margin="10,0,0,0"/>
                <Button x:Name="CancelEditButton" Style="{StaticResource ShelfButton}" Content="Cancelar" Click="CancelEdit_Click" Margin="10,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="#8FAECB" FontSize="12" TextWrapping="Wrap" Margin="2,13,0,0"/>
        </StackPanel>
    </Grid>
</Window>
