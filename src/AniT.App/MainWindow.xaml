<Window x:Class="AniT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AniT.App"
        mc:Ignorable="d"
        Title="AniT" Height="780" Width="1280" MinHeight="650" MinWidth="1024"
        Background="#101114" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavigationItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#A9AFBE"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="8,2"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#232630"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F56B48"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="20,12"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF805F"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#181A20" BorderBrush="#292C35" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,25,18,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28"><Border Width="34" Height="34" CornerRadius="10" Background="#F56B48"><TextBlock Text="A" FontWeight="Bold" FontSize="19" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="AniT" FontWeight="Bold" FontSize="20" Foreground="White"/><TextBlock Text="Sua biblioteca de animes" FontSize="10" Foreground="#7F8799"/></StackPanel></StackPanel>
                    <Button Style="{StaticResource NavigationItem}" Foreground="White" Background="#282C38" Content="⌂   Início"/><Button Style="{StaticResource NavigationItem}" Content="▦   Biblioteca" Click="OpenLibrary_Click"/><Button Style="{StaticResource NavigationItem}" Content="▶   Continuar assistindo"/><Button Style="{StaticResource NavigationItem}" Content="♡   Favoritos"/><Button Style="{StaticResource NavigationItem}" Content="◷   Histórico"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,24"><Separator Background="#2A2D36" Margin="0,0,0,14"/><Button Style="{StaticResource NavigationItem}" Content="⚙   Configurações"/></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="44,35">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Início" Foreground="White" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Sua coleção começa aqui." Foreground="#9299AA" FontSize="14" Margin="0,6,18,0" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="1" Background="#1C1F27" CornerRadius="8" Width="220" Height="38" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="⌕  Pesquisar na biblioteca" Foreground="#767E91" VerticalAlignment="Center" Margin="13,0" FontSize="12"/></Border></Grid>
            <Border Grid.Row="1" Background="#17191F" CornerRadius="16" Margin="0,39,0,0" BorderBrush="#292D37" BorderThickness="1"><Grid><StackPanel Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center"><Border Width="82" Height="82" CornerRadius="41" Background="#262A34" HorizontalAlignment="Center" Margin="0,0,0,22"><TextBlock Text="✦" Foreground="#F56B48" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="Sua estante está esperando" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Adicione uma pasta com seus animes. O AniT organiza os episódios e acompanha cada momento que você assistir." Foreground="#959CAE" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,25"/><Button Style="{StaticResource PrimaryButton}" Content="＋  Adicionar pasta de animes" HorizontalAlignment="Center" Click="AddLibraryFolder_Click"/><TextBlock x:Name="StatusText" Text="Tudo fica no seu computador." Foreground="#72798B" FontSize="12" Margin="0,18,0,0"/></StackPanel></Grid></Border>
        </Grid>
    </Grid>
</Window>
