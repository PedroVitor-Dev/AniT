<Window x:Class="AniT.App.EpisodeCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comentário do episódio · AniT"
        Width="640" Height="480" MinWidth="560" MinHeight="430"
        Background="#06142B" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Nota do episódio (opcional)" Foreground="White" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Registre uma lembrança, observação ou crítica somente para o episódio selecionado." Foreground="#9DB9D8" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>

        <ComboBox x:Name="EpisodeSelector" Grid.Row="1" Height="42" Margin="0,22,0,12"
                  ItemsSource="{Binding Episodes}" DisplayMemberPath="Display"
                  SelectionChanged="EpisodeSelector_SelectionChanged"
                  Background="#EAF6FF" Foreground="#071B38" BorderBrush="#3F83B7" Padding="11,6">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="#EAF6FF"/>
                    <Setter Property="Foreground" Value="#071B38"/>
                    <Setter Property="Padding" Value="11,8"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#BDEAFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#82D9FF"/><Setter Property="Foreground" Value="#031326"/></Trigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <Border Grid.Row="2" Background="#C90A1D3A" BorderBrush="#3674A8" BorderThickness="1" CornerRadius="14" Padding="2">
            <TextBox x:Name="CommentTextBox" Background="Transparent" Foreground="#F0F7FF" BorderThickness="0"
                     CaretBrush="#58D5FF" FontSize="14" Padding="15" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#6CDEB2" FontSize="12" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Cancelar" Click="Cancel_Click" Padding="18,9" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Style="{StaticResource HomePrimaryButton}" Content="Salvar nota" Click="Save_Click" Padding="18,9"/>
        </Grid>
    </Grid>
</Window>
