<Window x:Class="AniT.App.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendário · AniT" Width="1520" Height="940" MinWidth="1080" MinHeight="720"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" Activated="Window_Activated" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CalendarPanel" TargetType="Border">
                <Setter Property="Background" Value="#EA071B37"/>
                <Setter Property="BorderBrush" Value="#2878AE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="17"/>
            </Style>

            <Style x:Key="CalendarArrowButton" TargetType="Button" BasedOn="{StaticResource HomeOutlineButton}">
                <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="20"/>
            </Style>

            <Style x:Key="WeekdayText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#DCEBFA"/><Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SummaryLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#C7DAEF"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,7"/>
            </Style>

            <Style x:Key="SummaryValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,4"/>
            </Style>

            <Style x:Key="CalendarDayButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Cell" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="8" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="CellScale"/></Border.RenderTransform>
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="#65DEFF"/><Setter TargetName="Cell" Property="Background" Value="#143A64"/></Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="#59E4FF"/><Setter TargetName="Cell" Property="BorderThickness" Value="2"/><Setter TargetName="Cell" Property="Effect"><Setter.Value><DropShadowEffect Color="#25C7FF" BlurRadius="20" ShadowDepth="0" Opacity="0.72"/></Setter.Value></Setter></DataTrigger>
                                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CellScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="CellScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CellScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="CellScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="CalendarMarkerTemplate">
                <Border Width="45" Height="54" CornerRadius="7" Margin="0,0,4,0" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="7">
                    <Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle VerticalAlignment="Bottom" Height="19" Fill="#D405142B"/><TextBlock Text="{Binding EpisodeLabel}" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="1,0,1,4"/></Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="SelectedActivityTemplate">
                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" Tag="{Binding AnimeId}" Click="ActivityDetails_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Border Style="{StaticResource CalendarPanel}" Padding="10" CornerRadius="13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                            <Border Width="72" Height="92" CornerRadius="9" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="9"><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/></Border>
                            <StackPanel Grid.Column="1" Margin="10,2,10,0"><TextBlock Text="{Binding AnimeTitle}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38"/><TextBlock Text="{Binding EpisodeTitle}" Foreground="#AFC8E5" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,11,0,0"><TextBlock Text="{Binding ProgressLabel}" Foreground="#C7DDF4" FontSize="9"/><TextBlock Text="{Binding TimeLabel}" Foreground="#87A9CB" FontSize="9" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource HomeProgress}" Height="7" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding MoodAsset}" Width="65" Height="65" Stretch="Uniform"/><Border Background="#173F70" BorderBrush="#45B9ED" BorderThickness="1" CornerRadius="10" Padding="8,4" Margin="0,2,0,0"><TextBlock Text="{Binding MoodLabel}" Foreground="#DDF5FF" FontSize="9" TextAlignment="Center" TextWrapping="Wrap"/></Border></StackPanel>
                        </Grid>
                    </Border>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.70,0.02" Center="0.70,0.02" RadiusX="0.95" RadiusY="1.05"><GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.44"/><GradientStop Color="#020A1A" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="260"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="⌂    Início" Click="Home_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="◉    Explorar" Click="Explore_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="▱    Biblioteca" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeActiveNavButton}" Content="▣    Calendário"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="◷    Histórico" Click="History_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="♙    Perfil" Click="Profile_Click"/>
                </StackPanel>
                <Image Grid.Row="2" Source="Assets/Calendar/samurai.png" Width="245" Height="245" Stretch="Uniform" Opacity="0.72" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-8,0,-8,-20" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1">
                <Grid MaxWidth="2500" Margin="28,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#A9C7EC" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/></Grid></Grid></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource HomeTopButton}" Content="⌂  Início" Click="Home_Click"/><Button Style="{StaticResource HomeTopButton}" Content="▶  Assistir" Click="Continue_Click"/><Button x:Name="LibraryTopButton" Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/><Button x:Name="CollectionsTopButton" Style="{StaticResource HomeTopButton}" Content="▱  Coleções" Click="Library_Click"/><Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/><Border Width="44" Height="44" CornerRadius="22" Background="#103461" BorderBrush="#4BC8FF" BorderThickness="1"><TextBlock Text="♙" Foreground="#C9F0FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CalendarContentHost" MaxWidth="2500" Margin="24,0,24,42">
                    <Border x:Name="CalendarHero" Height="174" CornerRadius="0,0,20,20" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="20">
                        <Grid><Image Source="Assets/Calendar/banner.png" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F2051833" Offset="0"/><GradientStop Color="#C9082144" Offset="0.38"/><GradientStop Color="#35061A36" Offset="0.82"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel Margin="34,0" VerticalAlignment="Center"><TextBlock Text="Calendário" Foreground="White" FontSize="43" FontWeight="Bold"/><TextBlock Text="Seu diário pessoal de animes assistidos." Foreground="#D5E8FA" FontSize="18" FontStyle="Italic" Margin="0,3,0,0"/></StackPanel></Grid>
                    </Border>

                    <Grid Margin="0,14,0,0" MinHeight="650">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="MonthColumn" Width="1.08*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="DayColumn" Width="0.78*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="RightRailColumn" Width="300"/></Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CalendarPanel}" Padding="13">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource CalendarArrowButton}" Content="‹" Click="PreviousMonth_Click"/><TextBlock Grid.Column="1" Text="{Binding MonthTitle}" Foreground="White" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/><Button Grid.Column="2" Style="{StaticResource HomeOutlineButton}" Content="Hoje" Click="Today_Click" Padding="20,8" Margin="0,0,10,0"/><Button Grid.Column="3" Style="{StaticResource CalendarArrowButton}" Content="›" Click="NextMonth_Click"/></Grid>
                                <UniformGrid Grid.Row="1" Columns="7" Background="#5A123158"><TextBlock Text="Dom" Style="{StaticResource WeekdayText}"/><TextBlock Text="Seg" Style="{StaticResource WeekdayText}"/><TextBlock Text="Ter" Style="{StaticResource WeekdayText}"/><TextBlock Text="Qua" Style="{StaticResource WeekdayText}"/><TextBlock Text="Qui" Style="{StaticResource WeekdayText}"/><TextBlock Text="Sex" Style="{StaticResource WeekdayText}"/><TextBlock Text="Sáb" Style="{StaticResource WeekdayText}"/></UniformGrid>
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}" Margin="0,5,0,3"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource CalendarDayButton}" Tag="{Binding Date}" Click="Day_Click"><Grid Opacity="{Binding Opacity}"><TextBlock Text="{Binding DayNumber}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top"/><ItemsControl ItemsSource="{Binding Markers}" ItemTemplate="{StaticResource CalendarMarkerTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="{Binding OverflowLabel}" Foreground="#71DEFF" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"><Ellipse Width="11" Height="11" Fill="#39E0FF"/><TextBlock Text="Dia selecionado" Foreground="#C8DDF3" FontSize="10" Margin="7,0,20,0"/><Ellipse Width="11" Height="11" Fill="#249DE7"/><TextBlock Text="Com episódios" Foreground="#C8DDF3" FontSize="10" Margin="7,0,20,0"/><Ellipse Width="11" Height="11" Fill="#506D92"/><TextBlock Text="Sem atividade" Foreground="#C8DDF3" FontSize="10" Margin="7,0,0,0"/></StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CalendarPanel}" Padding="14">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource CalendarArrowButton}" Content="‹" Click="PreviousDay_Click" Margin="0,0,7,0"/><Button Style="{StaticResource CalendarArrowButton}" Content="›" Click="NextDay_Click"/></StackPanel><StackPanel><TextBlock Text="{Binding SelectedDayTitle}" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedDaySubtitle}" Foreground="#AFC7E1" FontSize="12" Margin="0,5,0,0"/></StackPanel></DockPanel>
                                <Grid Grid.Row="1"><ItemsControl ItemsSource="{Binding SelectedActivities}" ItemTemplate="{StaticResource SelectedActivityTemplate}"/><TextBlock x:Name="EmptyDayText" Text="Nenhum episódio registrado neste dia.&#x0a;Sua próxima memória aparecerá aqui." Foreground="#7898BC" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="20"/></Grid>
                                <StackPanel Grid.Row="2" Margin="0,10,0,0"><DockPanel Margin="2,0,2,7"><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Salvar  ✓" Click="SaveNote_Click"/><TextBlock Text="▣  Minha nota do dia" Foreground="White" FontSize="14" FontWeight="SemiBold"/></DockPanel><Border Background="#A70B2850" BorderBrush="#3891C6" BorderThickness="1" CornerRadius="11" Padding="2"><TextBox x:Name="DayNoteTextBox" MinHeight="88" MaxHeight="126" Background="Transparent" BorderThickness="0" Foreground="#DCEBFA" CaretBrush="#57D7FF" Padding="12" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2000"/></Border><TextBlock x:Name="NoteStatusText" Foreground="#6CDEB2" FontSize="9" HorizontalAlignment="Right" Margin="0,5,2,0"/></StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="RightRail" Grid.Column="4">
                            <Border Style="{StaticResource CalendarPanel}" Padding="13" Margin="0,0,0,11" Background="#D7072142"><Grid Height="145"><Image Source="Assets/Calendar/6.png" Width="142" Height="142" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-12,0,0,-10"/><StackPanel Margin="120,8,4,4"><TextBlock Text="▣  Baki-Pi diz:" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="Cada dia assistido vira uma memória especial da sua jornada." Foreground="#D1E2F5" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"/></StackPanel></Grid></Border>
                            <Border Style="{StaticResource CalendarPanel}" Padding="16" Margin="0,0,0,11"><StackPanel><TextBlock Text="▥  Resumo do mês" Foreground="White" FontSize="17" FontWeight="SemiBold"/><Border Height="1" Background="#28567E" Margin="0,11"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▣   Dias assistidos" Style="{StaticResource SummaryLabel}"/><TextBlock Text="▶   Episódios vistos" Style="{StaticResource SummaryLabel}"/><TextBlock Text="◷   Horas assistidas" Style="{StaticResource SummaryLabel}"/><TextBlock Text="★   Melhor dia" Style="{StaticResource SummaryLabel}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding WatchedDaysLabel}" Style="{StaticResource SummaryValue}"/><TextBlock Text="{Binding WatchedEpisodesLabel}" Style="{StaticResource SummaryValue}"/><TextBlock Text="{Binding WatchedHoursLabel}" Style="{StaticResource SummaryValue}"/><TextBlock Text="{Binding BestDayLabel}" Style="{StaticResource SummaryValue}"/></StackPanel></Grid></StackPanel></Border>
                            <Border Style="{StaticResource CalendarPanel}" Padding="16"><Grid Height="112"><Image Source="Assets/Calendar/3.png" Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-9,-11"/><StackPanel Margin="0,0,90,0"><TextBlock Text="♨  Sequência atual" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding StreakLabel}" Foreground="#FFD34F" FontSize="25" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock Text="Continue criando boas memórias!" Foreground="#B8CEE7" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Grid></Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

</Window>
