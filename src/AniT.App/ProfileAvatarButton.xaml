<UserControl x:Class="AniT.App.ProfileAvatarButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="44" Height="44" ToolTip="Abrir perfil"
             Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged">
    <Grid>
        <Ellipse Fill="#153F70" Stroke="#4BC8FF" StrokeThickness="1.5">
            <Ellipse.Effect><DropShadowEffect Color="#20BFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Margin="3" Stroke="#8FE8FF" StrokeThickness="1">
            <Ellipse.Fill><ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill>
        </Ellipse>
        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Profile_Click" FocusVisualStyle="{x:Null}">
            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" CornerRadius="22"/></ControlTemplate></Button.Template>
        </Button>
    </Grid>
</UserControl>
