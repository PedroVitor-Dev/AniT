<Window x:Class="AniT.App.CorrectAssociationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corrigir identificação · AniT" Width="560" Height="410" ResizeMode="NoResize" Background="#070B16" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="31"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Corrigir identificação" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="FileText" Foreground="#83A2C7" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Border Grid.Row="1" Background="#0D1829" BorderBrush="#294563" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,20,0,17"><StackPanel><TextBlock Text="Anime" Foreground="#B9D0EA"/><ComboBox x:Name="AnimeSelector" DisplayMemberPath="Title" Height="39" Margin="0,6,0,14" Background="#10213A" Foreground="White"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Temporada" Foreground="#B9D0EA"/><TextBox x:Name="SeasonText" Text="1" Padding="10,8" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Episódio" Foreground="#B9D0EA"/><TextBox x:Name="EpisodeText" Text="1" Padding="10,8" Margin="0,6,0,0"/></StackPanel></Grid><TextBlock x:Name="StatusText" Foreground="#F0AE70" Margin="0,13,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Padding="16,9" Margin="0,0,9,0" Click="Cancel_Click"/><Button Style="{StaticResource BrandButton}" Content="Salvar correção" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
