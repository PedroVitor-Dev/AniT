<Window x:Class="AniT.App.AchievementToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" Height="126" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Focusable="False" ResizeMode="NoResize">
    <Border x:Name="ToastBorder" CornerRadius="24" BorderThickness="2" Padding="15"
            Background="#FF06182F" BorderBrush="#35C7FF" Opacity="0"
            ClipToBounds="True">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ToastScale" ScaleX="0.92" ScaleY="0.92" CenterX="235" CenterY="63"/>
                <TranslateTransform x:Name="ToastTranslate" Y="20"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="78" Height="78" CornerRadius="20" Background="#142C51" BorderBrush="#45CFFF" BorderThickness="1.5">
                <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,4,0">
                <TextBlock Text="CONQUISTA DESBLOQUEADA" Foreground="#76DFFF" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,3,0,3"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" Foreground="#FFE066" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Points}" Foreground="#FFE066" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text=" AniPoints" Foreground="#B9D8F5" FontSize="14"/>
                    <TextBlock Text="  •  " Foreground="#52769B"/>
                    <TextBlock Text="{Binding RarityLabel}" Foreground="{Binding AccentBrush}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
