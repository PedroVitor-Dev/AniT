<Window x:Class="AniT.App.ProfileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AniT.App"
        Title="Quem está assistindo? · AniT" WindowState="Maximized" WindowStyle="None"
        Background="#020B1D" ResizeMode="NoResize" KeyDown="Window_KeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ProfileCardButton" TargetType="Button">
            <Setter Property="Width" Value="260"/><Setter Property="Height" Value="325"/><Setter Property="Margin" Value="14"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="#D9081C3A" BorderBrush="#2B6798" BorderThickness="1" CornerRadius="24" Padding="16"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#67DCFF"/><Setter TargetName="Card" Property="Background" Value="#F00D2B54"/><Setter TargetName="Card" Property="Effect"><Setter.Value><DropShadowEffect Color="#2BCBFF" BlurRadius="24" ShadowDepth="0" Opacity="0.46"/></Setter.Value></Setter></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EntryButton" TargetType="Button"><Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="130"/><Setter Property="Padding" Value="18,0"/><Setter Property="Background" Value="#31AFFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="EntryOutlineButton" TargetType="Button" BasedOn="{StaticResource EntryButton}"><Setter Property="Background" Value="#0B274B"/><Setter Property="BorderBrush" Value="#55CFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush GradientOrigin="0.5,0.15" Center="0.5,0.15" RadiusX="0.88" RadiusY="1"><GradientStop Color="#0B3970"/><GradientStop Color="#041A38" Offset="0.45"/><GradientStop Color="#020817" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>

        <Grid Margin="42,0"><Border Width="190" Height="88" HorizontalAlignment="Left" VerticalAlignment="Center"><Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background></Border><Button Style="{StaticResource EntryOutlineButton}" Content="Sair" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="92" Click="Exit_Click"/></Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,30,30,45" HorizontalAlignment="Center">
                <TextBlock Text="Quem está assistindo?" Foreground="White" FontSize="42" FontWeight="Bold" TextAlignment="Center"/>
                <TextBlock Text="Escolha seu perfil para continuar exatamente de onde parou." Foreground="#A8C9E6" FontSize="16" TextAlignment="Center" Margin="0,10,0,30"/>
                <ItemsControl x:Name="ProfilesList" MaxWidth="1300">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Style="{StaticResource ProfileCardButton}" Click="Profile_Click">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Ellipse Width="202" Height="202" Stroke="#65DFFF" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/></Ellipse.Fill><Ellipse.Effect><DropShadowEffect Color="#2BCBFF" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></Ellipse.Effect></Ellipse>
                                <Border Visibility="{Binding LockVisibility}" Width="44" Height="44" CornerRadius="22" Background="#F20A1A33" BorderBrush="#7BE5FF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,70"><Viewbox Width="20" Height="20"><Path Data="M5,9 V6 C5,2 13,2 13,6 V9 M3,9 H15 V17 H3 Z" Fill="Transparent" Stroke="#8DE8FF" StrokeThickness="1.8" StrokeLineJoin="Round"/></Viewbox></Border>
                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Foreground="White" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,13,0,0"/>
                                <TextBlock Grid.Row="2" Text="{Binding AccessLabel}" Foreground="#8EAFCC" FontSize="11" TextAlignment="Center" Margin="0,5,0,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Perfis, avatares e PIN podem ser administrados em Configurações → Perfil e privacidade." Foreground="#7397B8" FontSize="12" TextAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="34,0"><TextBlock Text="Sua jornada continua só para você." Foreground="#7195B7" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="{x:Static local:App.DisplayVersion}" Foreground="#7195B7" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>

        <Border x:Name="PinOverlay" Grid.RowSpan="3" Background="#D9020817" Visibility="Collapsed">
            <Border Width="480" Background="#F5081D3C" BorderBrush="#4BCFFF" BorderThickness="1" CornerRadius="24" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Ellipse Width="112" Height="112" Stroke="#66DEFF" StrokeThickness="2" HorizontalAlignment="Center"><Ellipse.Fill><ImageBrush x:Name="PinAvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                    <TextBlock x:Name="PinTitle" Text="Digite seu PIN" Foreground="White" FontSize="25" FontWeight="Bold" TextAlignment="Center" Margin="0,18,0,5"/>
                    <TextBlock Text="O PIN protege a entrada deste perfil neste computador." Foreground="#9BBBD7" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                    <PasswordBox x:Name="PinBox" MaxLength="6" FontSize="23" PasswordChar="●" Background="#0A254A" Foreground="White" CaretBrush="#5BD8FF" BorderBrush="#387DB0" BorderThickness="1" Height="52" Padding="14,5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,22,0,0" PasswordChanged="PinBox_PasswordChanged" KeyDown="PinBox_KeyDown"/>
                    <TextBlock x:Name="PinError" Foreground="#FF8C9D" FontSize="12" TextAlignment="Center" MinHeight="18" Margin="0,9,0,0"/>
                    <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Style="{StaticResource EntryOutlineButton}" Content="Voltar" Click="CancelPin_Click"/><Button x:Name="ConfirmPinButton" Grid.Column="2" Style="{StaticResource EntryButton}" Content="Entrar" Click="ConfirmPin_Click"/></Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
