<Window x:Class="AniT.App.MediaVersionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Versões do episódio · AniT" Width="760" Height="520" MinWidth="640" MinHeight="430" Background="#070B16" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="31"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleText" Text="Arquivos deste episódio" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="A versão preferida é usada no Continuar. Se ela estiver offline, o AniT tenta outra disponível." Foreground="#8CA8CA" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,20,0,15" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Versions}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0E192A" BorderBrush="#2A4565" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="#7895B8" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Corrigir associação" Padding="13,8" Tag="{Binding Id}" Click="Correct_Click" Margin="15,0,0,0"/><Button Grid.Column="2" Style="{StaticResource BrandButton}" Content="{Binding ActionLabel}" IsEnabled="{Binding CanPrefer}" Tag="{Binding Id}" Click="Prefer_Click" Margin="9,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="#6FD6B1" VerticalAlignment="Center"/><Button Content="Fechar" Padding="18,9" HorizontalAlignment="Right" Click="Close_Click"/></Grid>
    </Grid>
</Window>
