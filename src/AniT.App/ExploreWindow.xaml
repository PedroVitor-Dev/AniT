<Window x:Class="AniT.App.ExploreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AniT.App"
        Title="Explorar · AniT" Width="1440" Height="900" MinWidth="1060" MinHeight="700"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ExploreComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="43"/>
                <Setter Property="Margin" Value="0,0,0,9"/>
                <Setter Property="Foreground" Value="#E8F4FF"/>
                <Setter Property="Background" Value="#081E3E"/>
                <Setter Property="BorderBrush" Value="#24639B"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#DDEEFF"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="13,9"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#174D82"/><Setter Property="Foreground" Value="White"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1D68A9"/><Setter Property="Foreground" Value="White"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                    <Grid Margin="14,0,12,0">
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        <Path Data="{StaticResource AniT.Icon.ChevronDown}" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#A9DFFF" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Padding="5"
                                            Background="#F20A1F40" BorderBrush="#337EB9" BorderThickness="1" CornerRadius="12">
                                        <ScrollViewer MaxHeight="250"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#5AD5FF"/><Setter TargetName="ComboSurface" Property="Background" Value="#103158"/></Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#79E3FF"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Storyboard x:Key="RouletteMagicAnimation" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="RouletteCyanGlow" Storyboard.TargetProperty="Opacity" From="0.34" To="0.92" Duration="0:0:1.6" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="RouletteCyanGlowScale" Storyboard.TargetProperty="ScaleX" From="0.985" To="1.025" Duration="0:0:1.6" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="RouletteCyanGlowScale" Storyboard.TargetProperty="ScaleY" From="0.985" To="1.025" Duration="0:0:1.6" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="RouletteVioletGlow" Storyboard.TargetProperty="Opacity" From="0.62" To="0.18" Duration="0:0:2.1" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="RouletteVioletGlowScale" Storyboard.TargetProperty="ScaleX" From="1.018" To="0.99" Duration="0:0:2.1" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="RouletteVioletGlowScale" Storyboard.TargetProperty="ScaleY" From="1.018" To="0.99" Duration="0:0:2.1" AutoReverse="True"/>

                <DoubleAnimation Storyboard.TargetName="RouletteParticleOneMove" Storyboard.TargetProperty="Y" From="54" To="-118" Duration="0:0:2.8"/>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RouletteParticleOne" Storyboard.TargetProperty="Opacity" Duration="0:0:2.8"><DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0"/><SplineDoubleKeyFrame Value="0.95" KeyTime="0:0:0.55"/><SplineDoubleKeyFrame Value="0" KeyTime="0:0:2.8"/></DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="RouletteParticleTwoMove" Storyboard.TargetProperty="Y" From="72" To="-105" BeginTime="0:0:0.65" Duration="0:0:3.15"/>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RouletteParticleTwo" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.65" Duration="0:0:3.15"><DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0"/><SplineDoubleKeyFrame Value="0.8" KeyTime="0:0:0.7"/><SplineDoubleKeyFrame Value="0" KeyTime="0:0:3.15"/></DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="RouletteParticleThreeMove" Storyboard.TargetProperty="Y" From="38" To="-132" BeginTime="0:0:1.2" Duration="0:0:2.6"/>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RouletteParticleThree" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.2" Duration="0:0:2.6"><DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0"/><SplineDoubleKeyFrame Value="1" KeyTime="0:0:0.5"/><SplineDoubleKeyFrame Value="0" KeyTime="0:0:2.6"/></DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="RouletteParticleFourMove" Storyboard.TargetProperty="Y" From="64" To="-122" BeginTime="0:0:0.25" Duration="0:0:3.45"/>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RouletteParticleFour" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.25" Duration="0:0:3.45"><DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0"/><SplineDoubleKeyFrame Value="0.88" KeyTime="0:0:0.8"/><SplineDoubleKeyFrame Value="0" KeyTime="0:0:3.45"/></DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="RouletteParticleFiveMove" Storyboard.TargetProperty="Y" From="45" To="-92" BeginTime="0:0:1.7" Duration="0:0:2.25"/>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RouletteParticleFive" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.7" Duration="0:0:2.25"><DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0"/><SplineDoubleKeyFrame Value="0.82" KeyTime="0:0:0.45"/><SplineDoubleKeyFrame Value="0" KeyTime="0:0:2.25"/></DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="RouletteParticleSixMove" Storyboard.TargetProperty="Y" From="58" To="-126" BeginTime="0:0:0.95" Duration="0:0:3.05"/>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RouletteParticleSix" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.95" Duration="0:0:3.05"><DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0"/><SplineDoubleKeyFrame Value="0.92" KeyTime="0:0:0.65"/><SplineDoubleKeyFrame Value="0" KeyTime="0:0:3.05"/></DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Style x:Key="RouletteCoverCard" TargetType="Border">
                <Setter Property="Background" Value="#091A36"/>
                <Setter Property="BorderBrush" Value="#57DFFF"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
                <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#249BFF" BlurRadius="21" ShadowDepth="0" Opacity="0.46"/></Setter.Value></Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#A4F4FF"/>
                        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#42DFFF" BlurRadius="34" ShadowDepth="0" Opacity="0.82"/></Setter.Value></Setter>
                    </Trigger>
                    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RouletteGlassButton" TargetType="Button">
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="Background" Value="#C2082142"/>
                <Setter Property="BorderBrush" Value="#61DFFF"/>
                <Setter Property="BorderThickness" Value="2.5"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="GlassRoot" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="GlassScale"/><TranslateTransform x:Name="GlassLift"/></TransformGroup></Grid.RenderTransform>
                                <Border x:Name="GlassSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" ClipToBounds="True">
                                    <Grid>
                                        <Rectangle x:Name="GlassSheen" Opacity="0.13" IsHitTestVisible="False">
                                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BFFFFFFF" Offset="0"/><GradientStop Color="#3D8FE8FF" Offset="0.34"/><GradientStop Color="#00117DD7" Offset="0.62"/></LinearGradientBrush></Rectangle.Fill>
                                        </Rectangle>
                                        <Border VerticalAlignment="Top" Height="1" Margin="11,1" Background="#A8EFFFFF" CornerRadius="1" Opacity="0.66"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GlassSurface" Property="Background" Value="#DC16466F"/>
                                    <Setter TargetName="GlassSurface" Property="BorderBrush" Value="#B6F5FF"/>
                                    <Setter TargetName="GlassSheen" Property="Opacity" Value="0.58"/>
                                    <Setter TargetName="GlassSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#43D9FF" BlurRadius="25" ShadowDepth="0" Opacity="0.72"/></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="GlassSurface" Property="Opacity" Value="0.78"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="GlassRoot" Property="Opacity" Value="0.42"/></Trigger>
                                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="GlassLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/><DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/><DoubleAnimation Storyboard.TargetName="GlassLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MoodButton" TargetType="ToggleButton">
                <Setter Property="Padding" Value="17,9"/>
                <Setter Property="Margin" Value="0,0,9,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinWidth" Value="124"/>
                <Setter Property="Foreground" Value="#DCEEFF"/>
                <Setter Property="Background" Value="#8A091E3D"/>
                <Setter Property="BorderBrush" Value="#3976A9"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="MoodSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MoodSurface" Property="Background" Value="#183A64"/>
                                    <Setter TargetName="MoodSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#37C7FF" BlurRadius="15" ShadowDepth="0" Opacity="0.32"/></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="MoodSurface" Property="Background" Value="#264A78"/>
                                    <Setter TargetName="MoodSurface" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="MoodSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#55D8FF" BlurRadius="20" ShadowDepth="0" Opacity="0.56"/></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="MoodSurface" Property="Opacity" Value="0.76"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GenreCardButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Panel.ZIndex" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="GenreSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="24" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="GenreScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="GenreLift" Y="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="20"/>
                                    <Setter TargetName="GenreSurface" Property="Background" Value="#1829527E"/>
                                    <Setter TargetName="GenreSurface" Property="BorderBrush" Value="#8BE5FF"/>
                                    <Setter TargetName="GenreSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#26B9FF" BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.58"/></Setter.Value></Setter>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="30"/>
                                    <Setter TargetName="GenreSurface" Property="Background" Value="#362B7FB1"/>
                                    <Setter TargetName="GenreSurface" Property="BorderBrush" Value="#C4F7FF"/>
                                    <Setter TargetName="GenreSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#39D9FF" BlurRadius="44" ShadowDepth="0" Opacity="0.95"/></Setter.Value></Setter>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="GenreScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.025" Duration="0:0:0.7"/>
                                                <DoubleAnimation Storyboard.TargetName="GenreScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.025" Duration="0:0:0.7"/>
                                                <DoubleAnimation Storyboard.TargetName="GenreSurface" Storyboard.TargetProperty="Opacity" From="0.9" To="1" Duration="0:0:0.7"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="GenreSurface" Property="Opacity" Value="0.78"/></Trigger>
                                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GenreScale" Storyboard.TargetProperty="ScaleX" To="1.075" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="GenreScale" Storyboard.TargetProperty="ScaleY" To="1.075" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="GenreLift" Storyboard.TargetProperty="Y" To="-7" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GenreScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"/><DoubleAnimation Storyboard.TargetName="GenreScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"/><DoubleAnimation Storyboard.TargetName="GenreLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22"/></Storyboard></BeginStoryboard></EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GenreTagPill" TargetType="Border">
                <Setter Property="Background" Value="#132F52"/>
                <Setter Property="BorderBrush" Value="#315F86"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="#204F7E"/>
                        <Setter Property="BorderBrush" Value="#82E9FF"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#34D7FF" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></Setter.Value></Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GenreResultCardButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ResultHoverSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="20" Padding="2">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="ResultGlass" Background="#001B6A9A" CornerRadius="18" IsHitTestVisible="False" Opacity="0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ResultHoverSurface" Property="BorderBrush" Value="#69DCFF"/>
                                    <Setter TargetName="ResultHoverSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#28BFFF" BlurRadius="25" ShadowDepth="0" Opacity="0.5"/></Setter.Value></Setter>
                                    <Setter TargetName="ResultGlass" Property="Background" Value="#181C79A4"/>
                                    <Setter TargetName="ResultGlass" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ResultHoverSurface" Property="Opacity" Value="0.82"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ResultHoverSurface" Property="BorderBrush" Value="#B5F0FF"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.69,0.03" Center="0.69,0.03" RadiusX="0.96" RadiusY="1.08">
                <GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.44"/><GradientStop Color="#020A1A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                    <Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeNavButton}" Click="Home_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Home}" Label="Início"/></Button>
                    <Button Style="{StaticResource HomeActiveNavButton}"><local:NavItemContent IconData="{StaticResource AniT.Icon.Explore}" Label="Explorar"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Library_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Library}" Label="Biblioteca"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Calendar_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Calendar}" Label="Calendário"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="History_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.History}" Label="Histórico"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Achievements_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Achievements}" Label="Conquistas"/></Button>
                    <Button Style="{StaticResource HomeNavButton}" Click="Profile_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Profile}" Label="Perfil"/></Button>
                    <Border Height="1" Background="#214874" Margin="20,18,20,11"/>
                    <TextBlock Text="SISTEMA" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,7"/>
                    <local:SystemSettingsNavButton/>
                    <Button Style="{StaticResource HomeNavButton}" Click="ConfigureShelf_Click"><local:NavItemContent IconData="{StaticResource AniT.Icon.Settings}" Label="Configurar estante"/></Button>
                </StackPanel>
                <Image Grid.Row="2" Source="Assets/ghost_menu.png" Style="{StaticResource HomeSidebarMascot}"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1">
                <Grid MaxWidth="2500" Margin="28,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource AniT.Icon.Search}" Width="20" Height="20" Stretch="Uniform" Fill="Transparent" Stroke="#A9C7EC" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/></Grid></Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource HomeTopButton}" Click="Home_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Home}" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#DCEEFF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="Início" Margin="7,0,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource HomeTopButton}" Click="ContinueTop_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Play}" Width="14" Height="14" Stretch="Uniform" Fill="#DCEEFF" Stroke="#DCEEFF" StrokeThickness="1.2" StrokeLineJoin="Round"/><TextBlock Text="Continuar" Margin="7,0,0,0"/></StackPanel></Button>
                        <Button x:Name="LibraryTopButton" Style="{StaticResource HomeTopButton}" Click="Library_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Library}" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#DCEEFF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="Biblioteca" Margin="7,0,0,0"/></StackPanel></Button>
                        <Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/>
                        <local:ProfileAvatarButton/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <Grid x:Name="ExploreContentHost" MaxWidth="2500" Margin="24,16,24,42" HorizontalAlignment="Stretch">
                    <Grid x:Name="ExploreLayout">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition x:Name="RightRailColumn" Width="300"/></Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Explorar" Foreground="White" FontSize="42" FontWeight="Bold"/>
                                <TextBlock Text="Descubra novos mundos, gêneros e histórias. ✦" Foreground="#BBD8F6" FontSize="16" Margin="2,-2,0,0"/>
                            </StackPanel>

                            <Border x:Name="MoodSection" Background="#A0082040" BorderBrush="#2A6597" BorderThickness="1" CornerRadius="15" Padding="16,13,16,5" Margin="0,0,0,14">
                                <WrapPanel VerticalAlignment="Center">
                                    <StackPanel Width="275" Margin="2,0,18,8" VerticalAlignment="Center">
                                        <TextBlock Text="Como você quer se sentir hoje?" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MoodHint" Text="Escolha um clima e deixe a roleta decidir." Foreground="#8EAED1" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="MoodTagPanel" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <ToggleButton Style="{StaticResource MoodButton}" Foreground="#FF78AD" BorderBrush="#FF579E" Tag="Fofo" Click="Mood_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Heart}" Width="14" Height="14" Stretch="Uniform" Fill="#FF78AD" Stroke="#FF78AD" StrokeThickness="1.4"/><TextBlock Text="Fofo" Margin="8,0,0,0"/></StackPanel></ToggleButton>
                                        <ToggleButton Style="{StaticResource MoodButton}" Foreground="#FFD965" BorderBrush="#E7B54A" Tag="Emocionante" Click="Mood_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Star}" Width="14" Height="14" Stretch="Uniform" Fill="#FFD965" Stroke="#FFD965" StrokeThickness="1.2"/><TextBlock Text="Emocionante" Margin="8,0,0,0"/></StackPanel></ToggleButton>
                                        <ToggleButton Style="{StaticResource MoodButton}" Foreground="#69E7D5" BorderBrush="#25CDB9" Tag="Relaxante" Click="Mood_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Moon}" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#69E7D5" StrokeThickness="1.8"/><TextBlock Text="Relaxante" Margin="8,0,0,0"/></StackPanel></ToggleButton>
                                        <ToggleButton Style="{StaticResource MoodButton}" Foreground="#8FCBFF" BorderBrush="#4D9DE0" Tag="Triste" Click="Mood_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Cloud}" Width="15" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#8FCBFF" StrokeThickness="1.8"/><TextBlock Text="Triste" Margin="8,0,0,0"/></StackPanel></ToggleButton>
                                        <ToggleButton Style="{StaticResource MoodButton}" Foreground="#C4A0FF" BorderBrush="#8665DC" Tag="Épico" Click="Mood_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Crown}" Width="15" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#C4A0FF" StrokeThickness="1.8"/><TextBlock Text="Épico" Margin="8,0,0,0"/></StackPanel></ToggleButton>
                                        <ToggleButton Style="{StaticResource MoodButton}" Foreground="#FFD17A" BorderBrush="#C99B4A" Tag="Engraçado" Click="Mood_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Smile}" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#FFD17A" StrokeThickness="1.8"/><TextBlock Text="Engraçado" Margin="8,0,0,0"/></StackPanel></ToggleButton>
                                    </WrapPanel>
                                </WrapPanel>
                            </Border>

                            <Grid x:Name="DiscoveryBanner" Height="276" Margin="0,0,0,18" ClipToBounds="False">
                                <Border x:Name="DiscoveryBannerFrame" Padding="2" CornerRadius="19" Background="#43C8FF"
                                        Tag="19" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged">
                                    <Border.Effect><DropShadowEffect Color="#168BFF" BlurRadius="22" ShadowDepth="0" Opacity="0.26"/></Border.Effect>
                                    <Border x:Name="DiscoveryBannerInner" Tag="17" CornerRadius="17" Background="#071B38" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged">
                                        <Grid>
                                            <Image Source="Assets/Explore/backg.png" Stretch="UniformToFill" Opacity="0.82"/>
                                            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F2071938" Offset="0"/><GradientStop Color="#D8071938" Offset="0.42"/><GradientStop Color="#3A061A38" Offset="0.78"/><GradientStop Color="#1A061A38" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="32,12,0,12" MaxWidth="520" Panel.ZIndex="2">
                                                <TextBlock Text="Novos horizontes te esperam." Foreground="#BDDDF9" FontSize="14"/>
                                                <TextBlock Text="Descobertas da semana" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,5,0,0"/>
                                                <TextBlock Text="Anime é mais mágico quando exploramos juntos." Foreground="#D7E9FB" FontSize="15" Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                    <Button Style="{StaticResource HomePrimaryButton}" MinWidth="154" Click="BrowseNow_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Play}" Width="15" Height="15" Stretch="Uniform" Fill="White" Stroke="White" StrokeThickness="1.2"/><TextBlock Text="Ver agora" Margin="9,0,0,0"/></StackPanel></Button>
                                                    <Button Style="{StaticResource HomeOutlineButton}" MinWidth="170" Margin="12,0,0,0" Click="Library_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Library}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="#DDEEFF" StrokeThickness="1.8" StrokeLineJoin="Round"/><TextBlock Text="Abrir biblioteca" Margin="9,0,0,0"/></StackPanel></Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Ellipse x:Name="DiscoveryMascotGlow" Width="300" Height="72" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,22,-18" IsHitTestVisible="False" Panel.ZIndex="3">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#9854D9FF" Offset="0"/>
                                            <GradientStop Color="#0043C8FF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect><BlurEffect Radius="24"/></Ellipse.Effect>
                                </Ellipse>

                                <Image x:Name="DiscoveryMascot" Source="Assets/Explore/banner.png" Width="400" Height="350" Stretch="Uniform"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"
                                       IsHitTestVisible="False" Panel.ZIndex="4" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.RenderTransform>
                                        <TranslateTransform x:Name="DiscoveryMascotTranslate" X="8"/>
                                    </Image.RenderTransform>
                                    <Image.Effect>
                                        <DropShadowEffect Color="#39CFFF" BlurRadius="28" ShadowDepth="7" Direction="270" Opacity="0.72"/>
                                    </Image.Effect>
                                </Image>
                            </Grid>

                            <Grid x:Name="GenreSection" Margin="0,0,0,24">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center"><local:IconTile IconData="{StaticResource AniT.Icon.Explore}" Foreground="#71DDFF"/><StackPanel Margin="10,-2,14,0" VerticalAlignment="Center"><TextBlock Text="Mundos por gênero" Style="{StaticResource HomeSectionTitle}" FontSize="23"/><TextBlock Text="Escolha um universo e descubra tudo que existe na sua estante." Foreground="#8EB4D6" FontSize="11" TextWrapping="Wrap"/></StackPanel><Border x:Name="SelectedGenrePill" Visibility="Collapsed" Background="#204F7E" BorderBrush="#8DEBFF" BorderThickness="1.5" CornerRadius="13" Padding="12,6" Margin="0,5,12,5" VerticalAlignment="Center"><TextBlock x:Name="SelectedGenreText" Foreground="#E7FBFF" FontSize="11" FontWeight="Bold"/></Border></WrapPanel>
                                    <Button x:Name="GenreCategoriesToggle" Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Recolher categorias  ⌃" Click="GenreCategoriesToggle_Click" MinWidth="170" Margin="12,2,0,2" VerticalAlignment="Center"/>
                                </Grid>

                                <Border x:Name="GenreCardsHost" Grid.Row="1" Background="#66071A35" BorderBrush="#275F8F" BorderThickness="1" CornerRadius="22" Padding="15" Margin="0,8,0,18">
                                    <ItemsControl ItemsSource="{Binding Genres}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GenreCardButton}" Tag="{Binding Name}" Click="Genre_Click" Margin="10,12">
                                                    <Border Width="{Binding GenreCategoryCardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ExploreWindow}}}" CornerRadius="22" Background="#45CFFF" Padding="3" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="22">
                                                        <Border CornerRadius="19" Background="#0B2345" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="19">
                                                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Height="{Binding GenreCategoryImageHeight, RelativeSource={RelativeSource AncestorType={x:Type local:ExploreWindow}}}" Background="#09234A"><Image Source="{Binding ImagePath}" Stretch="UniformToFill" Margin="-7" RenderOptions.BitmapScalingMode="HighQuality"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.48"/><GradientStop Color="#C8051935" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Grid><Border Grid.Row="1" MinHeight="74" Background="#F0081B37" Padding="15,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="27" Height="27" VerticalAlignment="Center"><Path Data="{Binding IconData}" Fill="Transparent" Stroke="{Binding Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox><StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="White" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="Explorar coleção" Foreground="#88B5D8" FontSize="10" Margin="0,3,0,0"/></StackPanel></Grid></Border></Grid>
                                                        </Border>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border x:Name="GenreResultsPanel" Grid.Row="2" Visibility="Collapsed" Background="#B5081E3D" BorderBrush="#3A8EBE" BorderThickness="1.5" CornerRadius="22" Padding="20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,15"><TextBlock x:Name="GenreResultsCount" DockPanel.Dock="Right" Foreground="#7DCAE9" FontSize="11" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="GenreResultsTitle" Text="Animes do gênero" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="Todas as tags continuam visíveis; a escolhida recebe o brilho principal." Foreground="#91B7D7" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel>
                                        <ItemsControl ItemsSource="{Binding GenreAnimeCards}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GenreResultCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,15,16">
                                                        <Border Width="{Binding GenreResultCardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ExploreWindow}}}" MinHeight="420" CornerRadius="18" Background="#0A2142" BorderBrush="#347FB3" BorderThickness="2" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="18">
                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                <Grid Height="{Binding GenreResultCoverHeight, RelativeSource={RelativeSource AncestorType={x:Type local:ExploreWindow}}}">
                                                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.42"/><GradientStop Color="#E0051731" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Background="#DD0B315A" BorderBrush="#A5ECFF" BorderThickness="1" CornerRadius="18" Width="38" Height="38"><Path Data="{StaticResource AniT.Icon.Play}" Width="14" Height="14" Stretch="Uniform" Fill="White" Stroke="White" StrokeThickness="1.1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="#0A2142" Margin="0,-2,0,0" Padding="14,14,14,14" Panel.ZIndex="2">
                                                                    <StackPanel>
                                                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ScoreLabel}" Foreground="#FFD75F" FontWeight="Bold" Margin="8,0,0,0"/><TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="44"/></DockPanel>
                                                                        <TextBlock Text="{Binding SecondaryText}" Foreground="#8EB8DA" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,11"/>
                                                                        <ItemsControl ItemsSource="{Binding Tags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource GenreTagPill}"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="9" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border x:Name="GenreResultsEmpty" Visibility="Collapsed" Background="#54112747" BorderBrush="#356B96" BorderThickness="1" CornerRadius="14" Padding="22"><TextBlock Text="Nenhum anime da sua estante possui esse gênero ainda." Foreground="#ACCAE5" TextAlignment="Center"/></Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="TrendingSection" Margin="0,0,0,17">
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver biblioteca  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><local:IconTile IconData="{StaticResource AniT.Icon.Fire}" Foreground="#69D7FF" Width="34" Height="34"/><TextBlock Text="Em alta agora" Style="{StaticResource HomeSectionTitle}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding TrendingCards}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,12,12"><Border Width="196" Height="224" CornerRadius="14" BorderBrush="#2C6EA5" BorderThickness="1" Background="#091D3B" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="14"><Grid><Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.4"/><GradientStop Color="#D904142D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border Width="36" Height="36" CornerRadius="18" Background="#DE0B2C54" BorderBrush="#B8F0FF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"><Path Data="{StaticResource AniT.Icon.Play}" Width="13" Height="13" Stretch="Uniform" Fill="White" Stroke="White" StrokeThickness="1.1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Grid Grid.Row="1" Margin="11,7,11,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxHeight="34"/><TextBlock Grid.Row="1" Text="{Binding SecondaryText}" Foreground="#9DC2E8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="29"/><TextBlock Grid.Row="2" Text="{Binding ScoreLabel}" Foreground="#FFD45D" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" VerticalAlignment="Bottom"/></Grid></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border x:Name="TrendingEmpty" Grid.Row="1" Background="#74102243" BorderBrush="#2C6394" BorderThickness="1" CornerRadius="13" Padding="18" Visibility="Collapsed"><TextBlock Text="Sua biblioteca ainda não tem títulos para recomendar." Foreground="#A8C7E9"/></Border>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><local:IconTile IconData="{StaticResource AniT.Icon.Star}" Foreground="#79DCFF" Width="34" Height="34"/><TextBlock Text="Recomendado para você" Style="{StaticResource HomeSectionTitle}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecommendedCards}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,12,12"><Border Width="196" Height="208" CornerRadius="14" BorderBrush="#2C6EA5" BorderThickness="1" Background="#091D3B" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="14"><Grid><Grid.RowDefinitions><RowDefinition Height="124"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.38"/><GradientStop Color="#D904142D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border Width="34" Height="34" CornerRadius="17" Background="#DE0B2C54" BorderBrush="#B8F0FF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"><Path Data="{StaticResource AniT.Icon.Play}" Width="12" Height="12" Stretch="Uniform" Fill="White" Stroke="White" StrokeThickness="1.1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Grid Grid.Row="1" Margin="11,7,11,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxHeight="34"/><Grid Grid.Row="1" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SecondaryText}" Foreground="#9DC2E8" FontSize="10" TextWrapping="Wrap" MaxHeight="29" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding ScoreLabel}" Foreground="#FFD45D" FontSize="11" FontWeight="Bold" VerticalAlignment="Bottom"/></Grid></Grid></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border x:Name="RecommendedEmpty" Grid.Row="1" Background="#74102243" BorderBrush="#2C6394" BorderThickness="1" CornerRadius="13" Padding="18" Visibility="Collapsed"><TextBlock Text="Nenhum título corresponde aos filtros selecionados. Experimente outro clima ou gênero." Foreground="#A8C7E9" TextWrapping="Wrap"/></Border>
                            </Grid>

                        </StackPanel>

                        <StackPanel x:Name="RightRail" Grid.Column="2" Margin="0,0,0,20">
                            <Border Background="#EC081D3C" BorderBrush="#28679D" BorderThickness="1" CornerRadius="17" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="1,0,0,13">
                                        <local:IconTile IconData="{StaticResource AniT.Icon.Filter}" Foreground="#8DE5FF" Width="32" Height="32"/>
                                        <StackPanel Margin="10,-1,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Filtros rápidos" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Atualização automática" Foreground="#75A7D3" FontSize="9" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ComboBox x:Name="GenreFilter" Style="{StaticResource ExploreComboBox}" SelectedIndex="0" SelectionChanged="QuickFilter_SelectionChanged"><ComboBoxItem Content="Todos os gêneros"/><ComboBoxItem Content="Ação"/><ComboBoxItem Content="Romance"/><ComboBoxItem Content="Fantasia"/><ComboBoxItem Content="Drama"/><ComboBoxItem Content="Slice of Life"/><ComboBoxItem Content="Mistério"/><ComboBoxItem Content="Comédia"/><ComboBoxItem Content="Isekai"/></ComboBox>
                                    <ComboBox x:Name="YearFilter" Style="{StaticResource ExploreComboBox}" SelectedIndex="0" SelectionChanged="QuickFilter_SelectionChanged"><ComboBoxItem Content="Todos os anos"/><ComboBoxItem Content="2026"/><ComboBoxItem Content="2025"/><ComboBoxItem Content="2024"/></ComboBox>
                                    <ComboBox x:Name="StatusFilter" Style="{StaticResource ExploreComboBox}" SelectedIndex="0" SelectionChanged="QuickFilter_SelectionChanged"><ComboBoxItem Content="Todos os status"/><ComboBoxItem Content="Em andamento"/><ComboBoxItem Content="Concluído"/></ComboBox>
                                    <ComboBox x:Name="OrderFilter" Style="{StaticResource ExploreComboBox}" SelectedIndex="0" SelectionChanged="QuickFilter_SelectionChanged" Margin="0"><ComboBoxItem Content="Ordenar por"/><ComboBoxItem Content="Mais recentes"/><ComboBoxItem Content="Melhor avaliados"/><ComboBoxItem Content="Título"/></ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Background="#EB081D3C" BorderBrush="#28679D" BorderThickness="1" CornerRadius="17" Padding="15" Margin="0,0,0,12">
                                <StackPanel><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →"/><StackPanel Orientation="Horizontal"><local:IconTile IconData="{StaticResource AniT.Icon.Trending}" Foreground="#75DDFF" Width="29" Height="29"/><TextBlock Text="Top gêneros" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Fantasia" Foreground="#D6E9FF"/><ProgressBar Grid.Column="1" Value="78" Maximum="100" Style="{StaticResource HomeProgress}" Margin="4,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="28%" Foreground="#DDEEFF" HorizontalAlignment="Right"/></Grid><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Romance" Foreground="#D6E9FF"/><ProgressBar Grid.Column="1" Value="63" Maximum="100" Style="{StaticResource HomeProgress}" Margin="4,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="22%" Foreground="#DDEEFF" HorizontalAlignment="Right"/></Grid><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Drama" Foreground="#D6E9FF"/><ProgressBar Grid.Column="1" Value="54" Maximum="100" Style="{StaticResource HomeProgress}" Margin="4,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="19%" Foreground="#DDEEFF" HorizontalAlignment="Right"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Ação" Foreground="#D6E9FF"/><ProgressBar Grid.Column="1" Value="42" Maximum="100" Style="{StaticResource HomeProgress}" Margin="4,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="13%" Foreground="#DDEEFF" HorizontalAlignment="Right"/></Grid></StackPanel>
                            </Border>

                            <Border Background="#EB081D3C" BorderBrush="#28679D" BorderThickness="1" CornerRadius="17" Padding="15" Margin="0,0,0,12">
                                <StackPanel><DockPanel Margin="0,0,0,9"><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><local:IconTile IconData="{StaticResource AniT.Icon.Sparkles}" Foreground="#9CE6FF" Width="29" Height="29"/><TextBlock Text="Lançamentos" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel><ItemsControl ItemsSource="{Binding ReleaseCards}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" HorizontalAlignment="Stretch"><Grid Width="252" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Border Width="50" Height="40" CornerRadius="8" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="8"><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="#F4F8FF" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SecondaryText}" Foreground="#90B4D9" FontSize="9" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="2" Background="#195CD9" CornerRadius="9" Padding="7,4" VerticalAlignment="Center"><TextBlock Text="NOVO" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="ReleasesEmpty" Text="Novidades da sua estante aparecerão aqui." Foreground="#8DAED0" FontSize="10" Margin="0,4,0,0" Visibility="Collapsed"/></StackPanel>
                            </Border>

                            <Border Background="#EB081D3C" BorderBrush="#28679D" BorderThickness="1" CornerRadius="17" Padding="16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><local:IconTile IconData="{StaticResource AniT.Icon.Crown}" Foreground="#FFD15A" TileBackground="#554A310D" TileBorderBrush="#9C826124" Width="34" Height="34"/><StackPanel Grid.Column="1"><TextBlock Text="Curadoria AniT" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Seleções especiais feitas com muito carinho." Foreground="#A9C4E2" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Path Grid.Column="2" Data="{StaticResource AniT.Icon.ArrowRight}" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" Stroke="#A9E8FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="RouletteOverlay" Grid.ColumnSpan="2" Background="#D6000716" Visibility="Collapsed" Panel.ZIndex="200">
            <Grid Width="820" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                <Border x:Name="RouletteCyanGlow" Width="744" Height="448" CornerRadius="29" BorderBrush="#8459E4FF" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Border.Effect><DropShadowEffect Color="#27C9FF" BlurRadius="52" ShadowDepth="0" Opacity="0.92"/></Border.Effect>
                    <Border.RenderTransform><ScaleTransform x:Name="RouletteCyanGlowScale"/></Border.RenderTransform>
                </Border>
                <Border x:Name="RouletteVioletGlow" Width="754" Height="458" CornerRadius="31" BorderBrush="#6B8E62FF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Border.Effect><DropShadowEffect Color="#8E62FF" BlurRadius="42" ShadowDepth="0" Opacity="0.72"/></Border.Effect>
                    <Border.RenderTransform><ScaleTransform x:Name="RouletteVioletGlowScale"/></Border.RenderTransform>
                </Border>

                <Canvas Width="820" Height="560" IsHitTestVisible="False" Panel.ZIndex="4" ClipToBounds="False">
                    <TextBlock x:Name="RouletteParticleOne" Text="✦" Foreground="#9AF1FF" FontSize="24" Canvas.Left="24" Canvas.Top="370" Opacity="0"><TextBlock.Effect><DropShadowEffect Color="#3DDCFF" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect><TextBlock.RenderTransform><TranslateTransform x:Name="RouletteParticleOneMove"/></TextBlock.RenderTransform></TextBlock>
                    <Ellipse x:Name="RouletteParticleTwo" Width="9" Height="9" Fill="#64DCFF" Canvas.Left="63" Canvas.Top="455" Opacity="0"><Ellipse.Effect><DropShadowEffect Color="#32CDFF" BlurRadius="15" ShadowDepth="0" Opacity="1"/></Ellipse.Effect><Ellipse.RenderTransform><TranslateTransform x:Name="RouletteParticleTwoMove"/></Ellipse.RenderTransform></Ellipse>
                    <TextBlock x:Name="RouletteParticleThree" Text="✧" Foreground="#D9C5FF" FontSize="30" Canvas.Left="92" Canvas.Top="278" Opacity="0"><TextBlock.Effect><DropShadowEffect Color="#9D70FF" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect><TextBlock.RenderTransform><TranslateTransform x:Name="RouletteParticleThreeMove"/></TextBlock.RenderTransform></TextBlock>
                    <TextBlock x:Name="RouletteParticleFour" Text="✦" Foreground="#81E9FF" FontSize="21" Canvas.Left="772" Canvas.Top="408" Opacity="0"><TextBlock.Effect><DropShadowEffect Color="#37D3FF" BlurRadius="14" ShadowDepth="0" Opacity="0.92"/></TextBlock.Effect><TextBlock.RenderTransform><TranslateTransform x:Name="RouletteParticleFourMove"/></TextBlock.RenderTransform></TextBlock>
                    <Ellipse x:Name="RouletteParticleFive" Width="7" Height="7" Fill="#C4A4FF" Canvas.Left="738" Canvas.Top="315" Opacity="0"><Ellipse.Effect><DropShadowEffect Color="#9B6DFF" BlurRadius="15" ShadowDepth="0" Opacity="1"/></Ellipse.Effect><Ellipse.RenderTransform><TranslateTransform x:Name="RouletteParticleFiveMove"/></Ellipse.RenderTransform></Ellipse>
                    <TextBlock x:Name="RouletteParticleSix" Text="✧" Foreground="White" FontSize="20" Canvas.Left="786" Canvas.Top="475" Opacity="0"><TextBlock.Effect><DropShadowEffect Color="#73E8FF" BlurRadius="13" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect><TextBlock.RenderTransform><TranslateTransform x:Name="RouletteParticleSixMove"/></TextBlock.RenderTransform></TextBlock>
                </Canvas>

            <Border x:Name="RouletteDialog" Width="720" MaxWidth="820" Background="#F20A2144" BorderBrush="#75E4FF" BorderThickness="1.8"
                    CornerRadius="24" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.Effect><DropShadowEffect Color="#168BFF" BlurRadius="46" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                <Border.RenderTransform><ScaleTransform x:Name="RouletteDialogScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Width="38" Height="38" Background="#17385E" BorderBrush="#3977A8" BorderThickness="1"
                                Foreground="#DDF4FF" FontSize="22" FontWeight="SemiBold" Content="×" Cursor="Hand" Click="RouletteClose_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="19"/></Style></Button.Resources>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <local:IconTile IconData="{StaticResource AniT.Icon.Sparkles}" Foreground="#7DE5FF" Width="42" Height="42"/>
                            <StackPanel Margin="12,-2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Roleta AniT" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="RouletteStatusText" Text="Girando entre as histórias da sua estante..." Foreground="#93BDE4" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="RouletteResult" Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="RouletteCoverCard" Style="{StaticResource RouletteCoverCard}" Width="184" Height="244" HorizontalAlignment="Left"
                                ClipToBounds="True" Tag="18" SizeChanged="RoundedPanel_SizeChanged">
                            <Grid>
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Rectangle IsHitTestVisible="False">
                                    <Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Opacity" Value="0.08"/><Setter Property="Fill"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D8FFFFFF" Offset="0"/><GradientStop Color="#528CEAFF" Offset="0.28"/><GradientStop Color="#00166BB3" Offset="0.58"/></LinearGradientBrush></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=RouletteCoverCard}" Value="True"><Setter Property="Opacity" Value="0.52"/></DataTrigger></Style.Triggers></Style></Rectangle.Style>
                                </Rectangle>
                                <Rectangle VerticalAlignment="Bottom" Height="82"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00081932" Offset="0"/><GradientStop Color="#F405142B" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,5" Background="#E5144977" CornerRadius="11">
                                    <TextBlock x:Name="RouletteMoodBadge" Text="Clima surpresa" Foreground="#DDF8FF" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="A roleta escolheu" Foreground="#65D9FF" FontSize="12" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding SecondaryText}" Foreground="#A8C9E9" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding ScoreLabel}" Foreground="#FFD762" FontSize="16" FontWeight="Bold" Margin="0,15,0,0"/>
                            <TextBlock x:Name="RouletteExplanation" Foreground="#B9D8F4" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="RouletteEmpty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,28">
                        <local:IconTile IconData="{StaticResource AniT.Icon.Library}" Foreground="#78DFFF" Width="54" Height="54" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sua estante ainda está vazia" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Adicione animes ao acervo para a roleta preparar uma sugestão." Foreground="#9ABBDD" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="390" Margin="0,7,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="RouletteAgainButton" Style="{StaticResource RouletteGlassButton}" Content="↻   Girar novamente" MinWidth="164" Click="RouletteAgain_Click"/>
                        <Button x:Name="RouletteDetailsButton" Style="{StaticResource RouletteGlassButton}" Content="Ver detalhes" MinWidth="132" Margin="10,0,0,0" Click="RouletteDetails_Click"/>
                        <Button x:Name="RouletteWatchButton" Style="{StaticResource RouletteGlassButton}" Background="#E7269FEE" BorderBrush="#96EDFF" MinWidth="158" Margin="10,0,0,0" Click="RouletteWatch_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AniT.Icon.Play}" Width="15" Height="15" Stretch="Uniform" Fill="White" Stroke="White" StrokeThickness="1.2"/><TextBlock Text="Assistir agora" Margin="9,0,0,0"/></StackPanel></Button>
                    </WrapPanel>
                </Grid>
            </Border>
                <Grid.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard Storyboard="{StaticResource RouletteMagicAnimation}"/></EventTrigger></Grid.Triggers>
            </Grid>
        </Grid>
    </Grid>
</Window>
