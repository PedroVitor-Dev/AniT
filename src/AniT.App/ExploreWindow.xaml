<Window x:Class="AniT.App.ExploreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorar · AniT" Width="1440" Height="900" MinWidth="1060" MinHeight="700"
        Background="#020B1D" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ExploreComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="43"/>
                <Setter Property="Margin" Value="0,0,0,9"/>
                <Setter Property="Foreground" Value="#E8F4FF"/>
                <Setter Property="Background" Value="#081E3E"/>
                <Setter Property="BorderBrush" Value="#24639B"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#DDEEFF"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="13,9"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#174D82"/><Setter Property="Foreground" Value="White"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1D68A9"/><Setter Property="Foreground" Value="White"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                    <Grid Margin="14,0,12,0">
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/>
                                        <TextBlock Text="⌄" Foreground="#A9DFFF" FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Padding="5"
                                            Background="#F20A1F40" BorderBrush="#337EB9" BorderThickness="1" CornerRadius="12">
                                        <ScrollViewer MaxHeight="250"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#5AD5FF"/><Setter TargetName="ComboSurface" Property="Background" Value="#103158"/></Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#79E3FF"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MoodButton" TargetType="Button" BasedOn="{StaticResource HomeOutlineButton}">
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinWidth" Value="118"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.69,0.03" Center="0.69,0.03" RadiusX="0.96" RadiusY="1.08">
                <GradientStop Color="#0A356D" Offset="0"/><GradientStop Color="#041A38" Offset="0.44"/><GradientStop Color="#020A1A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource HomeSidebarBrush}" BorderBrush="#174576" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
                <Border Width="178" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                    <Border.Background><ImageBrush ImageSource="Assets/logo-fire.png" Viewbox="0,0.28,1,0.46" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,9"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="⌂    Início" Click="Home_Click"/>
                    <Button Style="{StaticResource HomeActiveNavButton}" Content="◉    Explorar"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="▱    Biblioteca" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="▣    Calendário" Click="Calendar_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="◷    Histórico" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="☆    Avaliações" Click="Library_Click"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="♙    Perfil"/>
                    <Border Height="1" Background="#214874" Margin="20,18,20,11"/>
                    <TextBlock Text="SISTEMA" Foreground="#587DA9" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,7"/>
                    <Button Style="{StaticResource HomeNavButton}" Content="⚙    Configurar estante" Click="ConfigureShelf_Click"/>
                </StackPanel>
                <Image Grid.Row="2" Source="Assets/ghost_menu.png" Width="218" Height="218" Stretch="Uniform" Opacity="0.33" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-18,0,0,-30" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#D9051937" BorderBrush="#174A7C" BorderThickness="0,0,0,1">
                <Grid MaxWidth="2500" Margin="28,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="SearchContainer" MinWidth="300" MaxWidth="560" Height="46" Margin="0,0,20,0" Background="#A20B254B" BorderBrush="#336C9F" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#A9C7EC" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBlock x:Name="SearchHint" Text="Buscar animes, episódios, gêneros..." Foreground="#7F9FC8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" FontSize="14" VerticalContentAlignment="Center" Padding="0,0,14,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/></Grid></Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource HomeTopButton}" Content="⌂  Início" Click="Home_Click"/>
                        <Button Style="{StaticResource HomeTopButton}" Content="▶  Continuar" Click="ContinueTop_Click"/>
                        <Button x:Name="LibraryTopButton" Style="{StaticResource HomeTopButton}" Content="♡  Biblioteca" Click="Library_Click"/>
                        <Button x:Name="CollectionsTopButton" Style="{StaticResource HomeTopButton}" Content="▱  Coleções" Click="Library_Click"/>
                        <Border Width="1" Height="30" Background="#24527F" Margin="10,0,12,0"/>
                        <Border Width="44" Height="44" CornerRadius="22" Background="#103461" BorderBrush="#4BC8FF" BorderThickness="1" ToolTip="Perfil (em breve)" Cursor="Hand"><Grid><Ellipse Fill="#153F70" Margin="3"/><TextBlock Text="♙" Foreground="#C9F0FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <Grid x:Name="ExploreContentHost" MaxWidth="2500" Margin="24,16,24,42" HorizontalAlignment="Stretch">
                    <Grid x:Name="ExploreLayout">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition x:Name="RightRailColumn" Width="300"/></Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Explorar" Foreground="White" FontSize="42" FontWeight="Bold"/>
                                <TextBlock Text="Descubra novos mundos, gêneros e histórias. ✦" Foreground="#BBD8F6" FontSize="16" Margin="2,-2,0,0"/>
                            </StackPanel>

                            <Border x:Name="DiscoveryBanner" Height="276" Padding="2" CornerRadius="19" Background="#43C8FF" Margin="0,0,0,18"
                                    Tag="19" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged">
                                <Border.Effect><DropShadowEffect Color="#168BFF" BlurRadius="22" ShadowDepth="0" Opacity="0.26"/></Border.Effect>
                                <Border x:Name="DiscoveryBannerInner" Tag="17" CornerRadius="17" Background="#071B38" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged">
                                    <Grid>
                                        <Image Source="Assets/Explore/backg.png" Stretch="UniformToFill" Opacity="0.82"/>
                                        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F2071938" Offset="0"/><GradientStop Color="#D8071938" Offset="0.42"/><GradientStop Color="#3A061A38" Offset="0.78"/><GradientStop Color="#1A061A38" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                        <Image Source="Assets/Explore/banner.png" Width="390" Height="330" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-20,30,-30"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="32,12,0,12" MaxWidth="520">
                                            <TextBlock Text="Novos horizontes te esperam." Foreground="#BDDDF9" FontSize="14"/>
                                            <TextBlock Text="Descobertas da semana" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,5,0,0"/>
                                            <TextBlock Text="Anime é mais mágico quando exploramos juntos." Foreground="#D7E9FB" FontSize="15" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                <Button Style="{StaticResource HomePrimaryButton}" Content="▶   Ver agora" MinWidth="154" Click="BrowseNow_Click"/>
                                                <Button Style="{StaticResource HomeOutlineButton}" Content="▱   Abrir biblioteca" MinWidth="170" Margin="12,0,0,0" Click="Library_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>

                            <Grid Margin="0,0,0,18">
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →"/><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="#71DDFF" FontSize="23" VerticalAlignment="Center"/><TextBlock Text="Explorar por gênero" Style="{StaticResource HomeSectionTitle}" FontSize="20" Margin="10,0,0,0"/></StackPanel></DockPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Genres}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource HomeCardButton}" Tag="{Binding Name}" Click="Genre_Click" Margin="0,0,7,9">
                                                <Border Width="108" Height="143" CornerRadius="13" Background="#43C8FF" Padding="1.5"
                                                        ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="13">
                                                    <Border CornerRadius="11.5" Background="#0B2345" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="11.5">
                                                        <Grid><Grid.RowDefinitions><RowDefinition Height="101"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#09234A"><Image Source="{Binding ImagePath}" Stretch="UniformToFill" Margin="-4"/></Border><Border Grid.Row="1" Background="#F0081B37" Padding="8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontSize="17"/><TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel></Border></Grid>
                                                    </Border>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid x:Name="TrendingSection" Margin="0,0,0,17">
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver biblioteca  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="♨" Foreground="#69D7FF" FontSize="23"/><TextBlock Text="Em alta agora" Style="{StaticResource HomeSectionTitle}" FontSize="20" Margin="10,0,0,0"/></StackPanel></DockPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding TrendingCards}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,9,10"><Border Width="169" Height="180" CornerRadius="14" BorderBrush="#2C6EA5" BorderThickness="1" Background="#091D3B" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="14"><Grid><Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.4"/><GradientStop Color="#D904142D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border Width="36" Height="36" CornerRadius="18" Background="#DE0B2C54" BorderBrush="#B8F0FF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"><TextBlock Text="▶" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><StackPanel Grid.Row="1" Margin="10,7,10,6"><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SecondaryText}" Foreground="#9DC2E8" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ScoreLabel}" Foreground="#FFD45D" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border x:Name="TrendingEmpty" Grid.Row="1" Background="#74102243" BorderBrush="#2C6394" BorderThickness="1" CornerRadius="13" Padding="18" Visibility="Collapsed"><TextBlock Text="Sua biblioteca ainda não tem títulos para recomendar." Foreground="#A8C7E9"/></Border>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →" Click="Library_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="★" Foreground="#79DCFF" FontSize="24"/><TextBlock Text="Recomendado para você" Style="{StaticResource HomeSectionTitle}" FontSize="20" Margin="10,0,0,0"/></StackPanel></DockPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecommendedCards}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardButton}" Tag="{Binding AnimeId}" Click="AnimeCard_Click" Margin="0,0,9,10"><Border Width="169" Height="166" CornerRadius="14" BorderBrush="#2C6EA5" BorderThickness="1" Background="#091D3B" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="14"><Grid><Grid.RowDefinitions><RowDefinition Height="106"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.38"/><GradientStop Color="#D904142D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border Width="34" Height="34" CornerRadius="17" Background="#DE0B2C54" BorderBrush="#B8F0FF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"><TextBlock Text="▶" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><StackPanel Grid.Row="1" Margin="10,7,10,5"><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,4,0,0"><TextBlock Text="{Binding SecondaryText}" Foreground="#9DC2E8" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ScoreLabel}" Foreground="#FFD45D" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel></StackPanel></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="☻" Foreground="#8FE7FF" FontSize="25"/><TextBlock Text="Como você quer se sentir hoje?" Style="{StaticResource HomeSectionTitle}" FontSize="20" Margin="10,0,0,0"/></StackPanel>
                                <WrapPanel Grid.Row="1" Margin="4,4,0,0"><Button Style="{StaticResource MoodButton}" Foreground="#FF78AD" BorderBrush="#FF579E" Content="♥   Fofo"/><Button Style="{StaticResource MoodButton}" Foreground="#FFD965" BorderBrush="#E7B54A" Content="★   Emocionante"/><Button Style="{StaticResource MoodButton}" Foreground="#69E7D5" BorderBrush="#25CDB9" Content="◒   Relaxante"/><Button Style="{StaticResource MoodButton}" Foreground="#8FCBFF" BorderBrush="#4D9DE0" Content="☁   Triste"/><Button Style="{StaticResource MoodButton}" Foreground="#C4A0FF" BorderBrush="#8665DC" Content="♛   Épico"/><Button Style="{StaticResource MoodButton}" Foreground="#FFD17A" BorderBrush="#C99B4A" Content="●   Engraçado"/></WrapPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="RightRail" Grid.Column="2" Margin="0,0,0,20">
                            <Border Background="#EC081D3C" BorderBrush="#28679D" BorderThickness="1" CornerRadius="17" Padding="14" Margin="0,0,0,12">
                                <StackPanel><StackPanel Orientation="Horizontal" Margin="1,0,0,12"><TextBlock Text="▽" Foreground="#9CE6FF" FontSize="25"/><TextBlock Text="Filtros rápidos" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><ComboBox x:Name="GenreFilter" Style="{StaticResource ExploreComboBox}" SelectedIndex="0"><ComboBoxItem Content="Todos os gêneros"/><ComboBoxItem Content="Ação"/><ComboBoxItem Content="Romance"/><ComboBoxItem Content="Fantasia"/><ComboBoxItem Content="Drama"/><ComboBoxItem Content="Comédia"/></ComboBox><ComboBox x:Name="YearFilter" Style="{StaticResource ExploreComboBox}" SelectedIndex="0"><ComboBoxItem Content="Todos os anos"/><ComboBoxItem Content="2026"/><ComboBoxItem Content="2025"/><ComboBoxItem Content="2024"/></ComboBox><ComboBox x:Name="StatusFilter" Style="{StaticResource ExploreComboBox}" SelectedIndex="0"><ComboBoxItem Content="Todos os status"/><ComboBoxItem Content="Em andamento"/><ComboBoxItem Content="Concluído"/></ComboBox><ComboBox x:Name="OrderFilter" Style="{StaticResource ExploreComboBox}" SelectedIndex="0"><ComboBoxItem Content="Ordenar por"/><ComboBoxItem Content="Mais recentes"/><ComboBoxItem Content="Melhor avaliados"/><ComboBoxItem Content="Título"/></ComboBox><Button Style="{StaticResource HomePrimaryButton}" Content="⌕   Aplicar filtros" HorizontalAlignment="Stretch" Click="ApplyFilters_Click"/></StackPanel>
                            </Border>

                            <Border Height="226" Background="#43C8FF" Padding="2" CornerRadius="17" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="17" Margin="0,0,0,12">
                                <Border x:Name="ExploreMascotCardInner" Background="#0A2346" CornerRadius="15" ClipToBounds="True" SizeChanged="RoundedPanel_SizeChanged" Tag="15">
                                    <Grid><Image Source="Assets/Explore/backg.png" Stretch="UniformToFill" Opacity="0.25"/><Rectangle Fill="#90051937"/><Image Source="Assets/Explore/banner.png" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/><Border Background="#C8071935" CornerRadius="11" Padding="12,8" VerticalAlignment="Bottom" Margin="18,0,18,13"><StackPanel><TextBlock Text="Bora explorar?" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Tem um mundo inteiro de animes te esperando!" Foreground="#D4E9FF" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></Grid>
                                </Border>
                            </Border>

                            <Border Background="#EB081D3C" BorderBrush="#28679D" BorderThickness="1" CornerRadius="17" Padding="15" Margin="0,0,0,12">
                                <StackPanel><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Style="{StaticResource HomeSectionLink}" Content="Ver todos  →"/><StackPanel Orientation="Horizontal"><TextBlock Text="★" Foreground="#75DDFF" FontSize="19"/><TextBlock Text="Top gêneros" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"/></StackPanel></DockPanel><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Fantasia" Foreground="#D6E9FF"/><ProgressBar Grid.Column="1" Value="78" Maximum="100" Style="{StaticResource HomeProgress}" Margin="4,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="28%" Foreground="#DDEEFF" HorizontalAlignment="Right"/></Grid><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Romance" Foreground="#D6E9FF"/><ProgressBar Grid.Column="1" Value="63" Maximum="100" Style="{StaticResource HomeProgress}" Margin="4,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="22%" Foreground="#DDEEFF" HorizontalAlignment="Right"/></Grid><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Drama" Foreground="#D6E9FF"/><ProgressBar Grid.Column="1" Value="54" Maximum="100" Style="{StaticResource HomeProgress}" Margin="4,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="19%" Foreground="#DDEEFF" HorizontalAlignment="Right"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Ação" Foreground="#D6E9FF"/><ProgressBar Grid.Column="1" Value="42" Maximum="100" Style="{StaticResource HomeProgress}" Margin="4,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="13%" Foreground="#DDEEFF" HorizontalAlignment="Right"/></Grid></StackPanel>
                            </Border>

                            <Border Background="#EB081D3C" BorderBrush="#28679D" BorderThickness="1" CornerRadius="17" Padding="15" Margin="0,0,0,12">
