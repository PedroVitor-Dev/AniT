<Window x:Class="AniT.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca · AniT" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="#101114" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="AnimeCard" TargetType="Button">
            <Setter Property="Background" Value="#1A1D24"/><Setter Property="BorderBrush" Value="#2C303A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#242833"/><Setter Property="BorderBrush" Value="#F56B48"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="42,33">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Biblioteca" Foreground="White" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Tudo que você encontrou no seu PC." Foreground="#9299AA" FontSize="14" Margin="0,6,0,0"/></StackPanel>
            <Border DockPanel.Dock="Right" Background="#1C1F27" CornerRadius="8" Width="240" Height="38"><TextBlock Text="⌕  Pesquisar em breve" Foreground="#767E91" VerticalAlignment="Center" Margin="13,0" FontSize="12"/></Border>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,34,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Anime}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AnimeCard}" Width="210" Height="292" Margin="0,0,19,20" Click="AnimeCard_Click">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="178"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Background="#292D39" CornerRadius="11,11,0,0">
                                        <Grid><TextBlock Text="{Binding Initial}" Foreground="#F56B48" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/><Border VerticalAlignment="Bottom" Height="48" Background="#60000000"><TextBlock Text="{Binding EpisodeSummary}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="13,0"/></Border></Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="14,13"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="#9AA1B1" FontSize="12" Margin="0,5,0,0"/><ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,12,0,0" Background="#303440" Foreground="#F56B48" BorderThickness="0"/></StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                <TextBlock Text="Sua biblioteca ainda está vazia" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Volte ao início e adicione uma pasta com seus animes para começar." Foreground="#969DAE" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
