<Window xmlns:local="clr-namespace:AniT.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AniT.App.LibraryWindow" Title="Biblioteca · AniT" Width="1180" Height="760" MinWidth="720" MinHeight="520" Background="{DynamicResource AniT.Background}" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Activated="Window_Activated" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged" Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AniT.Presentation;component/Themes/Components.xaml" />
                <ResourceDictionary Source="Styles/HomeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <StreamGeometry x:Key="Library.Icon.Heart">M12,21 C10.2,19.2 4,15 4,9.5 C4,6.5 6.2,4.5 9,4.5 C10.6,4.5 11.6,5.4 12,6.2 C12.4,5.4 13.4,4.5 15,4.5 C17.8,4.5 20,6.5 20,9.5 C20,15 13.8,19.2 12,21 Z</StreamGeometry>
            <Style x:Key="FavoriteAnimeButton" TargetType="Button" BasedOn="{StaticResource AniT.SecondaryButton}">
                <Setter Property="Width" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style x:Key="AnimeCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AniT.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AniT.Border}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="{DynamicResource AniT.Radius}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AniT.Border}" />
                        <Setter Property="Background" Value="{DynamicResource AniT.Surface}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RefreshProgressStyle" TargetType="ProgressBar" BasedOn="{StaticResource AniT.Progress}">
                <Setter Property="Height" Value="8" />
            </Style>
            <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource AniT.SecondaryButton}" />
            <Style x:Key="LibraryTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource AniT.Text}" />
                <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="17,10" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabOutline" Margin="2,2,3,4" Padding="2" Background="{DynamicResource AniT.Surface}" CornerRadius="{DynamicResource AniT.ControlRadius}" SnapsToDevicePixels="True">
                                <Border x:Name="TabSurface" Background="{DynamicResource AniT.Surface}" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AniT.Surface}" />
                                    <Setter TargetName="TabOutline" Property="Background" Value="{DynamicResource AniT.Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AniT.Text}" />
                                    <Setter TargetName="TabOutline" Property="Background" Value="{DynamicResource AniT.Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabOutline" Property="Background" Value="{DynamicResource AniT.Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AniT.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource AniT.Focus}" />
            </Style>
            <Style x:Key="LibraryTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel x:Name="HeaderPanel" Grid.Row="0" Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,8" Panel.ZIndex="2" ClipToBounds="False" KeyboardNavigation.TabIndex="1" />
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ManagementCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AniT.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AniT.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource AniT.Radius}" />
                <Setter Property="Padding" Value="17" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource CancelButton}">
                <Setter Property="Padding" Value="13,7" />
                <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}" />
            </Style>
            <Style x:Key="LibraryFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid Margin="42,33">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="LibraryHeaderGrid" SizeChanged="Header_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel MinWidth="210">
                    <TextBlock Text="Biblioteca" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.TitleSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Tudo que você encontrou no seu PC." Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" Margin="0,6,18,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel x:Name="HeaderActionsPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border x:Name="SearchBanner" MinHeight="48" Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" Width="240" ToolTip="Pesquise por animes, episódios ou gêneros">
                        <Grid>
                            <TextBlock Text="⌕" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" VerticalAlignment="Center" Margin="13,0,0,1" IsHitTestVisible="False" TextWrapping="Wrap" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Buscar animes, episódios, gêneros..." Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" VerticalAlignment="Center" Margin="37,0,34,0" IsHitTestVisible="False" TextWrapping="Wrap" />
                            <TextBox x:Name="LibrarySearchBox" AutomationProperties.Name="Pesquisar animes, episódios e gêneros" AutomationProperties.HelpText="Busca títulos, aliases, episódios e gêneros da biblioteca" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AniT.Muted}" CaretBrush="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Padding="36,0,34,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                            <Button x:Name="ClearSearchButton" AutomationProperties.Name="Limpar pesquisa" Content="×" Width="44" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource AniT.Text}" BorderThickness="0" FontSize="{DynamicResource AniT.SectionSize}" Cursor="Hand" Visibility="Collapsed" ToolTip="Limpar pesquisa" Click="ClearSearch_Click" MinHeight="44" />
                        </Grid>
                    </Border>
                    <Button x:Name="RefreshLibraryButton" Style="{StaticResource AniT.ActionButton}" Content="↻  Atualizar Títulos" Margin="12,0,0,0" Click="RefreshLibrary_Click" MinHeight="44" />
                    <Button x:Name="AddFolderButton" Style="{StaticResource QuietButton}" Content="✎  Editar estante" Margin="10,0,0,0" Click="AddFolder_Click" MinHeight="44" />
                </WrapPanel>
            </Grid>
            <TabControl x:Name="LibraryTabs" Grid.Row="1" Margin="0,25,0,0" SelectedIndex="0" Style="{StaticResource LibraryTabControl}" ItemContainerStyle="{StaticResource LibraryTab}">
                <TabItem Header="Títulos">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="FilterScroller" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                            <Border Width="36" Height="36" CornerRadius="{DynamicResource AniT.ControlRadius}" Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1">
                                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="M3,5 L21,5 14,13 14,20 10,22 10,13 Z" Width="24" Height="24" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Margin="10,-1,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Localizar na Biblioteca" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                                            <Border Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="10,5" Margin="0,0,10,0">
                                                <TextBlock x:Name="FilterResultText" Text="0 títulos" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </Border>
                                            <Button x:Name="ClearFiltersButton" Style="{StaticResource QuietButton}" Content="Limpar filtros" Visibility="Collapsed" Click="ClearFilters_Click" MinHeight="44" />
                                            <Button x:Name="FiltersToggleButton" Style="{StaticResource QuietButton}" Margin="10,0,0,0" ToolTip="Mostrar filtros" AutomationProperties.Name="Mostrar filtros" Click="FiltersToggle_Click" MinHeight="44">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="FiltersToggleText" Text="Mostrar filtros" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <Path x:Name="FiltersToggleIcon" Data="{StaticResource AniT.Icon.ChevronDown}" Width="12" Height="12" Margin="8,0,0,0" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AniT.Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel x:Name="FilterFieldsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                        <StackPanel Width="178" Margin="0,0,10,8">
                                            <TextBlock Text="Gênero" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="2,0,0,5" TextWrapping="Wrap" />
                                            <ComboBox x:Name="GenreFilter" Style="{StaticResource LibraryFilterCombo}" ItemsSource="{Binding GenreFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Width="142" Margin="0,0,10,8">
                                            <TextBlock Text="Ano de lançamento" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="2,0,0,5" TextWrapping="Wrap" />
                                            <ComboBox x:Name="YearFilter" Style="{StaticResource LibraryFilterCombo}" ItemsSource="{Binding YearFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Width="166" Margin="0,0,10,8">
                                            <TextBlock Text="Status na estante" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="2,0,0,5" TextWrapping="Wrap" />
                                            <ComboBox x:Name="StatusFilter" Style="{StaticResource LibraryFilterCombo}" ItemsSource="{Binding StatusFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Width="178" Margin="0,0,10,8">
                                            <TextBlock Text="Estúdio" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="2,0,0,5" TextWrapping="Wrap" />
                                            <ComboBox x:Name="StudioFilter" Style="{StaticResource LibraryFilterCombo}" ItemsSource="{Binding StudioFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Width="166" Margin="0,0,10,8">
                                            <TextBlock Text="Tag personalizada" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="2,0,0,5" TextWrapping="Wrap" />
                                            <ComboBox x:Name="TagFilter" Style="{StaticResource LibraryFilterCombo}" ItemsSource="{Binding TagFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Width="178" Margin="0,0,10,8">
                                            <TextBlock Text="Coleção" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="2,0,0,5" TextWrapping="Wrap" />
                                            <ComboBox x:Name="CollectionFilter" Style="{StaticResource LibraryFilterCombo}" ItemsSource="{Binding CollectionFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,0,8">
                                            <TextBlock Text="Ordenar resultados" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="2,0,0,5" TextWrapping="Wrap" />
                                            <ComboBox x:Name="OrderFilter" Style="{StaticResource LibraryFilterCombo}" ItemsSource="{Binding OrderFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="LibraryPosterList" ItemsSource="{Binding PosterRows}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" SizeChanged="PosterList_SizeChanged" KeyboardNavigation.TabNavigation="Continue">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding Columns}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource AnimeCard}" Width="{DynamicResource AniT.LibraryCardWidth}" HorizontalAlignment="Left" Margin="0,0,16,20" Padding="0">
                                                        <StackPanel>
                                                            <Border Height="{DynamicResource AniT.LibraryPosterHeight}" Background="{DynamicResource AniT.Raised}" CornerRadius="{DynamicResource AniT.ControlRadius}" Tag="Artwork" SizeChanged="PosterArtwork_SizeChanged" Style="{DynamicResource AniT.PosterFrame}">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.TitleSize}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" Loaded="Cover_Loaded" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Margin="12,12,12,14">
                                                                <TextBlock Text="{Binding Title}" Style="{DynamicResource AniT.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding EnglishTitleDisplay}" Style="{DynamicResource AniT.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding EpisodeSummary}" Style="{DynamicResource AniT.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Status}" Style="{DynamicResource AniT.Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Style="{DynamicResource AniT.Progress}" Margin="0,12,0,12" />
                                                                <TextBlock Text="NOVO NA ESTANTE" Visibility="{Binding NewBadgeVisibility}" Style="{DynamicResource AniT.Caption}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                                <WrapPanel>
                                                                    <Button Style="{DynamicResource AniT.SecondaryButton}" Content="Abrir anime" Click="AnimeCard_Click" Margin="0,0,8,8" AutomationProperties.Name="{Binding Title}" />
                                                                    <Button Style="{StaticResource FavoriteAnimeButton}" ToolTip="{Binding FavoriteToolTip}" Click="FavoriteAnime_Click" Margin="0,0,0,8" AutomationProperties.Name="{Binding FavoriteToolTip}">
                                                                        <Path Data="{StaticResource Library.Icon.Heart}" Width="18" Height="18" Stretch="Uniform" Fill="{Binding FavoriteFill}" Stroke="{DynamicResource AniT.Text}" StrokeThickness="1.8" />
                                                                    </Button>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center" MaxWidth="430" Margin="16">
                                <Image Source="Assets/normal-sf.png" Width="105" Opacity="0.82" />
                                <TextBlock x:Name="EmptyTitleText" Text="Configure a pasta da sua estante" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyDetailText" Text="Escolha um único diretório principal. O AniT encontra os vídeos sem exigir que você renomeie ou reorganize nada." Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Button x:Name="EmptyActionButton" Style="{StaticResource AniT.ActionButton}" Content="Configurar estante" Width="170" Margin="0,18,0,0" Click="AddFolder_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Pastas">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,15" LastChildFill="False">
                            <TextBlock Text="Pastas monitoradas" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource AniT.ActionButton}" Content="✎ Editar pasta" Width="150" Margin="18,0,0,0" Click="AddFolder_Click" MinHeight="44" />
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LibraryRoots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ManagementCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                                    <Border Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="9,4" Margin="0,0,10,0">
                                                        <TextBlock Text="DIRETÓRIO FIXADO" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" FontWeight="Bold" TextWrapping="Wrap" />
                                                    </Border>
                                                    <Button Style="{StaticResource QuietButton}" Content="Editar" Click="AddFolder_Click" MinHeight="44" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Revisão" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource AniT.Surface}" CornerRadius="{DynamicResource AniT.ControlRadius}" Padding="6,1" Margin="7,-1,0,-1">
                                <TextBlock Text="{Binding ReviewCount}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Precisam de revisão" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Confirme apenas o que fizer sentido. Ao salvar, o AniT pode aprender esse nome para os próximos scans." Foreground="{DynamicResource AniT.Text}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReviewItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ManagementCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.BodySize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SuggestedText}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Reasons}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Confiança" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" TextWrapping="Wrap" />
                                                    <ProgressBar Value="{Binding ConfidencePercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,5,18,0" Foreground="{DynamicResource AniT.Text}" Background="{DynamicResource AniT.Surface}" BorderThickness="0" />
                                                    <TextBlock Text="{Binding ConfidenceLabel}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,4,18,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource AniT.ActionButton}" Content="Revisar →" Tag="{Binding Id}" Click="ReviewItem_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Duplicatas">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Duplicatas físicas" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="1" Margin="0,15,0,0">
                            <ItemsControl ItemsSource="{Binding DuplicateItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ManagementCard}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AniT.Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="Mesmo conteúdo; nenhum arquivo será excluído automaticamente." Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Indisponíveis">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Arquivos indisponíveis" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="1" Margin="0,15,0,0">
                            <ItemsControl ItemsSource="{Binding UnavailableItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ManagementCard}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AniT.Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Organizar">
                    <Border Style="{StaticResource ManagementCard}" Margin="0,20,0,0" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Organizador opcional" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="O AniT não move nem renomeia nada sozinho. Gere uma prévia completa e escolha quais operações executar. Legendas sidecar acompanham o vídeo e destinos existentes nunca são sobrescritos." Foreground="{DynamicResource AniT.Text}" TextWrapping="Wrap" Margin="0,9,0,0" />
                            <Button Style="{StaticResource AniT.ActionButton}" Content="Gerar prévia de organização" Width="220" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OpenOrganizer_Click" />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
        <Grid x:Name="RefreshOverlay" Panel.ZIndex="50" Background="{DynamicResource AniT.Surface}" Visibility="Collapsed">
            <Ellipse Width="680" Height="390" Fill="{DynamicResource AniT.Text}" HorizontalAlignment="Center" VerticalAlignment="Center">
                </Ellipse>
            <Border Width="540" MinHeight="292" Padding="34" Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" CornerRadius="{DynamicResource AniT.ControlRadius}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Image Source="Assets/normal-sf.png" Width="168" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-45,-34,0" Opacity="0.13" IsHitTestVisible="False" />
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="{DynamicResource AniT.ControlRadius}" Background="{DynamicResource AniT.Surface}" BorderBrush="{DynamicResource AniT.Border}" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBlock Text="↻" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.TitleSize}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock x:Name="RefreshTitleText" Text="Atualizando sua estante" Foreground="{DynamicResource AniT.Text}" FontSize="{DynamicResource AniT.SectionSize}" FontWeight="SemiBold" Margin="0,20,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="RefreshDetailText" Text="Preparando…" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.BodySize}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        <Grid Margin="0,24,0,0">
                            <ProgressBar x:Name="RefreshProgress" Style="{StaticResource RefreshProgressStyle}" Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="RefreshPercentText" Text="0%" Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </Grid>
                        <DockPanel Margin="0,27,0,0">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Títulos e capas ficam salvos localmente." Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" TextWrapping="Wrap" />
                                <TextBlock Text="Você pode continuar usando o AniT depois da sincronização." Foreground="{DynamicResource AniT.Muted}" FontSize="{DynamicResource AniT.CaptionSize}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="CancelRefreshButton" DockPanel.Dock="Right" Style="{StaticResource CancelButton}" Content="Cancelar" Click="CancelRefresh_Click" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>