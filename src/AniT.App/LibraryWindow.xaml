<Window x:Class="AniT.App.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Biblioteca · AniT" Width="1180" Height="760" MinWidth="900" MinHeight="600" Background="#070B16" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Activated="Window_Activated">
    <Window.Resources>
        <Style x:Key="AnimeCard" TargetType="Button"><Setter Property="Background" Value="#10192A"/><Setter Property="BorderBrush" Value="#2B405F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#15233B"/><Setter Property="BorderBrush" Value="#2FA7FF"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid Margin="42,33"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Biblioteca" Foreground="White" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Tudo que você encontrou no seu PC." Foreground="#9DB2D0" FontSize="14" Margin="0,6,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#101A2C" BorderBrush="#29415F" BorderThickness="1" CornerRadius="11" Width="240" Height="38"><TextBlock Text="⌕  Pesquisar em breve" Foreground="#7694B9" VerticalAlignment="Center" Margin="13,0" FontSize="12"/></Border></DockPanel>
        <Grid Grid.Row="1" Margin="0,34,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Anime}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource AnimeCard}" Width="220" Height="300" Margin="0,0,19,20" Click="AnimeCard_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border CornerRadius="15,15,0,0"><Grid ClipToBounds="True"><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173C65" Offset="0"/><GradientStop Color="#0D1A31" Offset="0.62"/><GradientStop Color="#102B4D" Offset="1"/></LinearGradientBrush></Border.Background></Border><Image Source="Assets/normal-sf.png" Width="125" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-18,-20" Opacity="0.18"/><TextBlock Text="{Binding Initial}" Foreground="#53B6FF" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/><Rectangle RadiusX="15" RadiusY="15"><Rectangle.Fill><ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle><Border VerticalAlignment="Bottom" Height="48" Background="#B5081122"><TextBlock Text="{Binding EpisodeSummary}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/></Border></Grid></Border><StackPanel Grid.Row="1" Margin="15,12"><TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding EnglishTitleDisplay}" Foreground="#7896BA" FontSize="11" FontStyle="Italic" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="#A5BDDC" FontSize="12" Margin="0,5,0,0"/><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,0" Background="#2A3B57" Foreground="#2FA7FF" BorderThickness="0"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel x:Name="EmptyState" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center"><TextBlock Text="Sua biblioteca ainda está vazia" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Volte ao início e adicione uma pasta com seus animes para começar." Foreground="#9DB2D0" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0"/></StackPanel></Grid>
    </Grid>
</Window>
