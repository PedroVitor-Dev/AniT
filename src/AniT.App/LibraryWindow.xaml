<Window x:Class="AniT.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca · AniT"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        Background="#070B16"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="AnimeCard" TargetType="Button">
            <Setter Property="Background" Value="#10192A"/>
            <Setter Property="BorderBrush" Value="#2B405F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15233B"/>
                    <Setter Property="BorderBrush" Value="#2FA7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RefreshProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="#14233A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#168BFF" Offset="0"/>
                                            <GradientStop Color="#55C7FF" Offset="0.58"/>
                                            <GradientStop Color="#8AE6FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#2FA7FF" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="#15233A"/>
            <Setter Property="Foreground" Value="#B7CBE6"/>
            <Setter Property="BorderBrush" Value="#304765"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="42,33">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Biblioteca" Foreground="White" FontSize="29" FontWeight="SemiBold"/>
                    <TextBlock Text="Tudo que você encontrou no seu PC." Foreground="#9DB2D0" FontSize="14" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#101A2C" BorderBrush="#29415F" BorderThickness="1" CornerRadius="11" Width="220" Height="40">
                        <TextBlock Text="⌕  Pesquisar em breve" Foreground="#7694B9" VerticalAlignment="Center" Margin="13,0" FontSize="12"/>
                    </Border>
                    <Button x:Name="RefreshLibraryButton"
                            Style="{StaticResource BrandButton}"
                            Content="↻  Atualizar Títulos"
                            Height="40"
                            Margin="12,0,0,0"
                            Click="RefreshLibrary_Click"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,34,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Anime}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AnimeCard}" Width="220" Height="300" Margin="0,0,19,20" Click="AnimeCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border CornerRadius="15,15,0,0">
                                            <Grid ClipToBounds="True">
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#173C65" Offset="0"/>
                                                            <GradientStop Color="#0D1A31" Offset="0.62"/>
                                                            <GradientStop Color="#102B4D" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Image Source="Assets/normal-sf.png" Width="125" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-18,-20" Opacity="0.18"/>
                                                <TextBlock Text="{Binding Initial}" Foreground="#53B6FF" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                                                <Rectangle RadiusX="15" RadiusY="15">
                                                    <Rectangle.Fill><ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill"/></Rectangle.Fill>
                                                </Rectangle>
                                                <Border VerticalAlignment="Bottom" Height="48" Background="#B5081122">
                                                    <TextBlock Text="{Binding EpisodeSummary}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="15,12">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding EnglishTitleDisplay}" Foreground="#7896BA" FontSize="11" FontStyle="Italic" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#A5BDDC" FontSize="12" Margin="0,5,0,0"/>
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,0" Background="#2A3B57" Foreground="#2FA7FF" BorderThickness="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                    <TextBlock Text="Sua biblioteca ainda está vazia" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Atualize os títulos ou configure uma pasta com seus animes para começar." Foreground="#9DB2D0" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="RefreshOverlay" Panel.ZIndex="50" Background="#E8070B16" Visibility="Collapsed">
            <Ellipse Width="680" Height="390" Fill="#172FA7FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
            </Ellipse>
            <Border Width="540"
                    MinHeight="292"
                    Padding="34"
                    Background="#F2111C30"
                    BorderBrush="#39658F"
                    BorderThickness="1"
                    CornerRadius="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="16" Opacity="0.52"/></Border.Effect>
                <Grid>
                    <Image Source="Assets/normal-sf.png" Width="168" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-45,-34,0" Opacity="0.13" IsHitTestVisible="False"/>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="17" Background="#183D66" BorderBrush="#3478AD" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBlock Text="↻" Foreground="#66C8FF" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="RefreshTitleText" Text="Atualizando sua estante" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
                        <TextBlock x:Name="RefreshDetailText" Text="Preparando…" Foreground="#9DB6D7" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,24,0,0">
                            <ProgressBar x:Name="RefreshProgress" Style="{StaticResource RefreshProgressStyle}" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="RefreshPercentText" Text="0%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,-25,0,0"/>
                        </Grid>
                        <DockPanel Margin="0,27,0,0">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Títulos e capas ficam salvos localmente." Foreground="#7895BA" FontSize="11"/>
                                <TextBlock Text="Você pode continuar usando o AniT depois da sincronização." Foreground="#5F789A" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="CancelRefreshButton" DockPanel.Dock="Right" Style="{StaticResource CancelButton}" Content="Cancelar" Click="CancelRefresh_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
