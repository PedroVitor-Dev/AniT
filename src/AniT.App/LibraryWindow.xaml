<Window x:Class="AniT.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca · AniT"
        Width="1180"
        Height="760"
        MinWidth="720"
        MinHeight="520"
        Background="#070B16"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        SizeChanged="Window_SizeChanged"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="AnimeCard" TargetType="Border">
            <Setter Property="Background" Value="#10192A"/>
            <Setter Property="BorderBrush" Value="#365A80"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#020711" BlurRadius="18" ShadowDepth="5" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#49BEFF"/>
                    <Setter Property="Background" Value="#13223A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnimePageButton" TargetType="Button" BasedOn="{StaticResource BrandButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="14,0,14,14"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="RefreshProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="#14233A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#168BFF" Offset="0"/>
                                            <GradientStop Color="#55C7FF" Offset="0.58"/>
                                            <GradientStop Color="#8AE6FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#2FA7FF" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="#15233A"/>
            <Setter Property="Foreground" Value="#B7CBE6"/>
            <Setter Property="BorderBrush" Value="#304765"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8EA9CC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabOutline"
                                Margin="1,1,1,3"
                                Padding="1.5"
                                Background="#315172"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Border x:Name="TabSurface"
                                    Background="#0C1525"
                                    CornerRadius="10.5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#173C68"/>
                                <Setter TargetName="TabOutline" Property="Background" Value="#43B8FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabOutline" Property="Background" Value="#4A90C4"/><Setter Property="Foreground" Value="#E8F6FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0,0,0,7"
                                      Panel.ZIndex="2"
                                      KeyboardNavigation.TabIndex="1"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManagementCard" TargetType="Border">
            <Setter Property="Background" Value="#0E1829"/>
            <Setter Property="BorderBrush" Value="#263D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource CancelButton}">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="42,33">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel MinWidth="210">
                    <TextBlock Text="Biblioteca" Foreground="White" FontSize="29" FontWeight="SemiBold"/>
                    <TextBlock Text="Tudo que você encontrou no seu PC."
                               Foreground="#9DB2D0"
                               FontSize="14"
                               Margin="0,6,18,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel x:Name="HeaderActionsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Border x:Name="SearchBanner"
                            Background="#101A2C"
                            BorderBrush="#29415F"
                            BorderThickness="1"
                            CornerRadius="11"
                            Width="220"
                            Height="40">
                        <TextBlock Text="⌕  Pesquisar em breve" Foreground="#7694B9" VerticalAlignment="Center" Margin="13,0" FontSize="12"/>
                    </Border>
                    <Button x:Name="RefreshLibraryButton"
                            Style="{StaticResource BrandButton}"
                            Content="↻  Atualizar Títulos"
                            Height="40"
                            Margin="12,0,0,0"
                            Click="RefreshLibrary_Click"/>
                    <Button x:Name="AddFolderButton"
                            Style="{StaticResource QuietButton}"
                            Content="＋  Adicionar pasta"
                            Height="40"
                            Margin="10,0,0,0"
                            Click="AddFolder_Click"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" Margin="0,25,0,0" Style="{StaticResource LibraryTabControl}" ItemContainerStyle="{StaticResource LibraryTab}">
                <TabItem Header="Títulos">
                    <Grid Margin="0,20,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Anime}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AnimeCard}" Width="220" Height="348" Margin="0,0,19,20" Padding="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border CornerRadius="16,16,0,0" Background="#0D1A31">
                                                    <Grid>
                                                        <Rectangle RadiusX="16" RadiusY="16"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173C65" Offset="0"/><GradientStop Color="#0D1A31" Offset="0.62"/><GradientStop Color="#102B4D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                                        <Rectangle Width="125" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-18,-20" Opacity="0.18" RadiusX="16" RadiusY="16"><Rectangle.Fill><ImageBrush ImageSource="Assets/normal-sf.png" Stretch="Uniform"/></Rectangle.Fill></Rectangle>
                                                        <TextBlock Text="{Binding Initial}" Foreground="#53B6FF" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                                                        <Rectangle RadiusX="16" RadiusY="16"><Rectangle.Fill><ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle>
                                                        <Border VerticalAlignment="Bottom" Height="48" Background="#B5081122"><TextBlock Text="{Binding EpisodeSummary}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/></Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="15,12">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding EnglishTitleDisplay}" Foreground="#7896BA" FontSize="11" FontStyle="Italic" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Status}" Foreground="#A5BDDC" FontSize="12" Margin="0,5,0,0"/>
                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,0" Background="#2A3B57" Foreground="#2FA7FF" BorderThickness="0"/>
                                                </StackPanel>
                                                <Button Grid.Row="2" Style="{StaticResource AnimePageButton}" Content="Página do Anime  →" Click="AnimeCard_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyState" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                            <Image Source="Assets/normal-sf.png" Width="105" Opacity="0.82"/>
                            <TextBlock x:Name="EmptyTitleText" Text="Nenhuma pasta adicionada ainda" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <TextBlock x:Name="EmptyDetailText" Text="Adicione uma pasta. O AniT encontra os vídeos sem exigir que você renomeie ou reorganize nada." Foreground="#9DB2D0" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
                            <Button Style="{StaticResource BrandButton}" Content="＋  Adicionar pasta" Width="170" Margin="0,18,0,0" Click="AddFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Pastas">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,15"><TextBlock Text="Pastas monitoradas" Foreground="White" FontSize="20" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Style="{StaticResource BrandButton}" Content="＋ Adicionar pasta" Click="AddFolder_Click"/></DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding LibraryRoots}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource ManagementCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="#7896BA" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusText}" Foreground="#63C8FF" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                                <CheckBox Grid.Column="1" Content="Subpastas" IsChecked="{Binding IncludeSubfolders}" Foreground="#AFC8E7" VerticalAlignment="Center" Margin="16,0" Tag="{Binding Id}" Click="RootSubfolders_Click"/>
                                <CheckBox Grid.Column="2" Content="Ativa" IsChecked="{Binding IsEnabled}" Foreground="#AFC8E7" VerticalAlignment="Center" Tag="{Binding Id}" Click="RootEnabled_Click"/>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Revisão"/><Border Background="#E33B8FE8" CornerRadius="9" Padding="6,1" Margin="7,-1,0,-1"><TextBlock Text="{Binding ReviewCount}" Foreground="White" FontSize="10"/></Border></StackPanel></TabItem.Header>
                    <Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,15"><TextBlock Text="Precisam de revisão" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Confirme apenas o que fizer sentido. Ao salvar, o AniT pode aprender esse nome para os próximos scans." Foreground="#8EA9CC" Margin="0,5,0,0"/></StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ReviewItems}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource ManagementCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding FileName}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SuggestedText}" Foreground="#8EA9CC" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding Reasons}" Foreground="#5FAFE4" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Confiança" Foreground="#7896BA" FontSize="10"/><ProgressBar Value="{Binding ConfidencePercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,5,18,0" Foreground="#36B8FF" Background="#243650" BorderThickness="0"/><TextBlock Text="{Binding ConfidenceLabel}" Foreground="#CFE9FF" FontSize="11" Margin="0,4,18,0"/></StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource BrandButton}" Content="Revisar →" Tag="{Binding Id}" Click="ReviewItem_Click"/>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Duplicatas">
                    <Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Duplicatas físicas" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <ScrollViewer Grid.Row="1" Margin="0,15,0,0"><ItemsControl ItemsSource="{Binding DuplicateItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ManagementCard}"><StackPanel><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="#8EA9CC" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="Mesmo conteúdo; nenhum arquivo será excluído automaticamente." Foreground="#F0B86B" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Indisponíveis">
                    <Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Arquivos indisponíveis" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <ScrollViewer Grid.Row="1" Margin="0,15,0,0"><ItemsControl ItemsSource="{Binding UnavailableItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ManagementCard}"><StackPanel><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="#8EA9CC" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding Status}" Foreground="#F0B86B" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Organizar">
                    <Border Style="{StaticResource ManagementCard}" Margin="0,20,0,0" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel><TextBlock Text="Organizador opcional" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="O AniT não move nem renomeia nada sozinho. Gere uma prévia completa e escolha quais operações executar. Legendas sidecar acompanham o vídeo e destinos existentes nunca são sobrescritos." Foreground="#9DB2D0" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0"/><Button Style="{StaticResource BrandButton}" Content="Gerar prévia de organização" Width="220" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OpenOrganizer_Click"/></StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid x:Name="RefreshOverlay" Panel.ZIndex="50" Background="#E8070B16" Visibility="Collapsed">
            <Ellipse Width="680" Height="390" Fill="#172FA7FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
            </Ellipse>
            <Border Width="540"
                    MinHeight="292"
                    Padding="34"
                    Background="#F2111C30"
                    BorderBrush="#39658F"
                    BorderThickness="1"
                    CornerRadius="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="16" Opacity="0.52"/></Border.Effect>
                <Grid>
                    <Image Source="Assets/normal-sf.png" Width="168" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-45,-34,0" Opacity="0.13" IsHitTestVisible="False"/>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="17" Background="#183D66" BorderBrush="#3478AD" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBlock Text="↻" Foreground="#66C8FF" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="RefreshTitleText" Text="Atualizando sua estante" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
                        <TextBlock x:Name="RefreshDetailText" Text="Preparando…" Foreground="#9DB6D7" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,24,0,0">
                            <ProgressBar x:Name="RefreshProgress" Style="{StaticResource RefreshProgressStyle}" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="RefreshPercentText" Text="0%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,-25,0,0"/>
                        </Grid>
                        <DockPanel Margin="0,27,0,0">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Títulos e capas ficam salvos localmente." Foreground="#7895BA" FontSize="11"/>
                                <TextBlock Text="Você pode continuar usando o AniT depois da sincronização." Foreground="#5F789A" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="CancelRefreshButton" DockPanel.Dock="Right" Style="{StaticResource CancelButton}" Content="Cancelar" Click="CancelRefresh_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
