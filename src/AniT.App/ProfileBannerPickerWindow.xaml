<Window x:Class="AniT.App.ProfileBannerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher capa do perfil · AniT" Width="1120" Height="760" MinWidth="860" MinHeight="620"
        Background="#030C1D" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/HomeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Evita que o estado pressionado nativo do Windows pinte de azul-claro
                 a área clicável sobre o seletor de fontes. -->
            <Style TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BannerSourceCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Foreground" Value="#E8F4FF"/>
                <Setter Property="Background" Value="#0B2548"/>
                <Setter Property="BorderBrush" Value="#3277AB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="13,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DDEEFF"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="13,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#174D82"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1D68A9"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><Grid Margin="13,0,11,0"><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/><TextBlock Text="⌄" Foreground="#A9DFFF" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Padding="5" Background="#F20A1F40" BorderBrush="#337EB9" BorderThickness="1" CornerRadius="11"><ScrollViewer MaxHeight="230"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#5AD5FF"/><Setter TargetName="ComboSurface" Property="Background" Value="#103158"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#79E3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Galeria de capas" Foreground="White" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Fan arts SFW e artes oficiais prontas para o formato panorâmico do seu perfil." Foreground="#9FC3E4" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource HomeOutlineButton}" Content="Fechar" Click="Close_Click" MinWidth="100" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,16" Padding="12" Background="#D90A1F3D" BorderBrush="#2C6F9F" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <Border Height="44" Background="#0B2548" BorderBrush="#3277AB" BorderThickness="1" CornerRadius="11" Margin="0,0,10,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" Foreground="#8EE4FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#62D6FF" VerticalContentAlignment="Center" Padding="0,0,12,0" FontSize="13" KeyDown="SearchBox_KeyDown"/>
                    </Grid>
                </Border>
                <ComboBox x:Name="SourceComboBox" Grid.Column="1" Style="{StaticResource BannerSourceCombo}" SelectedIndex="0" Margin="0,0,10,0">
                    <ComboBoxItem Content="Todas as fontes" Tag="All"/>
                    <ComboBoxItem Content="Wallhaven · fan arts" Tag="Wallhaven"/>
                    <ComboBoxItem Content="AniList · oficiais" Tag="AniList"/>
                </ComboBox>
                <Button x:Name="SearchButton" Grid.Column="2" Style="{StaticResource HomePrimaryButton}" Content="Buscar artes" Click="Search_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ResultsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource HomeCardButton}" Click="SelectBanner_Click" Margin="8" ToolTip="Usar esta arte como capa do perfil">
                                <Border Width="315" Height="205" Background="#0A2243" BorderBrush="#3BBEF3" BorderThickness="2" CornerRadius="15" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill"/>
                                        <Rectangle VerticalAlignment="Bottom" Height="78">
                                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#F0051732" Offset="0.48"/><GradientStop Color="#FF051329" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                        </Rectangle>
                                        <Grid VerticalAlignment="Bottom" Margin="13,0,13,11">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Source}" Foreground="#7FE3FF" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                                            <Border Grid.Column="1" Background="#D0123155" BorderBrush="#5ACFFF" BorderThickness="1" CornerRadius="9" Padding="8,4" VerticalAlignment="Bottom"><TextBlock Text="{Binding ResolutionLabel}" Foreground="#DDF7FF" FontSize="9"/></Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="MessagePanel" Visibility="Collapsed" Background="#F0061832" BorderBrush="#367EB0" BorderThickness="1" CornerRadius="18" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="Assets/ghost_popcorn.png" Width="175" Height="175" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock x:Name="MessageTitle" Text="A internet tirou uma pausa" Foreground="White" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MessageText" Foreground="#B9D7EF" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0"/>
                        <Button x:Name="RetryButton" Style="{StaticResource HomePrimaryButton}" Content="Tentar novamente" Click="Search_Click" HorizontalAlignment="Left" Margin="0,18,0,0" MinWidth="150"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="LoadingPanel" Background="#E9030D20" CornerRadius="18" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/Loading/loading.png" Width="180" Height="180" Stretch="Uniform"/>
                    <TextBlock x:Name="LoadingText" Text="Buscando artes em alta qualidade..." Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <ProgressBar IsIndeterminate="True" Width="260" Height="7" Style="{StaticResource HomeProgress}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="4,14,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#8FB7D8" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" Text="Wallhaven: SFW, 21:9 e mínimo 2560×1080  •  AniList: artes oficiais" Foreground="#6F94B8" FontSize="10" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>
    </Grid>
</Window>
