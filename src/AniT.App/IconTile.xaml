<UserControl x:Class="AniT.App.IconTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="34"
             Height="34"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <Border Background="{Binding TileBackground, ElementName=Root}"
            BorderBrush="{Binding TileBorderBrush, ElementName=Root}"
            BorderThickness="1"
            CornerRadius="10">
        <Viewbox Margin="7" Stretch="Uniform">
            <Path Data="{Binding IconData, ElementName=Root}"
                  Width="24"
                  Height="24"
                  Stretch="Uniform"
                  Fill="Transparent"
                  Stroke="{Binding Foreground, ElementName=Root}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>
        </Viewbox>
    </Border>
</UserControl>
