<Window x:Class="AniT.App.NavigationLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Opacity="1" Background="#020A1A" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Aura" Storyboard.TargetProperty="Opacity" From="0.28" To="0.72" Duration="0:0:1.15" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="AuraScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1.08" Duration="0:0:1.15" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="AuraScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.08" Duration="0:0:1.15" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="BakiTranslate" Storyboard.TargetProperty="Y" From="4" To="-8" Duration="0:0:0.9" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BakiScale" Storyboard.TargetProperty="ScaleX" From="0.98" To="1.02" Duration="0:0:0.9" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="BakiScale" Storyboard.TargetProperty="ScaleY" From="0.98" To="1.02" Duration="0:0:0.9" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="RingRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="SparkOne" Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:0.65" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="SparkTwo" Storyboard.TargetProperty="Opacity" From="1" To="0.18" BeginTime="0:0:0.2" Duration="0:0:0.8" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="SparkThree" Storyboard.TargetProperty="Opacity" From="0.2" To="0.95" BeginTime="0:0:0.4" Duration="0:0:0.7" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="LoadingWord" Storyboard.TargetProperty="Opacity" From="0.72" To="1" Duration="0:0:0.75" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotOne" Storyboard.TargetProperty="Opacity" From="0.18" To="1" Duration="0:0:0.45" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotTwo" Storyboard.TargetProperty="Opacity" From="0.18" To="1" BeginTime="0:0:0.18" Duration="0:0:0.45" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotThree" Storyboard.TargetProperty="Opacity" From="0.18" To="1" BeginTime="0:0:0.36" Duration="0:0:0.45" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.44" Center="0.5,0.44" RadiusX="0.75" RadiusY="0.88">
                <GradientStop Color="#123E7A" Offset="0"/>
                <GradientStop Color="#082653" Offset="0.35"/>
                <GradientStop Color="#03142F" Offset="0.68"/>
                <GradientStop Color="#020A1A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="0.7">
            <Ellipse Width="5" Height="5" Fill="#8DEAFF" Canvas.Left="120" Canvas.Top="110"/>
            <Ellipse Width="3" Height="3" Fill="White" Canvas.Right="160" Canvas.Top="170"/>
            <Ellipse Width="4" Height="4" Fill="#4CCBFF" Canvas.Left="260" Canvas.Bottom="150"/>
            <Ellipse Width="2" Height="2" Fill="White" Canvas.Right="280" Canvas.Bottom="120"/>
        </Canvas>

        <Grid Width="520" Height="650" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="Aura" Width="490" Height="490" VerticalAlignment="Top" Margin="0,6,0,0" Opacity="0.4">
                <Ellipse.RenderTransform><ScaleTransform x:Name="AuraScale" CenterX="245" CenterY="245"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#9057D8FF" Offset="0"/>
                        <GradientStop Color="#3842BFFF" Offset="0.5"/>
                        <GradientStop Color="#001480FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="390" Height="390" VerticalAlignment="Top" Margin="0,42,0,0" Stroke="#6448D9FF" StrokeThickness="3" StrokeDashArray="1 8">
                <Ellipse.RenderTransform><RotateTransform x:Name="RingRotate" CenterX="195" CenterY="195"/></Ellipse.RenderTransform>
            </Ellipse>

            <TextBlock x:Name="SparkOne" Text="✦" Foreground="#9DF0FF" FontSize="42" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="44,92,0,0"/>
            <TextBlock x:Name="SparkTwo" Text="✦" Foreground="White" FontSize="27" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,152,58,0"/>
            <TextBlock x:Name="SparkThree" Text="✧" Foreground="#55D4FF" FontSize="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,62,102,0"/>

            <Image Source="Assets/Loading/loading.png" Width="350" Height="420" Stretch="Uniform" VerticalAlignment="Top" Margin="0,18,0,0" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect><DropShadowEffect Color="#168BFF" BlurRadius="34" ShadowDepth="0" Opacity="0.72"/></Image.Effect>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BakiScale" CenterX="175" CenterY="210"/>
                        <TranslateTransform x:Name="BakiTranslate"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,34">
                <Image x:Name="LoadingWord" Source="Assets/Loading/loading-text.png" Width="330" Height="104" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Preparando sua próxima história" Foreground="#CBE9FF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-10,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="DotOne" Width="9" Height="9" Fill="#48D5FF" Margin="5,0"/>
                    <Ellipse x:Name="DotTwo" Width="9" Height="9" Fill="#48D5FF" Margin="5,0"/>
                    <Ellipse x:Name="DotThree" Width="9" Height="9" Fill="#48D5FF" Margin="5,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource LoadingAnimation}"/>
        </EventTrigger>
    </Window.Triggers>
</Window>
