<Window x:Class="AniT.App.TheaterVoiceWindow" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Voz · Movie Theater" Width="400" Height="510" MinWidth="340" MinHeight="320" WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AniT.Brush.Background}">
    <Window.Resources><ResourceDictionary Source="Styles/TheaterFloatingTheme.xaml"/></Window.Resources>
    <Grid Background="{DynamicResource AniT.Brush.Background}" Margin="18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <StackPanel><TextBlock Text="VOZ DA SALA" FontSize="11" Foreground="{DynamicResource AniT.Brush.AccentCyan}"/><TextBlock x:Name="StateLabel" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Arraste esta janela pela barra de título." Style="{StaticResource FloatingNote}"/></StackPanel>

        <ItemsControl x:Name="Members"><ItemsControl.ItemTemplate><DataTemplate>
            <Border x:Name="SpeakerCard" Background="{DynamicResource AniT.Brush.Surface}" BorderBrush="{DynamicResource AniT.Brush.Border}" BorderThickness="2" CornerRadius="10" Padding="10" Margin="0,0,0,8"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="SpeakingLight" Width="8" Height="8" Fill="{DynamicResource AniT.Brush.TextSecondary}" VerticalAlignment="Top" Margin="0,5,8,0"/><TextBlock Grid.Column="1" Text="{Binding Person.DisplayName}" FontWeight="SemiBold"/></Grid>
                <TextBlock Text="{Binding Person.VoiceLabel}" Style="{StaticResource FloatingNote}"/>
                <Button x:Name="Moderate" Content="{Binding Person.MicrophoneAction}" Tag="{Binding Person.Id}" Click="Moderate_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
            </StackPanel></Border>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding Person.Speaking}" Value="True"><Setter TargetName="SpeakingLight" Property="Fill" Value="#22C55E"/><Setter TargetName="SpeakerCard" Property="BorderBrush" Value="#22C55E"/></DataTrigger><DataTrigger Binding="{Binding CanModerate}" Value="True"><Setter TargetName="Moderate" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
        <StackPanel x:Name="Footer" Grid.Row="1">
            <UniformGrid Columns="3" Margin="0,8,0,0">
                <Button x:Name="JoinButton" Click="Join_Click" Padding="8" ToolTip="Entrar ou sair do chat de voz"><TextBlock x:Name="JoinLabel" Text="Entrar na voz" FontSize="12" TextAlignment="Center"/></Button>
                <Button x:Name="MuteButton" Click="Mute_Click" Padding="8" ToolTip="Ativar ou silenciar seu microfone"><TextBlock x:Name="MuteLabel" Text="Ativar microfone" FontSize="12" TextAlignment="Center"/></Button>
                <Button x:Name="DeafenButton" Click="Deafen_Click" Padding="8" ToolTip="Desativar ou reativar o áudio da conversa"><TextBlock x:Name="DeafenLabel" Text="Desativar áudio" FontSize="12" TextAlignment="Center"/></Button>
            </UniformGrid><TextBlock x:Name="Error" Style="{StaticResource FloatingNote}"/><TextBlock Text="Fechar sai da voz · use fones." Style="{StaticResource FloatingNote}"/></StackPanel>
    </Grid>
</Window>
