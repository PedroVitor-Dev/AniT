<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:AniT.Presentation">
    <ResourceDictionary.MergedDictionaries><ui:ControlsDictionary /></ResourceDictionary.MergedDictionaries>
    <!-- Window-scoped AniT roles. They never replace the application's legacy dictionaries. -->
    <SolidColorBrush x:Key="AniT.Background" Color="#0C1017"/>
    <SolidColorBrush x:Key="AniT.Surface" Color="#171E29"/>
    <SolidColorBrush x:Key="AniT.Raised" Color="#1E2735"/>
    <SolidColorBrush x:Key="AniT.Text" Color="#EDF2F8"/>
    <SolidColorBrush x:Key="AniT.Muted" Color="#A7B5C7"/>
    <SolidColorBrush x:Key="AniT.Border" Color="#364256"/>
    <SolidColorBrush x:Key="AniT.Accent" Color="#77B5FF"/>
    <SolidColorBrush x:Key="AniT.Error" Color="#FF9AAA"/>
    <CornerRadius x:Key="AniT.Radius">16</CornerRadius>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="AniT.TitleSize">28</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="AniT.SectionSize">19</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="AniT.BodySize">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="AniT.CaptionSize">12</sys:Double>
    <Style x:Key="AniT.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AniT.Text}"/>
        <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="AniT.Caption" TargetType="TextBlock" BasedOn="{StaticResource AniT.Body}">
        <Setter Property="FontSize" Value="{DynamicResource AniT.CaptionSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource AniT.Muted}"/>
    </Style>
    <Style x:Key="AniT.Section" TargetType="TextBlock" BasedOn="{StaticResource AniT.Body}">
        <Setter Property="FontSize" Value="{DynamicResource AniT.SectionSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="AniT.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AniT.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AniT.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AniT.Radius}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>
    <Style x:Key="AniT.Button" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AniT.Focus}"/>
        <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    </Style>
    <Style x:Key="AniT.Input" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AniT.Focus}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AniT.Error}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="AniT.Select" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <!-- Only used for ReduceMotion: WPF UI's stock switch has literal 167ms storyboards. -->
    <ControlTemplate x:Key="AniT.StaticToggle" TargetType="ui:ToggleSwitch">
        <Grid Background="Transparent" MinHeight="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Track" Height="24" CornerRadius="12" Background="{DynamicResource AniT.Raised}" BorderBrush="{DynamicResource AniT.Muted}" BorderThickness="1" VerticalAlignment="Center"/>
            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource AniT.Text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AniT.Accent}"/><Setter TargetName="Thumb" Property="Margin" Value="24,0,0,0"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AniT.OnAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- Structural spacing is shared; layout margins belong to consumers, not buttons. -->
    <Thickness x:Key="AniT.Space.Xs">4</Thickness>
    <Thickness x:Key="AniT.Space.Sm">8</Thickness>
    <Thickness x:Key="AniT.Space.Md">12</Thickness>
    <Thickness x:Key="AniT.Space.Lg">16</Thickness>
    <Thickness x:Key="AniT.Space.Xl">24</Thickness>
    <Thickness x:Key="AniT.Space.Xxl">32</Thickness>
    <Style x:Key="AniT.Focus" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
            <Border BorderBrush="{DynamicResource AniT.Text}" BorderThickness="2" CornerRadius="{DynamicResource AniT.ControlRadius}" Margin="-4" IsHitTestVisible="False"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DefaultControlFocusVisualStyle" TargetType="Control" BasedOn="{StaticResource AniT.Focus}"/>
    <Style x:Key="AniT.Icon" TargetType="ui:SymbolIcon"><Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="{DynamicResource AniT.Text}"/></Style>
    <Style x:Key="AniT.Button.Primary" TargetType="ui:Button" BasedOn="{StaticResource AniT.Button}">
        <Setter Property="Appearance" Value="Primary"/>
    </Style>
    <Style x:Key="AniT.Button.Secondary" TargetType="ui:Button" BasedOn="{StaticResource AniT.Button}">
        <Setter Property="Appearance" Value="Secondary"/>
    </Style>
    <Style x:Key="AniT.Button.Quiet" TargetType="ui:Button" BasedOn="{StaticResource AniT.Button}">
        <Setter Property="Appearance" Value="Transparent"/>
    </Style>
    <Style x:Key="AniT.Toggle" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}"/>
        <Setter Property="Foreground" Value="{DynamicResource AniT.Text}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AniT.Focus}"/>
        <Style.Triggers><DataTrigger Binding="{Binding Path=(local:AppearanceScope.ReduceMotion), RelativeSource={RelativeSource Self}}" Value="True">
            <Setter Property="Template" Value="{StaticResource AniT.StaticToggle}"/>
        </DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="AniT.Card" TargetType="Border" BasedOn="{StaticResource AniT.Panel}">
        <Setter Property="Padding" Value="{StaticResource AniT.Space.Lg}"/>
    </Style>
    <Style x:Key="AniT.EmptyState" TargetType="Border" BasedOn="{StaticResource AniT.Panel}">
        <Setter Property="Background" Value="{DynamicResource AniT.Background}"/>
        <Setter Property="Padding" Value="{StaticResource AniT.Space.Xl}"/>
    </Style>
    <Style x:Key="AniT.Status.Error" TargetType="TextBlock" BasedOn="{StaticResource AniT.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource AniT.Error}"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    </Style>
    <Style x:Key="AniT.Status.Success" TargetType="TextBlock" BasedOn="{StaticResource AniT.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource AniT.Success}"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    </Style>
    <Style x:Key="AniT.NavigationItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource AniT.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource AniT.BodySize}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AniT.Focus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tile" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource AniT.ControlRadius}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                <Grid><Border x:Name="Marker" Width="3" Background="{DynamicResource AniT.Accent}" HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed"/><ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/></Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource AniT.Raised}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource AniT.Raised}"/><Setter Property="Foreground" Value="{DynamicResource AniT.Text}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AniT.Text}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

</ResourceDictionary>
